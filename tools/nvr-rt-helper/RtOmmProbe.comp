// UNOFFICIAL 2026-11-07 (ptaaa-omm, protocol 9) NvrRtHelper's opacity micromap hardware self-test (embedded as RtOmmProbe.h; rebuild after a change:
//   glslangValidator -V --target-env vulkan1.2 --vn kRtOmmProbeSpv -o RtOmmProbe.h RtOmmProbe.comp
// NvrRtOmm.inl SelfTest runs it once at the helper's start on a GPU with VK_EXT_opacity_micromap (it cannot run without it).
//
// A small geometry with a known pseudo-random micromap (OPAQUE or UNKNOWN per micro-triangle) is traced: a ray straight at a random point of
// a random triangle, no opaque flag, no candidate confirmed. A committed hit is the hardware's OPAQUE: the states at the hit's barycentrics,
// looked up with the spec's reference curve (the same code the builder uses), must say OPAQUE; no hit, they must not. Points within 1 % of
// a micro-triangle's edge are left out (either side is right there). Counted: [0] samples, [1] hits where the states say UNKNOWN, [2] no
// hit where they say OPAQUE, [3] hits on another triangle (allowed, judged at the hit). Any [1] or [2]: the micromaps stay off.
#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT probe;
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words { uint w[]; };
layout(push_constant) uniform Push {
	uvec2 positions;   // float3 a vertex
	uvec2 indices;     // uint3 a triangle
	uvec2 states;      // the micromap's data (2 bits a micro-triangle, bytes per triangle = 4^(level - 1))
	uvec2 results;     // 4 counters
	uint triangles;
	uint level;
	uint samples;
	uint seed;
} pc;

uint ommIndex(float u, float v, uint level) {   // the Vulkan spec's reference code (as RtOmm.comp)
	u = clamp(u, 0.0, 1.0);
	v = clamp(v, 0.0, 1.0);
	const float fu = u * float(1u << level);
	const float fv = v * float(1u << level);
	uint iu = uint(fu);
	uint iv = uint(fv);
	const float uf = fu - float(iu);
	const float vf = fv - float(iv);
	if (iu >= (1u << level)) iu = (1u << level) - 1u;
	if (iv >= (1u << level)) iv = (1u << level) - 1u;
	const uint iuv = iu + iv;
	if (iuv >= (1u << level)) iu -= iuv - (1u << level) + 1u;
	uint iw = ~(iu + iv);
	if (uf + vf >= 1.0 && iuv < (1u << level) - 1u) --iw;
	uint b0 = ~(iu ^ iw);
	b0 &= ((1u << level) - 1u);
	const uint t = (iu ^ iv) & b0;
	uint f = t;
	f ^= f >> 1u;
	f ^= f >> 2u;
	f ^= f >> 4u;
	f ^= f >> 8u;
	uint b1 = ((f ^ iu) & ~b0) | t;
	b0 = (b0 | (b0 << 8u)) & 0x00ff00ffu;
	b0 = (b0 | (b0 << 4u)) & 0x0f0f0f0fu;
	b0 = (b0 | (b0 << 2u)) & 0x33333333u;
	b0 = (b0 | (b0 << 1u)) & 0x55555555u;
	b1 = (b1 | (b1 << 8u)) & 0x00ff00ffu;
	b1 = (b1 | (b1 << 4u)) & 0x0f0f0f0fu;
	b1 = (b1 | (b1 << 2u)) & 0x33333333u;
	b1 = (b1 | (b1 << 1u)) & 0x55555555u;
	return b0 | (b1 << 1u);
}

uint pcg(inout uint s) { s = s * 747796405u + 2891336453u; uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u; return (w >> 22u) ^ w; }
float rnd(inout uint s) { return float(pcg(s) >> 8) * (1.0 / 16777216.0); }

uint stateAt(uint tri, vec2 b) {
	const uint bytes = pc.level == 0u ? 1u : 1u << (2u * (pc.level - 1u));
	const uint bit = tri * bytes * 8u + 2u * ommIndex(b.x, b.y, pc.level);
	return (Words(pc.states).w[bit >> 5] >> (bit & 31u)) & 3u;
}

vec3 vertexAt(uint v) {
	Words p = Words(pc.positions);
	return vec3(uintBitsToFloat(p.w[3u * v]), uintBitsToFloat(p.w[3u * v + 1u]), uintBitsToFloat(p.w[3u * v + 2u]));
}

void main() {
	const uint gid = gl_GlobalInvocationID.x;
	if (gid >= pc.samples) return;
	uint s = gid * 2654435761u + pc.seed;
	pcg(s);
	const uint tri = pcg(s) % pc.triangles;
	vec2 b = vec2(rnd(s), rnd(s));
	if (b.x + b.y > 1.0) b = 1.0 - b;
	const float n = float(1u << pc.level);
	const vec2 f = fract(b * n);
	const float edge = min(min(f.x, 1.0 - f.x), min(min(f.y, 1.0 - f.y), abs(f.x + f.y - 1.0)));
	if (edge < 0.01 || (1.0 - b.x - b.y) * n < 0.01) return;
	Words ix = Words(pc.indices);
	const vec3 p0 = vertexAt(ix.w[3u * tri]), p1 = vertexAt(ix.w[3u * tri + 1u]), p2 = vertexAt(ix.w[3u * tri + 2u]);
	const vec3 e1 = p1 - p0, e2 = p2 - p0, c = cross(e1, e2);
	if (dot(c, c) < 1.0e-12) return;
	const vec3 nrm = normalize(c);
	const vec3 at = p0 + e1 * b.x + e2 * b.y;
	const float d = 1.0e-3 * max(length(e1), length(e2)) + 1.0e-4;
	rayQueryEXT q;
	rayQueryInitializeEXT(q, probe, gl_RayFlagsNoneEXT, 0xFFu, at + nrm * d, 0.0, -nrm, 2.0 * d);
	while (rayQueryProceedEXT(q)) {}   // no candidate confirmed: only the micromap's OPAQUE commits
	Words r = Words(pc.results);
	atomicAdd(r.w[0], 1u);
	if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
		const uint hitTri = uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, true));
		if (hitTri != tri) atomicAdd(r.w[3], 1u);
		if (hitTri >= pc.triangles || stateAt(hitTri, rayQueryGetIntersectionBarycentricsEXT(q, true)) != 1u) atomicAdd(r.w[1], 1u);
	}
	else if (stateAt(tri, b) == 1u) atomicAdd(r.w[2], 1u);
}
