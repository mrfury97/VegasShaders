    vec2 quad;
    if (d0 < cb.shadowNearCenter.w) { radC = cb.shadowNearCenter.w; lightTransform = cb.shadowNear; quad = vec2(0.0, 0.0); }
    else if (d1 < cb.shadowMiddleCenter.w) { radC = cb.shadowMiddleCenter.w; lightTransform = cb.shadowMiddle; quad = vec2(0.5, 0.0); }
    else if (d2 < cb.shadowFarCenter.w) { radC = cb.shadowFarCenter.w; lightTransform = cb.shadowFar; quad = vec2(0.0, 0.5); }
    else return 1.0;
