            if (!foliage && !grassF && metal < 0.25 && r > 0.42) {
                const float nmr = (1.0 - metal) * smoothstep(0.42, 0.88, r);
                light += albedo.rgb * effSun * (r * r * 0.20 * (0.35 + 0.65 * (1.0 - clamp(dot(N, V), 0.0, 1.0))) * max(dot(N, effL), 0.0) * nmr);
            }
            if (isExt && L.z > 0.02 && metal < 0.35) {
                const float gW = clamp(0.56 - 0.56 * N.z, 0.0, 1.0) * smoothstep(0.02, 0.28, L.z) * (land ? 0.35 : 1.0) * ((foliage || grassF) ? 0.65 : mix(0.25, 1.0, smoothstep(0.35, 0.85, r)));
                const float bs = dot(effSun, vec3(0.2126, 0.7152, 0.0722)) * 0.36 * gW * (1.0 - metal);
                light += albedo.rgb * vec3(0.36, 0.25, 0.14) * (bs * 0.70);
                sssAmbScalar = bs * 0.30 * (foliage ? 1.0 : sunVis);
            }
            if (abs(model - 3.0) < 0.5) {
                light += mix(vec3(1.0), albedo.rgb, 0.55) * sunLin * (0.12 * pow(1.0 - clamp(dot(N, V), 0.0, 1.0), 3.2) * clamp(dot(Nw, L) * 0.65 + 0.35, 0.0, 1.0));
            }
            const bool isPlant = (foliage && !grassF) || abs(model - 5.0) < 0.5;
            const bool isGrass = grassF || abs(model - 7.0) < 0.5;
            const bool isSolidSss = (model > 10.5 && model < 14.5);
            if ((isPlant || isGrass || abs(model - 3.0) < 0.5) && isExt && L.z > 0.02) {
                const float gnl = dot(Nw, L);
                const float ww = isPlant ? 0.32 : isGrass ? 0.28 : 0.22;
                const float bp = pow(clamp(dot(-V, normalize(L + Nw * (abs(model - 3.0) < 0.5 ? 0.45 : 0.35))), 0.0, 1.0), isPlant ? 3.2 : 3.0);
                const float tt = (0.34 * max(0.0, clamp((gnl + ww) / (1.0 + ww), 0.0, 1.0) - clamp(gnl, 0.0, 1.0)) + bp * clamp(0.65 - 0.35 * gnl, 0.0, 1.0)) * (isPlant ? 0.85 : isGrass ? 0.70 : 0.28);
                const vec3 st = isPlant ? vec3(1.15, 1.32, 0.45) : isGrass ? vec3(1.22, 1.16, 0.52) : vec3(1.05, 0.98, 0.88);
                light += albedo.rgb * st * sunLin * tt;
            } else if (isSolidSss) {
                const float gnl = dot(Nw, L);
                const float ww = abs(model - 12.0) < 0.5 ? 0.18 : 0.32;
                const float bp = pow(clamp(dot(-V, normalize(L + Nw * 0.35)), 0.0, 1.0), 3.0);
                const float tt = (0.34 * max(0.0, clamp((gnl + ww) / (1.0 + ww), 0.0, 1.0) - clamp(gnl, 0.0, 1.0)) + bp * clamp(0.65 - 0.35 * gnl, 0.0, 1.0)) * 0.44;
                const vec3 st = (model < 11.5) ? vec3(1.22, 0.58, 0.20) : (model < 12.5) ? vec3(0.95, 0.90, 0.82) : (model < 13.5) ? vec3(0.58, 0.86, 1.22) : vec3(1.22, 0.36, 0.16);
                light += albedo.rgb * st * sunLin * tt;
            }
        }
    }

    float shadow = 1.0;
    if (cb.dsCtrl.z > 0.5 && dot(light, vec3(1.0)) > 0.0) {
        shadow = GetSunShadow(P, foliage ? Nw : ShadowFacingNormal(Nw, P), skinPx);
        if (HasFlag(kFlagCloudSample)) {
            const float cloudPlant = (abs(model - 5.0) < 0.5 && cb.dsSunColor.w < 0.0) ? 0.0 : cb.cloudSun.w;
            const float cloudStrength = foliage ? max(cb.dsSunColor.w, 0.0) : cloudPlant;
            if (cloudStrength > 0.0) shadow *= DSCloudSunAt(P, cloudStrength);
        }
        // UNOFFICIAL 2026-11-26 Screen-Space Shadows (Bottled Shaders' Lighting.hlsl, DEFERRED: outdoors, N.L >= 0)
        if (HasFlag(kFlagSSShadows) && dot(N, L) >= 0.0) shadow *= texelFetch(t_sssMask, px, 0).r;
    }
    // UNOFFICIAL 2026-11-28 mountain shadows: on the sunlight here, before fog and sky light (SunFar leaves this pixel's land part out)
    if (HasFlag(kFlagTerrainShadow)) {
        if (dot(light, vec3(1.0)) > 0.0) shadow *= DSTerrainShadow(P);
        imageStore(i_terrainMark, px, vec4(1.0));   // this pixel's sunlight is done here: SunFar leaves the land's part out
    }

    if (skinPx) {
        float skinMask, skinThin, skinSoft;
        FDSkinDecode(normals.a, skinMask, skinThin, skinSoft);
        const float wet = clamp(cb.skinLook.y, 0.0, 1.0);
        const float skinSpecScale = skinMask * 2.0 * cb.skinMaterial.x * (1.0 + wet);
        const float skinCurvature = cb.skinDebug.w > 0.5 ? 0.0 : clamp(skinThin * cb.skinMaterial.z, 0.0, 1.0);
        if (cb.skinSSS.w > 0.5) skinThin = 0.0;
        const vec3 skinNsoft = normalize(mix(Nw, N, skinSoft));
        const vec3 skinSun = sunLin * LinScale(cb.pbrData.z);
        vec3 skinSpecular;
        light = SkinSunLight(albedo.rgb, N, Nw, skinNsoft, V, L, skinSun, shadow, r, skinSpecScale, skinThin, skinCurvature, skinSpecular);
        light += skinSpecular;
        light += FDSkinSunTransmission(P, Nw, V, L, albedo.rgb, skinSun);
        if (HasFlag(kFlagSkinSpecActive)) {
            const vec3 specTotal = skinSpecular + SkinSkyReflection(V, Nw, N, r, skinSpecScale);
            if (dot(specTotal, vec3(1.0)) > 0.0) {
                const vec4 prevSpec = imageLoad(i_skinSpec, px);
                imageStore(i_skinSpec, px, vec4(prevSpec.rgb + specTotal, 1.0));
            }
        }
    } else {
        light *= shadow * (foliage ? 1.0 : sunVis);
        light += albedo.rgb * vec3(0.36, 0.25, 0.14) * sssAmbScalar;
    }

    if (land && cb.terrainParallaxIso.z > 0.0 && FDFarLand(m.r) < 0.5) {
        const float reliefLoss = max(0.0, clamp(dot(Nw, Lland), 0.0, 1.0) - sunVis * clamp(dot(N, Lland), 0.0, 1.0));
        light += sunLand * LinScale(cb.terrainData.z) * albedo.rgb * (reliefLoss * shadow * cb.terrainParallaxIso.z);
    }

    if (cb.dsCtrl.x > 0.5) {
        const float v = cb.dsCtrl.x;
        vec3 dbg;
        if (v < 1.5) dbg = light * keep;
        else if (v < 2.5) dbg = vec3(shadow);
        else if (v < 3.5) { const float c = DSCascade(P); dbg = c < 0.5 ? vec3(1, 0, 0) : c < 1.5 ? vec3(0, 1, 0) : c < 2.5 ? vec3(0, 0, 1) : c < 3.5 ? vec3(1, 1, 1) : vec3(0, 0, 0); }
        else if (v < 4.5) dbg = vec3(keep);
        else if (v < 5.5) dbg = N * 0.5 + 0.5;
        else if (v < 6.5) dbg = (land ? vec3(0, 0, 1) : FDSunSpecular(albedo.a, m.r) > 0.5 ? vec3(1, 0, 0) : vec3(0, 1, 0)) * (0.5 + 0.5 * bumped);
        else if (v < 7.5) { const vec3 cell = floor((P + cb.dd[4].xyz) / 64.0); dbg = vec3(fract((cell.x + cell.y + cell.z) * 0.5) * 0.6 + 0.2, clamp(viewZ / 8192.0, 0.0, 1.0), 0.0); }
        else dbg = vec3(sunVis, sunVis, clamp(dsSpecF0 / 0.08, 0.0, 1.0));
        const vec4 dst = imageLoad(i_scene, px);
        imageStore(i_scene, px, vec4(dbg, dst.a));
        return;
    }

    if (dot(light, vec3(1.0)) <= 1.0e-9) return;

    const vec4 dst = imageLoad(i_scene, px);
    vec3 outRgb;
    const float sceneLinear = HasFlag(kFlagSceneIsLinear) ? 1.0 : 0.0;
    if (HasFlag(kFlagLinearLighting) && cb.dsFog.w > 0.5 && keep < 0.9999) {
        outRgb = dst.rgb + FDAddFogged(dst.rgb, light, keep, cb.dsFog.rgb, cb.linearLighting.x, sceneLinear);
    } else if (sceneLinear > 0.5 || !HasFlag(kFlagLinearLighting)) {
        outRgb = dst.rgb + light * keep;
    } else {
        const float gamma = cb.linearLighting.x > 1.0 ? cb.linearLighting.x : 2.2;
        const vec3 stored = max(dst.rgb, vec3(0.0));
        outRgb = pow(pow(stored, vec3(gamma)) + light * keep, vec3(1.0 / gamma));
    }
    imageStore(i_scene, px, vec4(outRgb, dst.a));
}
