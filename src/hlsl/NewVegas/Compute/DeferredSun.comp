    vec3 wy = vec3(0.5 * (0.5 - f.y) * (0.5 - f.y), 0.75 - f.y * f.y, 0.5 * (0.5 + f.y) * (0.5 + f.y));
    float lit = 0.0;
    for (int y = 0; y < 3; y++) {
        for (int x = 0; x < 3; x++) {
            vec2 tapUV = clamp((c + vec2(float(x - 1), float(y - 1)) + 0.5) * dynTexW, uvLo, uvHi);
            lit += (depth <= textureLod(sampler2D(t_shadowDynamic, NVR_SAMPLER(pc.pointSampler)), tapUV, 0.0).x ? 1.0 : 0.0) * wx[x] * wy[y];
        }
