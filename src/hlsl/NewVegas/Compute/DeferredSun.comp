    const float z = max(P.z + cb.terrainParams.y, encoded.z);
    const float lower = heights.y - cb.terrainRange.w;
    const float transition = heights.x + cb.terrainRange.w - lower;
    float lit = transition <= 0.0 ? (z >= heights.x ? 1.0 : 0.0) : saturate((z - lower) / transition);
    lit = saturate((lit - 0.5) * cb.terrainParams.w + 0.5);   // Contrast: a steeper edge
