#version 460
// UNOFFICIAL 2026-10-28 (NVR DXVK fork, hybrid RT item 2; docs/next/FORK-RT-AO.md) [Shaders.AmbientOcclusion.RT]: the trace pass for
// ambient occlusion and sky visibility. Runs in the RT helper (NvrRtHelper.exe, 64-bit: Windows' 32-bit Vulkan drivers have no ray
// queries; docs/next/FORK-RT-CORE.md), not in the game: the helper binds the scene (set 0 binding 0), these constants (1) and the
// pass's shared images (2 in, 3 out). NVR (core/RtAmbient.h, effects/AmbientOcclusion.cpp RtRecord) fills the input and copies the
// output back at the core's point of the frame (RtCore::Frame), before the AO and sky passes. One thread per half-resolution texel.
// Input  (binding 2, RG32F, from RtAOInput.frag): x view distance (world units, 0 = nothing / sky), y the world normal (OctEncode, Pack2).
// Output (binding 3, RGBA16F): x AO visibility (cosine-weighted, 1 open, before any strength), y sky visibility (1 open), z 'covered'
// (straight up blocked), w DebugView 3's value (0: a ray began inside something; else 0.25 + 0.75 x the mean hit distance / Distance).
// NVR's passes turn these into AmbientLight's / AmbientOcclusion's estimate and Skylighting's sky factor (their strength settings).
// Compile: glslangValidator -V --target-env vulkan1.2 -o RtAOTrace.spv RtAOTrace.comp
// (2026-10-30) The same source with -DRT_GI_PASS is RtGITrace.spv: the GI bounce on its own, with ReSTIR GI's temporal reuse
// ([Shaders.AmbientOcclusion.RT] GIReuse > 0; its main is at the end):
// glslangValidator -V --target-env vulkan1.2 -DRT_GI_PASS -o RtGITrace.spv RtAOTrace.comp
// (2026-10-31) and with -DRT_CACHE_PASS RtRadianceCache.spv: the radiance cache's update ([Shaders.AmbientOcclusion.RT] RadianceCache;
// docs/next/FORK-RT-GAPS.md section 4; its main is at the very end):
// glslangValidator -V --target-env vulkan1.2 -DRT_CACHE_PASS -o RtRadianceCache.spv RtAOTrace.comp
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : enable

layout(local_size_x = 8, local_size_y = 8) in;

// The instance mask every ray tests (2026-10-29): everything, the core's alpha-tested casters (0x10: foliage, fences; non-opaque) too:
// each of their candidate hits is tested against the texture's alpha (RtAlpha.glsl), so leaves and chain link occlude where they are
// solid. 0x04 / 0x08 are rt-lamp's lamp glass / lamp models: kept (they occlude). With [Main.Main.RayTracing] AlphaTested off there are
// no such instances and the candidate loop never runs.
#define RT_CULL 0xFFu

layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;   // the core's: world minus CameraPosition, z up
#ifdef RT_GI_PASS
// (2026-10-30) The GI pass's own constants (core/RtAmbient.h GIConstants; the names the shared functions read are the same).
layout(set = 0, binding = 1, std140) uniform Constants {
    mat4 viewToWorld;
    mat4 prevViewToWorld;   // last frame's viewToWorld (its rotation: the reservoirs' reprojection)
    vec4 projection;
    vec4 origin;
    vec4 gi;
    vec4 sunDir;
    vec4 sunColor;
    vec4 ambient;
    vec4 lampPos[8];
    vec4 lampColor[8];
    vec4 gi2;           // x GIOffscreen, y depth tolerance, z GIClamp, w GIInterleave
    vec4 reuse;         // xyz this frame's camera minus last frame's (a scene point last frame = p + xyz), w the M cap (0: no history)
                        // + 64 x GISpatial (the neighbours merged, 0-4)
} cb;
#elif defined(RT_CACHE_PASS)
// (2026-10-31) The radiance cache's update pass (core/RtAmbient.h CacheConstants): the GI fields its hits are lit with, the grid.
layout(set = 0, binding = 1, std140) uniform Constants {
    vec4 origin;        // w the frame number
    vec4 gi;            // x distance, z lamps given (at most 7), w GIAmbient
    vec4 sunDir;
    vec4 sunColor;      // w 1 = the glow atlas is bound (binding 15)
    vec4 ambient;       // w GlowGI
    vec4 lampPos[8];
    vec4 lampColor[8];
    vec4 gi2;           // x GIOffscreen, z GIClamp
    vec4 cacheA;        // the grid (as lampPos[7] in the GI passes): xyz the camera's world position minus its cell's corner, w the cell size
    vec4 cacheB;        // (as lampColor[7]) xyz the camera's cell (world cell coordinates), w CacheStrength (> 0: on)
    vec4 cacheC;        // x rays a cell, y the frames of history at most (negative: every cell starts over: a new image or cell size),
                        // z this frame's turn (0 .. w-1), w the cells updated: 1 in w a frame
    vec4 cacheD;        // (2026-10-31 b) x this cell's visit (frame / w, mod 4096), y lazy cells' period (a settled cell far from every surface
                        // or inside something: traced 1 visit in y), z "far": no hit nearer than z cells
} cb;
#else
layout(set = 0, binding = 1, std140) uniform Constants {
    mat4 viewToWorld;   // NVR's view space -> scene directions (rows right, up, forward of the view; as stored, cb.M * v)
    vec4 projection;    // x 1 / P00, y 1 / P11, zw the trace grid's size in texels
    vec4 origin;        // xyz the view origin in scene space (RtCore::Eye(), 0), w the frame number (0-1023)
    vec4 ao;            // x distance, y rays (0: no AO rays), z 1 = move the noise each frame (a history averages it), w the input check
                        // (DebugView 4: x = view distance / 2000; 5: x = the normal's up component * 0.5 + 0.5; 0 = off)
    vec4 sky;           // x distance, y rays (0, 8 or 16; 0: no sky rays), zw unused
    // 2026-10-29 (rt-ao-gi) one-bounce diffuse GI, all linear rgb (core/RtAmbient.h TraceConstants)
    vec4 gi;            // x distance, y rays (0 or 1), z lamps given (0-8), w GIAmbient (the ambient's share at the hit, 0-1)
    vec4 sunDir;        // xyz toward the sun, w 1 = the sun lights
    vec4 sunColor;      // rgb the sun's light on a surface facing it
    vec4 ambient;       // rgb the ambient (sky) light from above, w GlowGI (2026-10-30: glow-mapped hits' own light, 0 = off)
    vec4 lampPos[8];    // xyz scene space, w reach
    vec4 lampColor[8];  // rgb x dimmer
    vec4 gi2;           // (GI v2) x GIOffscreen (the analytic light's scale for hits off screen), y the on-screen depth tolerance (share), z GIClamp, w Interleave (1, 2, 4)
    vec4 gi3;           // x GIInterleave (1, 2, 4): the GI rays in whole 8 x 8 thread tiles, in turn; y AOAlpha (0 skip, 1 opaque, 2 test);
                        // z 1 = GIReuse in this pass (2026-10-30), w (gi3.z) the camera's move z
    // (2026-10-30, gi3.z) last frame's viewToWorld as stored, rows 0 and 1 (row 2 = their cross x sky.w, the determinant's sign: the
    // game's view need not be a pure rotation, a quaternion could not hold it); the camera's move since; the M cap in sky.z.
    vec4 prevRot;       // xyz row 0, w row 1 x
    vec4 reuse;         // xy row 1 yz, zw the camera's move xy (z in gi3.w); sky.z the M cap + 64 x GISpatial (0: no history), sky.w the sign
} cb;
#endif
#ifdef RT_CACHE_PASS
// (2026-10-31) the radiance cache (core/RtAmbient.h: 32 x 32 x 16 cells, 4 texels each), read and written; the glow atlas at 15
layout(set = 0, binding = 2, rgba16f) uniform image2D cacheImage;
layout(set = 0, binding = 15, rgba8) uniform readonly image2D glowAtlas;
#else
layout(set = 0, binding = 2, rg32f) uniform readonly image2D inputImage;
#endif
#ifdef RT_CACHE_PASS
#elif defined(RT_GI_PASS)
// (2026-10-30) The reservoirs, last frame's (3, 4) and this frame's (8, 9) (NVR swaps the two pairs every frame). A: rgb the estimate
// (the chosen sample's light x W: the bounce light AmbientLight takes, NVR_RTGIRaw), a W (its RIS weight); B: x M (candidates seen,
// capped), y the view distance, zw the world normal (OctEncode) of the texel's surface (the history check).
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D prevA;
layout(set = 0, binding = 4, rgba16f) uniform readonly image2D prevB;
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D curA;
layout(set = 0, binding = 9, rgba16f) uniform writeonly image2D curB;
// (2026-10-30) the bounce light out (the reservoir's estimate + GlowDirect: what AmbientLight takes, NVR_RTGIRaw) and the glow lights
layout(set = 0, binding = 12, rgba16f) uniform writeonly image2D giOut;
layout(set = 0, binding = 13, rgba16f) uniform readonly image2D glowList;
layout(set = 0, binding = 14, rgba8) uniform readonly image2D glowAtlas;   // (2026-10-30) the core's glow atlas (GlowTextures), bound when sunColor.w 1
layout(set = 0, binding = 15, rgba16f) uniform readonly image2D cacheImage;  // (2026-10-31) the radiance cache, bound when lampColor[7].w > 0
#else
// (2026-10-30) GIReuse inside this pass at full rate (gi3.z 1): last frame's reservoirs at 8 / 9, this frame's at 12 / 13 (the helper's
// images 8-11 bind at 12-15; 10 / 11 stay the records and the geometry). Bound only then (the helper's descriptors are partially bound).
layout(set = 0, binding = 8, rgba16f) uniform readonly image2D prevA;
layout(set = 0, binding = 9, rgba16f) uniform readonly image2D prevB;
layout(set = 0, binding = 12, rgba16f) uniform writeonly image2D curA;
layout(set = 0, binding = 13, rgba16f) uniform writeonly image2D curB;
layout(set = 0, binding = 14, rgba16f) uniform writeonly image2D giOut;      // (2026-10-30) as the GI pass's 12
layout(set = 0, binding = 15, rgba8) uniform readonly image2D glowAtlas;     // (2026-10-30) the core's glow atlas, bound when sunColor.w 1
                                                                             // (GlowDirect's list is the GI pass's only: no 13th image here)
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D outputImage;
layout(set = 0, binding = 4, rgba16f) uniform image2D giImage;   // (rt-ao-gi) rgb the bounce light arriving, a hit distance / GI distance
// (2026-10-31) with the reuse in this pass (gi3.z 1) giImage is not written: NVR binds the radiance cache there (read only) when it is on
#define cacheImage giImage
#endif
layout(set = 0, binding = 5, r16f) uniform readonly image2D alphaAtlas;   // the core's alpha atlas (RtCore::AlphaAtlasImage), or a stand-in
#ifndef RT_CACHE_PASS
layout(set = 0, binding = 6, rgba16f) uniform readonly image2D frameLight; // (GI v2) the game's lit frame at the trace grid's size (as rendered: gamma)
#endif
layout(set = 0, binding = 7, rgba8) uniform readonly image2D albedoAtlas;  // (2026-10-29) the core's albedo atlas (HitTextures), or a stand-in
// UNOFFICIAL 2026-11-03 (rtgi-lamps, docs/next/RT-PATH-TRACING.md section 18) all the frame's lamps (up to 80; RtPathTrace.comp's layout:
// 4 RG32F texels a lamp: pos xy, pos z + reach, colour rg, colour b), NVR's pass image 12 in every variant; read when gi.z < 0 (-count)
layout(set = 0, binding = 16, rg32f) uniform readonly image2D lampImage;

// The core's protocol v2 hit data (FORK-RT-CORE.md): per-instance records and the geometry (positions float3 + triangle lists, as words).
struct Record { vec4 albedo; uint flags; uint geometryId; uint vertexOffset; uint indexOffset; };
layout(set = 0, binding = 10, std430) readonly buffer Records { Record records[]; };
layout(set = 0, binding = 11, std430) readonly buffer Geometry { uint words[]; };
#define RT_RECORDS_DECLARED
#define RT_ALPHA_ATLAS alphaAtlas
#include "RtAlpha.glsl"
#define RT_ALBEDO_ATLAS albedoAtlas
#define RT_GLOW_ATLAS glowAtlas
#include "RtHit.glsl"
#include "RtHidden.glsl"   // (2026-11-07 ptaaa-firstperson) rays near the eye pass over the hidden first-person body

// Proceeds a ray query to its end, confirming alpha-tested candidates only where their alpha is solid. Opaque geometry commits by itself.
// (A macro: a rayQueryEXT cannot be a function parameter.)
#define Proceed(q)     for (uint rtCap_ = 0u; rayQueryProceedEXT(q); ) if (++rtCap_ > 256u) { rayQueryTerminateEXT(q); break; } else         if (rayQueryGetIntersectionTypeEXT(q, false) == gl_RayQueryCandidateIntersectionTriangleEXT &&             rtAlphaPass(rayQueryGetIntersectionInstanceIdEXT(q, false), uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, false)),                         rayQueryGetIntersectionBarycentricsEXT(q, false)))             rayQueryConfirmIntersectionEXT(q)
// (2026-11-07 rtgap-decals) the AO, sky and shadow rays: decals (NVR_RT_CUSTOM_DECAL) never occlude (RtAlpha.glsl rtAlphaPassShadow);
// ProceedSolid: AOAlpha 1's cut-outs whole (no texture read) but decals passed (the game sends AOAlpha 3 for it while decals are traced)
#define ProceedShadow(q) for (uint rtCap_ = 0u; rayQueryProceedEXT(q); ) if (++rtCap_ > 256u) { rayQueryTerminateEXT(q); break; } else if (rayQueryGetIntersectionTypeEXT(q, false) == gl_RayQueryCandidateIntersectionTriangleEXT && rtAlphaPassShadow(rayQueryGetIntersectionInstanceCustomIndexEXT(q, false), rayQueryGetIntersectionInstanceIdEXT(q, false), uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, false)), rayQueryGetIntersectionBarycentricsEXT(q, false))) rayQueryConfirmIntersectionEXT(q)
#define ProceedSolid(q) for (uint rtCap_ = 0u; rayQueryProceedEXT(q); ) if (++rtCap_ > 256u) { rayQueryTerminateEXT(q); break; } else if (rayQueryGetIntersectionTypeEXT(q, false) == gl_RayQueryCandidateIntersectionTriangleEXT && !rtIsDecal(rayQueryGetIntersectionInstanceCustomIndexEXT(q, false))) rayQueryConfirmIntersectionEXT(q)

// ---- AmbientLight.glsl's ----
vec2 Unpack2(float p) { float high = floor(p / 4096.0); return vec2(high, p - high * 4096.0) / 4095.0; }
vec3 OctDecode(vec2 e) {
    e = e * 2.0 - 1.0;
    vec3 n = vec3(e, 1.0 - abs(e.x) - abs(e.y));
    float t = clamp(-n.z, 0.0, 1.0);
    n.x += n.x >= 0.0 ? -t : t;
    n.y += n.y >= 0.0 ? -t : t;
    return normalize(n);
}

// Interleaved gradient noise (Jimenez 2014): the per-texel rotation without a noise texture in the helper.
float Ign(vec2 p) { return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715)))); }

// A direction round n, cosine-weighted (Malley: a point on the unit disc lifted to the hemisphere), from u in [0, 1)^2.
vec3 CosineDirection(vec3 n, vec2 u) {
    vec3 t = normalize(abs(n.z) < 0.999 ? cross(n, vec3(0.0, 0.0, 1.0)) : cross(n, vec3(1.0, 0.0, 0.0)));
    vec3 b = cross(n, t);
    float r = sqrt(u.x);
    float phi = 6.2831853 * u.y;
    return normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(max(1.0 - u.x, 0.0)));
}

// The i-th point of the R2 sequence (Roberts 2018): even cover of the square for any count, so 1-16 rays stay stratified.
vec2 R2(float i) { return fract(i * vec2(0.7548777, 0.5698403)); }

// One ray from p (relative to the view origin) along d: x the hit distance (-1: nothing within tMax), y 1 = a back face. The core's
// scene is static geometry (land and objects, both faces; alpha-tested ones tested; no actors). anyHit: the first hit found, else the closest.
// (2026-10-30) alpha: how alpha-tested meshes (mask 0x10) take part: 0 left out, 1 solid (no alpha test: leaf cards occlude whole),
// 2 tested (rtAlphaPass per candidate; rt-gi-8: AO's 4 short rays 9.5 -> 28 ms at Lucky 38 with the test, so AO defaults to 1).
// (2026-11-07 rtgap-decals) 3: as 1 while decals are in the scene (AmbientOcclusion.cpp sends it for 1): the cut-outs come to the loop as
// candidates (no opaque flag: with it a decal would occlude as a solid quad) and are confirmed whole, decals passed. Decals never occlude.
// (2026-11-07 ptaaa-firstperson) Trace for a ray that starts within arm's reach of the eye (the first-person view model's pixels, a counter
// you stand at): the hidden first-person body (FirstPersonBody: the third-person head and arms round the eye) passed over (RtHidden.glsl):
// the world without people and cut-outs (opaque), then people, the player's parts and cut-outs up to that hit, each candidate tested (the
// alpha modes as Trace's: 0 cut-outs left out, 1 / 3 whole, 2 their texture; decals never occlude), hidden ones passed over
vec2 TraceHidden(vec3 p, vec3 d, float tMin, float tMax, bool anyHit, int alpha) {
    const uint terminate = anyHit ? gl_RayFlagsTerminateOnFirstHitEXT : 0u;
    float t = tMax;
    vec2 result = vec2(-1.0, 0.0);
    rayQueryEXT q;
    rayQueryInitializeEXT(q, scene, gl_RayFlagsOpaqueEXT | terminate, RT_CULL & 0x8Fu, p + cb.origin.xyz, tMin, d, tMax);
    for (uint rtCap_ = 0u; rayQueryProceedEXT(q); ) if (++rtCap_ > 256u) { rayQueryTerminateEXT(q); break; } else {}
    if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        t = rayQueryGetIntersectionTEXT(q, true);
        result = vec2(t, rayQueryGetIntersectionFrontFaceEXT(q, true) ? 0.0 : 1.0);
        if (anyHit) return result;
    }
    rayQueryEXT qp;
    rayQueryInitializeEXT(qp, scene, gl_RayFlagsNoOpaqueEXT | terminate, RT_CULL & (alpha == 0 ? 0x60u : 0x70u), p + cb.origin.xyz, tMin, d, t);
    for (uint rtCap_ = 0u; rayQueryProceedEXT(qp); ) if (++rtCap_ > 256u) { rayQueryTerminateEXT(qp); break; } else {
        if (rayQueryGetIntersectionTypeEXT(qp, false) != gl_RayQueryCandidateIntersectionTriangleEXT) continue;
        const uint ci = rayQueryGetIntersectionInstanceCustomIndexEXT(qp, false);
        if ((ci & NVR_RT_CUSTOM_HIDDEN) != 0u || rtIsDecal(ci)) continue;
        if (alpha != 2 || rtAlphaPassShadow(ci, rayQueryGetIntersectionInstanceIdEXT(qp, false), uint(rayQueryGetIntersectionPrimitiveIndexEXT(qp, false)),
                                            rayQueryGetIntersectionBarycentricsEXT(qp, false)))
            rayQueryConfirmIntersectionEXT(qp);
    }
    if (rayQueryGetIntersectionTypeEXT(qp, true) == gl_RayQueryCommittedIntersectionTriangleEXT)
        result = vec2(rayQueryGetIntersectionTEXT(qp, true), rayQueryGetIntersectionFrontFaceEXT(qp, true) ? 0.0 : 1.0);
    return result;
}
vec2 Trace(vec3 p, vec3 d, float tMin, float tMax, bool anyHit, int alpha) {
    if (rtHiddenNear(p, vec3(0.0))) return TraceHidden(p, d, tMin, tMax, anyHit, alpha);   // (2026-11-07 ptaaa-firstperson)
    rayQueryEXT q;
    uint flags = (anyHit ? gl_RayFlagsTerminateOnFirstHitEXT : 0u) | (alpha == 1 ? gl_RayFlagsOpaqueEXT : 0u);
    rayQueryInitializeEXT(q, scene, flags, alpha == 0 ? (RT_CULL & 0xEFu) : RT_CULL, p + cb.origin.xyz, tMin, d, tMax);
    if (alpha == 3) { ProceedSolid(q); }
    else { ProceedShadow(q); }
    if (rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionTriangleEXT) return vec2(-1.0, 0.0);
    return vec2(rayQueryGetIntersectionTEXT(q, true), rayQueryGetIntersectionFrontFaceEXT(q, true) ? 0.0 : 1.0);
}

vec3 Vertex(uint base, uint i) {
    return vec3(uintBitsToFloat(words[base + 3u * i]), uintBitsToFloat(words[base + 3u * i + 1u]), uintBitsToFloat(words[base + 3u * i + 2u]));
}

// One bounce (rt-ao-gi): a cosine-weighted ray from the pixel; at its closest hit the light that surface sends back toward the pixel,
// diffuse: its albedo (the instance record's: the draw's diffuse texture averaged; grey 0.5 when unknown) x what lights it: the sun
// (N.L, a shadow ray toward it), the ambient from above (x GIAmbient x (1 + n.z) / 2: no ray) and the lamps: ONE lamp picked at random
// in proportion to what it would give unshadowed (N.L, quadratic falloff to its reach), its light / its chance, and one shadow ray to
// it (2026-10-29: resampled importance sampling of the lamps, ReSTIR's direct-light step without the reuse; the first version lit every
// hit by all 8 lamps unshadowed, through walls and ceilings: Lucky 38 +8/255 everywhere). xi: the pick's random number.
// With cosine sampling the pixel's irradiance estimate is pi x that radiance = albedo x E (returned).
// Misses return 0: what the sky gives is the game's own ambient already. The hit's normal: its triangle's (the geometry data, to the
// scene by the instance's transform), turned toward the ray; the ray's reverse when the helper had no room for the data.
bool Visible(vec3 from, vec3 dir, float tMax) {
    // (2026-11-07 ptaaa-firstperson) from or toward (a lamp at the eye) a point near the eye: the hidden first-person body passed over
    if (rtHiddenPassOver(from, from + dir * tMax, vec3(0.0))) return !rtBlockedPassHidden(from + cb.origin.xyz, dir, 0.0, tMax, RT_CULL, true, kRtAnyHit);
    rayQueryEXT s;
    rayQueryInitializeEXT(s, scene, gl_RayFlagsTerminateOnFirstHitEXT, RT_CULL, from + cb.origin.xyz, 0.0, dir, tMax);
    ProceedShadow(s);
    return rayQueryGetIntersectionTypeEXT(s, true) != gl_RayQueryCommittedIntersectionTriangleEXT;
}

// (GI v2, 2026-10-29) The light a hit really sends, where the screen saw it: the hit back into the view (the inverse of viewToWorld's
// rotation), and if it lands on screen in front of the camera with the input's view distance there within the tolerance (the same
// surface, not something in front of it), the game's lit frame there, linear. Exactly what ComputeGI's GI pass takes as a tap's light,
// so the units match it (the analytic light, v1, came out ~29x ComputeGI's in Lucky 38). Returns rgb, a 1 = found.
#ifndef RT_CACHE_PASS
vec4 ScreenLight(vec3 hit) {
    vec3 v = transpose(mat3(cb.viewToWorld)) * hit;
    if (v.z < 1.0) return vec4(0.0);
    vec2 uv = vec2(0.5 + 0.5 * v.x / (v.z * cb.projection.x), 0.5 - 0.5 * v.y / (v.z * cb.projection.y));
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThanEqual(uv, vec2(1.0)))) return vec4(0.0);
    ivec2 texel = ivec2(uv * cb.projection.zw);
    float seen = imageLoad(inputImage, texel).x;
    if (!(seen > 0.0) || abs(seen - v.z) > max(abs(cb.gi2.y) * v.z, 8.0)) return vec4(0.0);   // (gi2.y < 0: GIMotion below)
    vec3 c = max(imageLoad(frameLight, texel).rgb, vec3(0.0));
    return vec4(pow(c, vec3(2.2)), 1.0);
}
#endif

// (2026-10-29) One bounce sample's light, its luminance capped at GIClamp (keeps the hue): a ray that lands on a lamp's glow or a
// lit sign gives one pixel a value hundreds of times its neighbours', which the blurs and the history cannot average away (fireflies).
vec3 Clamped(vec3 c) {
    float l = dot(c, vec3(0.2126, 0.7152, 0.0722));
    return l > cb.gi2.z ? c * (cb.gi2.z / l) : c;
}

// The committed hit's normal: its triangle's (the geometry data, to the scene by the instance's transform), turned toward the ray;
// the ray's reverse when the helper had no room for the data.
vec3 HitNormal(uint instance, uint prim, mat4x3 toScene, vec3 d) {
    Record r = records[instance];
    vec3 n = -d;
    if (r.vertexOffset != 0xFFFFFFFFu) {
        uvec3 i = uvec3(words[r.indexOffset + 3u * prim], words[r.indexOffset + 3u * prim + 1u], words[r.indexOffset + 3u * prim + 2u]);
        vec3 v0 = Vertex(r.vertexOffset, i.x), v1 = Vertex(r.vertexOffset, i.y), v2 = Vertex(r.vertexOffset, i.z);
        vec3 face = mat3(toScene) * cross(v1 - v0, v2 - v0);
        if (dot(face, face) > 1.0e-12) n = normalize(face);
    }
    if (dot(n, d) > 0.0) n = -n;
    return n;
}

// (2026-11-07, RT-DETAIL-GAPS.md section 2) the hit's SHADING normal: n bent by the surface's own normal map where its record has one
// (flag 0x80: [Main.Main.RayTracing] RealNormalMaps, the real map from set 1; RtHit.glsl rtHitNormalMapped). Shade is diffuse, so the
// bend counts however the ray meets the bump (it stays on the triangle's side). n itself stays for the lift off the surface.
// (2026-11-07 perf-reflfix) first the smooth vertex normal (RtHit.glsl rtHitSmoothNormal: no facets on round things), then the map.
vec3 ShadingNormal(uint instance, uint prim, vec2 bary, vec3 n, mat4x3 toScene, vec3 d) {
    const vec3 smoothN = rtHitSmoothNormal(instance, prim, bary, n, mat3(toScene), d);
#ifdef RT_HIT_NORMAL_MAPS
    return rtHitNormalMapped(instance, prim, bary, smoothN, mat3(toScene));
#else
    return smoothN;
#endif
}

// ---- (2026-10-31) the radiance cache (docs/next/FORK-RT-GAPS.md section 4; core/RtAmbient.h): 32 x 32 x 16 cells round the camera,
// fixed in the world (cell = floor(world / size)) and stored toroidally (slot = cell mod the grid), 4 texels a cell in a 256 x 256 image
// (slot index i: texel x (i mod 64) x 4 + k, y i / 64): k 0-2 red / green / blue as (c0, c1.xyz): c0 the mean of the light arriving
// (in the bounce's units: what Bounce returns), c1 the mean of light x direction, so the irradiance toward n is c0 + 2 c1 . n (L1); k 3
// the header: xyz the cell's world coordinate / the grid (its stamp: another cell mapping to the slot resets it), w M + 0.9 x the share
// of its rays that hit the back of something (a cell inside a wall or under the land).
// CACHE_A: xyz the camera's world position minus its cell's corner, w the cell size; CACHE_B: xyz the camera's cell, w the strength (0 off).
#ifdef RT_CACHE_PASS
#define CACHE_A cb.cacheA
#define CACHE_B cb.cacheB
#else
#define CACHE_A cb.lampPos[7]
#define CACHE_B cb.lampColor[7]
#endif
// (2026-10-31 b) CACHE_B.w 16 and up: DebugView 7 (every bounce hit lit as off screen: the cache's whole share shows); the strength is the rest
#define CACHE_STRENGTH (CACHE_B.w >= 16.0 ? CACHE_B.w - 16.0 : CACHE_B.w)
// UNOFFICIAL 2026-11-03 (rtspec) a lamp's falloff at x = distance / reach. GIGameLamps (the C++ gives the reach NEGATIVE): the game's own,
// (1 - x^2)^2.2 (Pointlights.hlsl vanillaAtt decoded by LinFalloff), as the deferred lamp pass lights them; else (1 - x)^2, as before.
float LampFall(float x, bool game) { return game ? pow(max(1.0 - x * x, 0.0), 2.2) : (1.0 - x) * (1.0 - x); }
const ivec3 CacheGrid = ivec3(32, 32, 16);

// UNOFFICIAL 2026-11-12 (sungi p3) the cache v2 layout. The image is 512 x 512 now (was 256 x 256, 4 texels a cell): 8 texels a cell, and
// two levels (cascades), level 0 in rows 0-255 and level 1 (the coarse one, 4 x the cell size, the same 32 x 32 x 16 grid) in rows 256-511.
// Slot index i of a level: texel x (i mod 64) x 8 + k, y i / 64 + 256 x level. k 0-3 as before (SH red / green / blue, header);
// k 4-7 (2026-11-12, CacheVisibility; written only while it is on): the cell's distance moments toward 6 axis bins, the mean and the mean
// of the square of the distance the cell's rays travelled (a miss counts as 8; in cell sizes, so the squares fit in half floats), a ray
// weighed into the 3 bins of its direction by the squares of its components: k 4 mean (+x, -x, +y, -y), k 5 mean square (+x, -x, +y, -y),
// k 6 (mean +z, mean -z, mean square +z, mean square -z), k 7 reserved. CacheIrradiance weighs a cell by DDGI's Chebyshev visibility.
// Flags ride in the cell size: CACHE_A.w = size + 1024 x flags (1 CacheVisibility, 2 CacheCascades 2); no flags = exactly the old w.
int CacheFlags() { return int(floor(CACHE_A.w * (1.0 / 1024.0))); }
float CacheSize() { return CACHE_A.w - 1024.0 * float(CacheFlags()); }
// Level 0 is the camera's cell grid. Level 1 (4 x the size): the camera's coarse cell is floor(fine cell / 4) (exact: floor(floor(x / s) / 4)
// = floor(x / 4 s)), the camera's offset in it the fine offset plus the fine cells it sits in; no extra constants needed.
void CacheLevel(int level, out float size, out vec3 cell, out vec3 offset) {
    const float s0 = CacheSize();
    if (level == 0) { size = s0; cell = CACHE_B.xyz; offset = CACHE_A.xyz; return; }
    cell = floor(CACHE_B.xyz * 0.25);
    size = 4.0 * s0;
    offset = (CACHE_B.xyz - 4.0 * cell) * s0 + CACHE_A.xyz;
}

// A cell's slot texel (k = 0) and its stamp, for a cell given relative to the level's camera cell.
ivec2 CacheTexel(ivec3 local, vec3 cameraCell, int level, out vec3 stamp) {
    vec3 world = vec3(local) + cameraCell;
    stamp = floor(world / vec3(CacheGrid));
    ivec3 slot = ivec3(world - stamp * vec3(CacheGrid));
    int index = slot.x + CacheGrid.x * (slot.y + CacheGrid.y * slot.z);
    return ivec2((index & 63) * 8, (index >> 6) + level * 256);
}

// UNOFFICIAL 2026-11-12 (sungi p3, F8) DDGI's visibility weight of a cell for a point: the distance from the cell's centre to the point
// (in cell sizes) against the cell's mean distance toward that direction (its 3 axis bins, weighed by the direction's squared
// components) and the variance (mean square - mean^2): not farther than the mean 1, else the Chebyshev bound var / (var + (d - mean)^2),
// cubed, at least 0.05 (a tie-breaker so a cell is never fully lost). Light cannot come through a wall the cell's rays hit short of the point.
float CacheVisibility(ivec2 t, vec3 toPoint, float size) {
    const float dist = length(toPoint);
    if (!(dist > 1.0e-3)) return 1.0;
    const vec3 dir = toPoint / dist;
    const float d = dist / size;
    const vec4 a = imageLoad(cacheImage, t + ivec2(4, 0)), b = imageLoad(cacheImage, t + ivec2(5, 0)), c = imageLoad(cacheImage, t + ivec2(6, 0));
    const vec3 w = dir * dir;
    const float m1 = w.x * (dir.x >= 0.0 ? a.x : a.y) + w.y * (dir.y >= 0.0 ? a.z : a.w) + w.z * (dir.z >= 0.0 ? c.x : c.y);
    const float m2 = w.x * (dir.x >= 0.0 ? b.x : b.y) + w.y * (dir.y >= 0.0 ? b.z : b.w) + w.z * (dir.z >= 0.0 ? c.z : c.w);
    if (isnan(m1) || isnan(m2) || d <= m1) return 1.0;
    const float v = max(m2 - m1 * m1, 0.01), x = d - m1;
    const float cheb = v / (v + x * x);
    return max(cheb * cheb * cheb, 0.05);
}

// The cache's irradiance at p (scene space) toward n: the 8 cells round the point half a cell off the surface, trilinear, each weighed
// by how much it faces the surface (DDGI's normal weight) and out where its stamp is not the cell's, it has no samples or it sits
// inside something. 0 where no cell is usable (outside the grid, a fresh area).
// UNOFFICIAL 2026-11-12 (sungi p3) one level's lookup (level 0 with visibility off and no cascades = the function as it was): the normalised
// irradiance and the weights' sum. visibility: each cell's weight x CacheVisibility toward the point half a cell off the surface.
vec3 CacheLookupLevel(int level, vec3 p, vec3 n, bool visibility, out float weights) {
    float size;
    vec3 cameraCell, offset;
    CacheLevel(level, size, cameraCell, offset);
    vec3 g = (p + n * (0.5 * size) + offset) / size - 0.5;   // the cell centres at whole numbers (relative to the camera's cell)
    vec3 base = floor(g), f = g - base;
    ivec3 half_ = CacheGrid / 2;
    vec3 sum = vec3(0.0);
    weights = 0.0;
    for (int k = 0; k < 8; k++) {
        ivec3 o = ivec3(k & 1, (k >> 1) & 1, k >> 2);
        ivec3 local = ivec3(base) + o;
        if (any(lessThan(local, -half_)) || any(greaterThanEqual(local, half_))) continue;
        vec3 stamp;
        ivec2 t = CacheTexel(local, cameraCell, level, stamp);
        vec4 head = imageLoad(cacheImage, t + ivec2(3, 0));
        float hw = abs(head.w), m = floor(hw);   // (2026-10-31 b: negative = far from every surface, still valid)
        if (!(m >= 1.0) || any(greaterThan(abs(head.xyz - stamp), vec3(0.25)))) continue;
        float inside = (hw - m) / 0.9;
        vec3 tri = mix(1.0 - f, f, vec3(o));
        vec3 centre = (vec3(local) + 0.5) * size - offset;
        vec3 toCell = centre - p;
        float facing = 0.5 + 0.5 * dot(toCell, n) * inversesqrt(max(dot(toCell, toCell), 1.0e-4));
        float w = tri.x * tri.y * tri.z * (facing * facing + 0.2) * (1.0 - smoothstep(0.15, 0.4, inside));
        if (!(w > 1.0e-5)) continue;
        if (visibility) w *= CacheVisibility(t, p + n * (0.5 * size) - centre, size);   // (the point the trilinear weights use)
        vec4 r = imageLoad(cacheImage, t), gr = imageLoad(cacheImage, t + ivec2(1, 0)), b = imageLoad(cacheImage, t + ivec2(2, 0));
        vec4 dn = vec4(1.0, 2.0 * n);
        vec3 e = max(vec3(dot(r, dn), dot(gr, dn), dot(b, dn)), vec3(0.0));
        if (any(isnan(e)) || any(isinf(e))) continue;
        sum += e * w;
        weights += w;
    }
    return weights > 1.0e-4 ? sum / weights : vec3(0.0);
}

vec3 CacheIrradiance(vec3 p, vec3 n) {
    float size = CacheSize();
    if (!(CACHE_STRENGTH > 0.0) || !(size > 0.0)) return vec3(0.0);
    const int flags = CacheFlags();
    float wf;
    vec3 fine = CacheLookupLevel(0, p, n, (flags & 1) != 0, wf);
    if ((flags & 2) == 0) return fine;   // CacheCascades 1: the single level, as before
    // UNOFFICIAL 2026-11-12 (sungi p3, F18) the coarse level (4 x the cell size) beyond the fine grid: the fine level counts in full inside
    // it, fades out over its outer 2 cells (and where its cells give little weight), the coarse level takes the rest.
    const vec3 q = (p + n * (0.5 * size) + CACHE_A.xyz) / size;   // in cells from the camera's cell corner; the grid spans +-16, +-16, +-8
    const float edge = min(min(15.5 - abs(q.x), 15.5 - abs(q.y)), 7.5 - abs(q.z));
    const float share = wf > 1.0e-4 ? smoothstep(0.0, 2.0, edge) * clamp(wf * 4.0, 0.0, 1.0) : 0.0;
    if (share > 0.999) return fine;
    float wc;
    vec3 coarse = CacheLookupLevel(1, p, n, (flags & 1) != 0, wc);
    if (!(wc > 1.0e-4)) return share > 0.0 ? fine : vec3(0.0);
    return mix(coarse, fine, share);
}

// The light a hit sends back (in the bounce's units: with cosine sampling the pixel's irradiance estimate is pi x the hit's radiance =
// albedo x E), diffuse: its albedo (2026-10-29: the texture's colour at the hit with [Main.Main.RayTracing] HitTextures, RtHit.glsl;
// else the record's average; grey 0.5 when unknown) x what lights it: the sun (N.L, a shadow ray toward it), the ambient from above
// (x GIAmbient x (1 + n.z) / 2: no ray) and the lamps: ONE lamp picked at random in proportion to what it would give unshadowed (N.L,
// quadratic falloff to its reach), its light / its chance, and one shadow ray to it (2026-10-29: resampled importance sampling of the
// lamps, ReSTIR's direct-light step without the reuse; the first version lit every hit by all 8 lamps unshadowed, through walls and
// ceilings: Lucky 38 +8/255 everywhere). xi: the pick's random number. (2026-10-31) + the radiance cache's irradiance there (what
// reaches the hit after one or more bounces: the second bounce on, CacheStrength), already in these units.
// (2026-11-07) ng: the triangle's normal (the lift off the surface); n: the shading normal (ShadingNormal: the normal map's bend)
vec3 Shade(uint instance, uint prim, vec2 bary, vec3 hit, vec3 ng, vec3 n, float t, float xi) {
    Record r = records[instance];
    vec3 albedo = clamp(rtHitAlbedo(instance, prim, bary), 0.0, 1.0);
    // UNOFFICIAL 2026-11-13 (rtgi-review R19) GIHitMips: the caller set the hit's texture footprint (HitCone); the shadow rays below test alpha at lod 0
    // as before (the helper's opacity micromaps count on it: NvrRtOmm.inl FinestMipShader), so it is 0 from here on except round the glow map's read
    const float hitCone = rtConeWidth;
    rtConeWidth = 0.0;
    vec3 lift = hit + ng * (1.0 + 0.002 * t);
    vec3 e = cb.ambient.rgb * (cb.gi.w * (0.5 + 0.5 * n.z));   // GIAmbient (default 0: the game's ambient is already the indirect light)
    float sunCos = dot(n, cb.sunDir.xyz);
    if (cb.sunDir.w > 0.5 && sunCos > 0.0 && Visible(lift, cb.sunDir.xyz, 30000.0)) e += cb.sunColor.rgb * sunCos;
    // UNOFFICIAL 2026-11-03 (rtgi-lamps) gi.z < 0: ALL the frame's lamps (-gi.z of them) from the lamp image, ONE picked in proportion to
    // its unshadowed light here by a one-pass weighted reservoir (RtPathTrace.comp Direct; scalars only, each candidate's own random
    // number hashed from xi), the same light formula and shadow ray as the 8-lamp pick below (which stays as it was for gi.z >= 0).
    if (cb.gi.z < -0.5) {
        int count = min(int(min(-cb.gi.z, 256.0) + 0.5), 256);   // (ptaaa-hangfix: at most the lamp image's 256 lamps)
        float total = 0.0, chosenWeight = 0.0;
        vec3 chosenLight = vec3(0.0), chosenPos = vec3(0.0);
        uint seed = floatBitsToUint(xi);
        for (int k = 0; k < count; k++) {
            vec2 a = imageLoad(lampImage, ivec2(4 * k, 0)).rg, b = imageLoad(lampImage, ivec2(4 * k + 1, 0)).rg;
            vec3 l = vec3(a, b.x) - hit;
            float dist = length(l), reach = abs(b.y);
            if (dist >= reach || dist < 1.0e-3) continue;
            vec3 colour = vec3(imageLoad(lampImage, ivec2(4 * k + 2, 0)).rg, imageLoad(lampImage, ivec2(4 * k + 3, 0)).r);
            vec3 light = colour * (LampFall(dist / reach, b.y < 0.0) * max(dot(n, l / dist), 0.0));
            float w = dot(light, vec3(0.2126, 0.7152, 0.0722));
            if (!(w > 0.0)) continue;
            total += w;
            uint h = (seed ^ uint(k) * 0x9E3779B9u) * 747796405u + 2891336453u;
            h = ((h >> ((h >> 28u) + 4u)) ^ h) * 277803737u;
            h = (h >> 22u) ^ h;
            if (float(h >> 8u) * (1.0 / 16777216.0) * total < w) { chosenWeight = w; chosenLight = light; chosenPos = vec3(a, b.x); }
        }
        if (total > 0.0 && chosenWeight > 0.0) {
            vec3 l = chosenPos - lift;
            float dist = length(l);
            if (Visible(lift, l / dist, max(dist - 16.0, 0.0))) e += chosenLight * (total / chosenWeight);   // (short of its fixture)
        }
    }
    else {
    // The lamps: each one's unshadowed light here, a pick in proportion to its luminance, a shadow ray to the picked one.
    int lamps = int(cb.gi.z + 0.5);
    vec3 lampLight[8];
    float weights[8];
    float total = 0.0;
    for (int k = 0; k < 8; k++) {
        lampLight[k] = vec3(0.0);
        weights[k] = 0.0;
        if (k >= lamps) continue;
        vec3 l = cb.lampPos[k].xyz - hit;
        float dist = length(l);
        float reach = abs(cb.lampPos[k].w);
        if (dist >= reach || dist < 1.0e-3) continue;
        lampLight[k] = cb.lampColor[k].rgb * (LampFall(dist / reach, cb.lampPos[k].w < 0.0) * max(dot(n, l / dist), 0.0));
        weights[k] = dot(lampLight[k], vec3(0.2126, 0.7152, 0.0722));
        total += weights[k];
    }
    if (total > 0.0) {
        float pick = xi * total;
        int chosen = 0;
        for (int k = 0; k < 8; k++) {
            chosen = k;
            if (pick < weights[k]) break;
            pick -= weights[k];
        }
        if (weights[chosen] > 0.0) {
            vec3 l = cb.lampPos[chosen].xyz - lift;
            float dist = length(l);
            // Stops a little short of the lamp: its own fixture (glass, shade) must not block it.
            if (Visible(lift, l / dist, max(dist - 16.0, 0.0))) e += lampLight[chosen] * (total / weights[chosen]);
        }
    }
    }   // (2026-11-03 rtgi-lamps: the constants' lamps)
    // (2026-10-30) GlowGI (ambient.w, 0 = off): a hit on a draw with a glow map (record flag 0x04: neon, lit windows, lamp globes,
    // screens) also sends its own light, its colour (the hit texture's) x GlowGI. The flag covers the whole mesh while the glow map
    // marks only parts of it (a facade's windows), so only the bright parts of the colour count (its strongest channel from 0.35 up to
    // 0.8): the dark wall round a window stays dark. On-screen hits returned in Bounce already carry their glow (the lit frame).
    vec3 glow = vec3(0.0);
    if (cb.ambient.w > 0.0 && (r.flags & 0x04u) != 0u) {
        float peak = max(albedo.r, max(albedo.g, albedo.b));
        glow = albedo * (smoothstep(0.35, 0.8, peak) * cb.ambient.w);
        // (2026-10-30) with the core's glow atlas bound (sunColor.w 1, [Main.Main.RayTracing] GlowTextures): the glow map's own colour
        // at the hit, only the lit parts (rt-sun-core d40b6645), in place of the whole mesh's brightness-gated colour
        if (cb.sunColor.w > 0.5) { rtConeWidth = hitCone; glow = rtHitGlow(instance, prim, bary) * cb.ambient.w; rtConeWidth = 0.0; }   // (2026-11-13 R19)
    }
    vec3 cached = CACHE_STRENGTH > 0.0 ? CacheIrradiance(hit, n) * CACHE_STRENGTH : vec3(0.0);
    return Clamped(albedo * (e * cb.gi2.x + cached) + glow);
}

// One bounce (rt-ao-gi): a cosine-weighted ray from the pixel; at its closest hit the light that surface sends back toward the pixel:
// the game's lit frame where the screen saw it (ScreenLight, GI v2), else Shade. Misses return 0: what the sky gives is the game's own
// ambient already (unless GISky, below).
// UNOFFICIAL 2026-11-12 (sungi p3, F6) SkyMissSH: gi.y + 10 = the directional sky is on. The sky's radiance as an order-2 SH, 9 coefficients
// x rgb, already weighted per band (radiance = the irradiance harmonics x 1, 1.5, 4 and the C++'s linear scale; SkyAmbientSharp's maths), in
// 14 RG32F texels of the lamp image's row 1 (float f = 3 i + channel at texel f / 2, component f & 1). The basis is the lit shaders' order:
// 1, y, z, x, xy, yz, 3zz - 1, xz, xx - yy.
vec3 SkyRadianceSH(vec3 d) {
    float c[28];
    for (int k = 0; k < 14; k++) { vec2 v = imageLoad(lampImage, ivec2(k, 1)).rg; c[2 * k] = v.x; c[2 * k + 1] = v.y; }
    const float basis[9] = float[9](1.0, d.y, d.z, d.x, d.x * d.y, d.y * d.z, 3.0 * d.z * d.z - 1.0, d.x * d.z, d.x * d.x - d.y * d.y);
    vec3 r = vec3(0.0);
    for (int i = 0; i < 9; i++) r += vec3(c[3 * i], c[3 * i + 1], c[3 * i + 2]) * basis[i];
    return max(r, vec3(0.0));
}
// UNOFFICIAL 2026-11-10 (gisky; tester: AL occlusion and GIStrength change plants and objects, never the terrain) [Shaders.AmbientOcclusion.RT]
// GISky (gi.y - 1, outdoors only; 0 = off, exactly as before): a ray that finds nothing brings back the ambient (sky) light, full above the
// horizon and none below it (a smooth band of +-0.25 in d.z), capped as a hit's sample. Open upward ground sent nearly every ray to the
// sky, so its bounce was ~0 and GIStrength had nothing to scale (log 2026-11-10 00:58:31: soil 0.0007 against a wall's 0.05). It adds
// to the game's own ambient (a second copy of the sky's light), hence off by default.
// (2026-11-12 sungi p3, F6) with SkyMissSH (gi.y > 5) the miss brings the sky's radiance in ITS direction (SkyRadianceSH) instead of the
// flat ambient, fading to 0 over d.z in [-0.1, 0]; the GI pass, the AO pass's own bounce and the radiance cache pass all use it.
vec3 SkyMiss(vec3 d) {
    const bool directional = cb.gi.y > 5.0;
    float s = (directional ? cb.gi.y - 10.0 : cb.gi.y) - 1.0;
    if (s <= 0.0) return vec3(0.0);
    if (directional) return Clamped(SkyRadianceSH(d) * (s * clamp(1.0 + 10.0 * d.z, 0.0, 1.0)));
    return Clamped(cb.ambient.rgb * (s * clamp(0.5 + 2.0 * d.z, 0.0, 1.0)));
}
// UNOFFICIAL 2026-11-13 (rtgi-review R19) GIHitMips (sunDir.w's fraction 0.25; the sun test is > 0.5): the footprint of a bounce ray at its hit, for the
// hit's texture reads (albedo, glow map, normal map): 0.5 x the ray's length, the path tracer's rule for its bounces (RtPathTrace.comp). A diffuse
// bounce stands for a wide lobe: mip 0 of a 2048 texture gave each sample one texel's colour (noise for the reuse and the denoiser, and random reads
// of the largest mip). 0 = off: the finest mip, as before.
float HitCone(float t) { return fract(cb.sunDir.w) > 0.1 ? 0.5 * t : 0.0; }
#ifndef RT_CACHE_PASS
// (2026-11-07 ptaaa-firstperson) a committed hit into Bounce's locals (a rayQueryEXT cannot be copied)
#define AO_TAKE_HIT(Q) { found = rayQueryGetIntersectionTypeEXT(Q, true) == gl_RayQueryCommittedIntersectionTriangleEXT; if (found) { \
    t = rayQueryGetIntersectionTEXT(Q, true); instance = rayQueryGetIntersectionInstanceIdEXT(Q, true); \
    prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(Q, true)); bary = rayQueryGetIntersectionBarycentricsEXT(Q, true); \
    toWorld = rayQueryGetIntersectionObjectToWorldEXT(Q, true); } }
// UNOFFICIAL 2026-11-13 (rtgi-review B3) the last Bounce's hit, for GISamplePoints: its distance along the ray (0: a miss, the sky) and the hit
// triangle's normal, turned toward the ray
float gBounceT = 0.0;
vec3 gBounceN = vec3(0.0, 0.0, 1.0);
vec4 Bounce(vec3 start, vec3 d, float tMin, float xi) {
    rayQueryEXT q;
    bool found = false;
    gBounceT = 0.0;
    float t = 0.0;
    uint instance = 0u, prim = 0u;
    vec2 bary = vec2(0.0);
    mat4x3 toWorld = mat4x3(1.0);
    // (2026-11-07 ptaaa-firstperson) from near the eye (the view model's pixels): the hidden first-person body passed over (as TraceHidden)
    if (rtHiddenNear(start, vec3(0.0))) {
        rayQueryInitializeEXT(q, scene, gl_RayFlagsOpaqueEXT, RT_CULL & 0x8Fu, start + cb.origin.xyz, tMin, d, cb.gi.x);
        for (uint rtCap_ = 0u; rayQueryProceedEXT(q); ) if (++rtCap_ > 256u) { rayQueryTerminateEXT(q); break; } else {}
        AO_TAKE_HIT(q);
        rayQueryEXT qp;
        rayQueryInitializeEXT(qp, scene, gl_RayFlagsNoOpaqueEXT, RT_CULL & 0x70u, start + cb.origin.xyz, tMin, d, found ? t : cb.gi.x);
        for (uint rtCap_ = 0u; rayQueryProceedEXT(qp); ) if (++rtCap_ > 256u) { rayQueryTerminateEXT(qp); break; } else {
            if (rayQueryGetIntersectionTypeEXT(qp, false) != gl_RayQueryCandidateIntersectionTriangleEXT) continue;
            if ((rayQueryGetIntersectionInstanceCustomIndexEXT(qp, false) & NVR_RT_CUSTOM_HIDDEN) != 0u) continue;
            if (rtAlphaPass(rayQueryGetIntersectionInstanceIdEXT(qp, false), uint(rayQueryGetIntersectionPrimitiveIndexEXT(qp, false)), rayQueryGetIntersectionBarycentricsEXT(qp, false)))
                rayQueryConfirmIntersectionEXT(qp);
        }
        if (rayQueryGetIntersectionTypeEXT(qp, true) == gl_RayQueryCommittedIntersectionTriangleEXT) AO_TAKE_HIT(qp);
    }
    else {
        rayQueryInitializeEXT(q, scene, 0u, RT_CULL, start + cb.origin.xyz, tMin, d, cb.gi.x);
        Proceed(q);
        AO_TAKE_HIT(q);
    }
    if (!found) return vec4(SkyMiss(d), 1.0);   // (2026-11-10 gisky: was 0)
    vec3 n = HitNormal(instance, prim, toWorld, d);
    vec3 hit = start + d * t;
    gBounceT = t;
    gBounceN = n;
    vec4 seen = ScreenLight(hit);
    if (seen.a > 0.5 && CACHE_B.w < 16.0) return vec4(Clamped(seen.rgb), t / cb.gi.x);   // (DebugView 7: Shade everywhere)
    rtConeWidth = HitCone(t);   // (2026-11-13 R19: for ShadingNormal's and Shade's texture reads; Shade puts it back to 0)
    return vec4(Shade(instance, prim, bary, hit, n, ShadingNormal(instance, prim, bary, n, toWorld, d), t, xi), t / cb.gi.x);
}
#endif

#ifndef RT_CACHE_PASS
// ---- (2026-10-30) ReSTIR GI's reuse step, shared by the GI pass (RT_GI_PASS) and the AO pass at full rate (GIReuse with Interleave 1
// and GIInterleave 1: one pass, ~6 ms less than two on the iGPU, rt-gi-10). v: this texel's point in last frame's view; reuse: the M cap
// + 64 x GISpatial (cap 0: no history, every texel traces); giTile: a new candidate this frame. Writes the reservoir pair curA / curB.
vec2 OctEncode(vec3 n) {
    n /= abs(n.x) + abs(n.y) + abs(n.z);
    vec2 e = n.z >= 0.0 ? n.xy : (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    return e * 0.5 + 0.5;
}
float Luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

// UNOFFICIAL 2026-11-09 (rtgi-lock; docs/next/HANDOFF-RTGI-WEDGE-2026-11-08.md) the sample numbers of the AO and GI rays. The old pair,
// fract(vec2(Ign(texel + a), Ign(texel + b)) + frame x vec2(0.618034, 0.754878)), was LOCKED: Ign's inner phase for b differs from a's by a
// constant (the offset difference x (0.0671 + 0.0058)), so fract(52.98 x phase) differs by a constant too: u.y - u.x was ONE value per frame
// for every texel (float32 replica: 100 % of 1920 x 1080 texels within 0.03 of it), moving 0.1368 of a turn a frame. Every texel's ray
// came from one spiral of directions that turned 0.1368 of a turn a frame, so the bounce light pulsed with a period of 1 / 0.1368 = 7.3
// frames (a tester's footage: the ground +-10 % at 8 Hz; a lobe in direction space is hit by 0 to 8 % of the rays a frame, mean 2 %), and
// where the normals' tangent frame differs (cross(n, up) turns the azimuth when n.z falls under 0.999) the pulse runs half a period
// apart: a screen-fixed step along that border, ghosting when turning. Now the first number is the gradient noise as before and the
// second an integer hash of the texel (independent of it), both stepped in time by R2's pair (a good 2D sequence at each texel).
// decorrelate false (SampleLockFix off): the old pair, bit for bit, for the A/B.
float HashTexel(ivec2 texel, uint salt) {
    uint v = uint(texel.x) + 65536u * uint(texel.y) + salt * 0x9E3779B9u;   // (2026-11-09 rt-review R8: was 2048u, so on a trace grid wider than 2048 texel (x, y) had (x - 2048, y + 1)'s numbers)
    v = v * 747796405u + 2891336453u;
    v = ((v >> ((v >> 28u) + 4u)) ^ v) * 277803737u;
    v = (v >> 22u) ^ v;
    return float(v >> 8u) * (1.0 / 16777216.0);
}
vec2 SampleU(ivec2 texel, float frame, float offsetA, float offsetB, vec2 add, bool decorrelate) {
    if (!decorrelate)
        return fract(vec2(Ign(vec2(texel) + offsetA), Ign(vec2(texel) + offsetB)) + frame * vec2(0.618034, 0.754878) + add);
    return fract(vec2(Ign(vec2(texel) + offsetA), HashTexel(texel, uint(offsetB))) + frame * vec2(0.7548777, 0.5698403) + add);
}
// (2026-11-09 rtgi-lock, second step) one number for each decision around the ray (the reservoir's acceptance tests, the spatial spin, the glow light pick, the bounce's light pick):
// an integer hash of the texel with its own salt, and its own irrational step per frame. The old ones were gradient noise stepped by 0.618 / 0.7548777 / 0.56984: the acceptance
// number kept a fixed relation to the ray's own numbers (replica: 100 % of the texels the same fract(r - u), r - u.y static, r - u.x drifting at the pulse's 0.1368 a frame), so a
// texel only ever accepted candidates from one window of directions: a bias that differs where the tangent frames differ, and a second pulse. SampleLockFix off: the old numbers.
float Decide(ivec2 texel, uint salt, float frame, float step_) { return fract(HashTexel(texel, salt) + frame * step_); }

// (2026-10-30) GlowDirect: the glow-mapped instances (neon, lit signs, lamp globes, screens) light the texel directly, as sphere lights
// (glowList, filled by NVR from RtCore::GlowLights(): row 0 the centre in scene space + the bound's radius, row 1 the colour; texel
// (0, 2) x the count, y the strength). One light picked per texel in proportion to what it would give unshadowed (its colour x
// strength x radius^2 / distance^2 x the cosine: resampled importance sampling over the whole list, ReSTIR DI's first step), one
// shadow ray to a point on it; light / its chance. Closer than its (emitting) radius: no shadow ray. GIClamp caps it.
// (v2, rt-gi-18: v1 lit Lucky 38 grey all over, mean 22 -> 95: big glow-flagged meshes (rooms, facades with a few lit details) have
// bounds round half the room, greyish average colours, and every texel inside them took their full colour unshadowed.) Now NVR sends
// the emitting radius (the bound's, at most 32 units; meshes over 256 left out) and the colour already gated by its brightness (as
// GlowGI: its strongest channel from 0.35 to 0.8), so only small bright emitters count.
#ifdef RT_GI_PASS
vec3 GlowDirect(ivec2 texel, vec3 p, vec3 n, float bias, bool decorrelate) {
    vec4 head = imageLoad(glowList, ivec2(0, 2));
    int count = min(int(head.x + 0.5), 32);
    if (count <= 0 || !(head.y > 0.0)) return vec3(0.0);
    vec3 start = p + n * bias;
    float total = 0.0;
    for (int k = 0; k < count; k++) {
        vec4 s = imageLoad(glowList, ivec2(k, 0));
        vec3 l = s.xyz - start;
        float d2 = max(dot(l, l), s.w * s.w), c = dot(n, l) * inversesqrt(max(dot(l, l), 1.0e-4));
        if (c > 0.0) total += Luma(imageLoad(glowList, ivec2(k, 1)).rgb) * s.w * s.w / d2 * c;
    }
    if (!(total > 0.0)) return vec3(0.0);
    float frame = cb.origin.w;
    float pick = (decorrelate ? Decide(texel, 307u, frame, 0.2360680) : fract(Ign(vec2(texel) + 307.0) + frame * 0.618034)) * total;
    for (int k = 0; k < count; k++) {
        vec4 s = imageLoad(glowList, ivec2(k, 0));
        vec3 col = imageLoad(glowList, ivec2(k, 1)).rgb;
        vec3 l = s.xyz - start;
        float dist = length(l), d2 = max(dist * dist, s.w * s.w), c = dot(n, l) / max(dist, 1.0e-2);
        if (!(c > 0.0)) continue;
        vec3 e = col * (head.y * s.w * s.w / d2 * c);
        float w = Luma(e);
        if (pick >= w && k < count - 1) { pick -= w; continue; }
        if (!(w > 0.0)) return vec3(0.0);
        // a point on the sphere's inner half (soft shadows), the ray stopping at its surface
        vec2 u = decorrelate ? fract(vec2(Ign(vec2(texel) + 331.0), HashTexel(texel, 359u)) + frame * vec2(0.7548777, 0.5698403))   // (2026-11-09 rtgi-lock)
                             : fract(vec2(Ign(vec2(texel) + 331.0), Ign(vec2(texel) + 359.0)) + frame * vec2(0.754878, 0.569840));
        vec3 target = s.xyz + CosineDirection(-l / max(dist, 1.0e-2), u) * (0.5 * s.w);
        vec3 toT = target - start;
        float t = length(toT);
        bool lit = dist <= s.w || Visible(start, toT / max(t, 1.0e-3), max(t - 0.5 * s.w, 0.0));
        return lit ? Clamped(e * (total / w)) : vec3(0.0);
    }
    return vec3(0.0);
}
#endif

// (2026-10-31, rt-ao-sky) with [Main.Main.RayTracing] DenoiseBackbone and B1's object motion this frame (gi2.y < 0): how many texels the
// surface's own move shifts it on last frame's screen beyond the camera's move (core\RtDenoise.cpp GIMotion, Compute\RtGIMotion.frag:
// the frame light's alpha, (dx + 16) + 32 (dy + 16)); the reprojected texel follows it, so a walking NPC keeps its samples
ivec2 GIMotion(ivec2 texel) {
    if (!(cb.gi2.y < 0.0)) return ivec2(0);
    int e = int(imageLoad(frameLight, texel).a + 0.5);
    return e >= 1 && e <= 1023 ? ivec2((e & 31) - 16, (e >> 5) - 16) : ivec2(0);
}

// UNOFFICIAL 2026-11-08 (rtgi-ghost; tester: dark streaks fanning out across the sand behind a running player, "crazy ghosting when
// looking around", GIReuse 32) GIReuseSpread: how much of its M a reservoir copied from last frame keeps. Last frame's texel is copied
// onto every texel that reprojects into it; where the surface is now seen larger (the camera came closer, or it moved toward the
// screen's edge) that is several texels, each then holding the same sample at full M: a new candidate rarely displaces it (1 in M), so
// the copies stay and are copied again next frame - streaks along the screen's motion that last GIReuse frames. Each copy keeps the
// share of the old texel's surface it covers: the area a texel sees is ~ z^3 / |n . P| (P the camera-relative point, z its view depth:
// the texel's solid angle ~ (z / |P|)^3, over the surface's cosine), so share = (this frame's area / last frame's), at most 1.
float ReuseSpread(vec3 p, vec3 prevPoint, vec3 n, float viewZ, float prevZ) {
    float now = viewZ * viewZ * viewZ / max(abs(dot(n, p)), 0.5);
    float then = prevZ * prevZ * prevZ / max(abs(dot(n, prevPoint)), 0.5);
    return then > 0.0 ? clamp(now / then, 0.0, 1.0) : 1.0;
}

void ReuseGI(ivec2 texel, vec3 p, vec3 n, float viewZ, float bias, bool giTile, vec3 v, float reuse, vec3 prevPoint) {
    // Last frame's reservoir of this surface. (2026-10-30, v2) Outside the frame's tiles a texel without its own history (a
    // disocclusion, a screen edge) borrows a neighbour's last frame (2 texels round the reprojected point, depth within 15 %) instead
    // of tracing: v1 traced there, and one such texel made its whole wave pay for the bounce (rt-gi-10/11: GIInterleave 4 cost ~12-14
    // ms where a quarter of the full rate's 26 is 6.5). Nothing usable: empty (M 0) until its tile's turn.
    // (2026-11-08 rtgi-ghost) reuse = the M cap + 64 x GISpatial + 4096 x flags: 1 GIReuseSpread (above), 2 GIReuseShuffle (below)
    int reuseCode = int(reuse + 0.5);
    int reuseFlags = reuseCode / 4096;
    const bool decorrelate = (reuseFlags & 4) != 0;   // (2026-11-09 rtgi-lock: SampleLockFix)
    float reuseRest = float(reuseCode - reuseFlags * 4096);
    float cap = mod(reuseRest, 64.0), historyM = 0.0;
    int spatial = clamp(int(min(reuseRest / 64.0, 16.0)), 0, 16);   // (ptaaa-hangfix: capped; GISpatial is 0-4)
    float spread = (reuseFlags & 1) != 0 && v.z > 1.0 ? ReuseSpread(p, prevPoint, n, viewZ, v.z) : 1.0;
    vec4 history = vec4(0.0);
    ivec2 qt = ivec2(-1);
    if (cap > 0.5) {
        if (v.z > 1.0) {
            vec2 q = vec2(0.5 + 0.5 * v.x / (v.z * cb.projection.x), 0.5 - 0.5 * v.y / (v.z * cb.projection.y));
            qt = ivec2(floor(q * cb.projection.zw)) + GIMotion(texel);
            // (2026-11-08 rtgi-ghost) GIReuseShuffle (RTXDI's permutation sampling): first the texel of the reprojected one's 2 x 2 block
            // that this frame's mask picks (an XOR inside blocks whose corner moves each frame, the same for every texel: a one-to-one
            // shuffle, so it copies nothing twice), then the plain one if that surface does not match. Copies one frame lands side by
            // side then come from different texels the next: no long runs of one sample along the motion, the denoiser gets noise
            // instead of streaks.
            int shuffle = (reuseFlags & 2) != 0 ? int(fract(cb.origin.w * 0.618034 + 0.25) * 16.0) : 0;
            ivec2 shift = ivec2(shuffle & 1, (shuffle >> 1) & 1), mask = ivec2((shuffle >> 2) & 1, (shuffle >> 3) & 1);
            ivec2 shuffled = ((qt + shift) ^ mask) - shift;
            const ivec2 around[5] = ivec2[5](ivec2(0, 0), ivec2(2, 0), ivec2(-2, 0), ivec2(0, 2), ivec2(0, -2));
            int first = any(notEqual(shuffled, qt)) ? -1 : 0;
            int tries = giTile ? 1 : 5;
            bool found = false;   // (2026-11-08: was historyM < 0.5, which a spread M under 0.5 would no longer stop)
            for (int k = first; k < tries && !found; k++) {
                ivec2 at = k < 0 ? shuffled : qt + around[k];
                if (any(lessThan(at, ivec2(0))) || any(greaterThanEqual(at, ivec2(cb.projection.zw)))) continue;
                vec4 b = imageLoad(prevB, at);
                float tolerance = k <= 0 ? 0.05 : 0.15;
                if (b.x > 0.5 && abs(b.y - v.z) < tolerance * v.z + 2.0 && dot(OctDecode(b.zw), n) > 0.9) {
                    history = imageLoad(prevA, at);
                    historyM = min(b.x, cap) * spread;
                    found = true;
                    if (!(history.a >= 0.0) || any(isnan(history.rgb)) || any(isinf(history.rgb))) { history = vec4(0.0); historyM = 0.0; found = false; }
                }
            }
        }
    }
    vec3 chosen = history.a > 0.0 ? history.rgb / history.a : vec3(0.0);
    float weightSum = Luma(chosen) * history.a * historyM, m = historyM;

    // (2026-10-30) GISpatial: ReSTIR's spatial step, from last frame's reservoirs: up to 4 neighbours (random, 3-12 texels round the
    // reprojected point, turned each frame) whose surface matches (depth 5 %, normal ~18 deg) join with their weight sums, each M at
    // most cap / 2. No visibility test and no Jacobian (a neighbour's sample is taken as light arriving here too): fine across a
    // floor or a wall, can leak a little across contact shadows (that is what the depth / normal tests and the short radius limit).
    if (spatial > 0 && qt.x >= 0 && v.z > 1.0) {
        float frame = cb.origin.w;
        float spin = 6.2831853 * (decorrelate ? Decide(texel, 211u, frame, 0.1415927) : fract(Ign(vec2(texel) + 211.0) + frame * 0.618034));
        for (int k = 0; k < spatial; k++) {
            float a = spin + float(k) * 2.3999632;  // the golden angle
            float r = 3.0 + 9.0 * fract(0.5 + float(k) * 0.618034 + frame * 0.381966);
            ivec2 at = qt + ivec2(round(vec2(cos(a), sin(a)) * r));
            if (any(lessThan(at, ivec2(0))) || any(greaterThanEqual(at, ivec2(cb.projection.zw)))) continue;
            vec4 b = imageLoad(prevB, at);
            if (!(b.x > 0.5) || abs(b.y - v.z) > 0.05 * v.z + 2.0 || dot(OctDecode(b.zw), n) < 0.95) continue;
            vec4 h = imageLoad(prevA, at);
            if (!(h.a > 0.0) || any(isnan(h.rgb)) || any(isinf(h.rgb))) continue;
            vec3 l = h.rgb / h.a;
            float mk = min(b.x, max(cap * 0.5, 1.0)) * spread;   // (2026-11-08 rtgi-ghost: GIReuseSpread too)
            float w = Luma(l) * h.a * mk;
            weightSum += w;
            m += mk;
            if ((decorrelate ? Decide(texel, 257u + 31u * uint(k), frame, 0.4142136) : fract(Ign(vec2(texel) + 257.0 + 31.0 * float(k)) + frame * 0.7548777)) * weightSum < w) chosen = l;
        }
    }

    // The first frame of a reservoir (cap 0: no history at all) traces everywhere.
    if (giTile || cap < 0.5) {
        float frame = cb.origin.w;
        vec2 u = SampleU(texel, frame, 41.0, 73.0, vec2(0.381966, 0.5), decorrelate);   // (2026-11-09 rtgi-lock; was the locked pair)
        vec3 light = Bounce(p + n * bias, CosineDirection(n, u), 0.05 * bias, decorrelate ? Decide(texel, 97u, frame, 0.5497005) : fract(Ign(vec2(texel) + 97.0) + frame * 0.569840)).rgb;
        float w = Luma(light);
        weightSum += w;
        m += 1.0;
        if ((decorrelate ? Decide(texel, 131u, frame, 0.3247180) : fract(Ign(vec2(texel) + 131.0) + frame * 0.7548777)) * weightSum < w) chosen = light;
        // UNOFFICIAL 2026-11-13 (rtgi-review B1) GICandidates 2 (reuse flag 8): a second new candidate into the same reservoir (streaming RIS, as the
        // first: cosine-sampled, weight = its luminance). Its direction: the first one's numbers moved by (0.5, 0.25), which is no whole step of the
        // per-frame R2 step (so it is not next frame's first ray), its decisions from their own salts. Twice the new light a frame for the rays' cost.
        if ((reuseFlags & 8) != 0) {
            const vec2 u2 = fract(u + vec2(0.5, 0.25));
            const vec3 light2 = Bounce(p + n * bias, CosineDirection(n, u2), 0.05 * bias, Decide(texel, 103u, frame, 0.5497005)).rgb;
            const float w2 = Luma(light2);
            weightSum += w2;
            m += 1.0;
            if (Decide(texel, 139u, frame, 0.3247180) * weightSum < w2) chosen = light2;
        }
    }
    float target = Luma(chosen);
    float W = m > 0.0 && target > 0.0 ? weightSum / (m * target) : 0.0;
    imageStore(curA, texel, vec4(chosen * W, W));
    imageStore(curB, texel, vec4(m, viewZ, OctEncode(n)));
#ifdef RT_GI_PASS
    imageStore(giOut, texel, vec4(chosen * W + GlowDirect(texel, p, n, bias, (reuseFlags & 4) != 0), 1.0));
#else
    imageStore(giOut, texel, vec4(chosen * W, 1.0));
#endif
}


// ---- UNOFFICIAL 2026-11-13 (rtgi-review B3; RTGIReview/REVIEW.md R3, R18) GISamplePoints (reuse flag 16): ReSTIR GI with the sample's geometry, after
// the path tracer's RtRestirGI.comp (Ouyang et al. 2021). ReuseGI above keeps only the chosen light: a neighbour's sample is taken as arriving here
// too, with no cosine of this surface, no Jacobian and no visibility test, so light spreads sideways and indirect shadows wash out. Here a reservoir
// also holds WHERE its light comes from: the direction and distance from its surface point to the sample point and the normal there. So:
//   - the target is luminance x the cosine at THIS surface toward the sample point (a sample behind this surface counts nothing);
//   - a neighbour's sample is weighed by the Jacobian of the solid angle it covers here against there, and left out when that is under 0.1 or over 10;
//   - a sample taken from a neighbour gets one visibility ray from here (blocked: no light from it this frame);
//   - GIValidate (reuse flag 32): 1 texel in 8 a frame re-traces the ray to its kept sample point: something else in the way now (a door, a person,
//     a thing that moved), or nothing where it was, and the history is dropped there. (Geometry only: the light at a hit is one randomly picked lamp, so
//     two shadings of the same point differ by chance; a change of the lights still goes through the history cut in AmbientOcclusion.cpp.)
// Units: a candidate's light S is Bounce's (pi x the radiance: with cosine sampling the estimate of the irradiance), its source density is taken as the
// cosine alone, so its weight is lum(S) and the texel's estimate is S x cos x W, W = weight sum / (M x lum(S) x cos): one candidate alone gives S.
// Storage, no new shared image: A = (S, W) (ReuseGI's is (S x W, W): NVR restarts the history when the mode changes); B = (M, view depth, normal) as
// before; the sample point in the LOWER HALF of the B image (NVR makes it twice as tall): (direction, octahedral; distance, 0 = the sky; the hit's
// normal in 10 bits).
struct GISample { vec3 x2; vec3 n2; vec3 S; float sky; };   // x2: the sample point, this frame's camera-relative scene space (the sky: far along its direction)
const float kGISky = 1.0e5;
float GIPackNormal(vec3 n) { vec2 q = floor(clamp(OctEncode(n), 0.0, 1.0) * 31.0 + 0.5); return q.x * 32.0 + q.y; }   // (whole numbers under 1024: exact in a half float)
vec3 GIUnpackNormal(float f) { float h = floor(f / 32.0); return OctDecode(vec2(h, f - h * 32.0) / 31.0); }
float GITarget(GISample s, vec3 x1, vec3 n1) {
    vec3 d = s.x2 - x1;
    return Luma(s.S) * max(dot(n1, d) * inversesqrt(max(dot(d, d), 1.0e-8)), 0.0);
}
float GIJacobian(GISample s, vec3 xFrom, vec3 xTo) {
    if (s.sky > 0.5) return 1.0;
    vec3 a = xFrom - s.x2, b = xTo - s.x2;
    float la = dot(a, a), lb = dot(b, b);
    float ca = abs(dot(s.n2, a)) * inversesqrt(max(la, 1.0e-8)), cb_ = abs(dot(s.n2, b)) * inversesqrt(max(lb, 1.0e-8));
    return ca > 1.0e-4 ? (cb_ / ca) * (la / max(lb, 1.0e-8)) : 0.0;
}
// Last frame's reservoir at texel `at` (b: its B texel): its surface point xq and its sample, both in THIS frame's camera-relative space (prevToWorld:
// last frame's view -> scene directions, move: this frame's camera minus last frame's). False: nothing usable.
bool GILoadPrev(ivec2 at, vec4 b, mat3 prevToWorld, vec3 move, out GISample s, out float W, out vec3 xq) {
    vec4 a = imageLoad(prevA, at);
    vec4 c = imageLoad(prevB, at + ivec2(0, imageSize(prevB).y / 2));
    vec2 uvq = (vec2(at) + 0.5) / cb.projection.zw;
    xq = prevToWorld * (vec3((uvq.x * 2.0 - 1.0) * cb.projection.x, (1.0 - uvq.y * 2.0) * cb.projection.y, 1.0) * b.y) - move;
    vec3 dir = OctDecode(clamp(c.xy, 0.0, 1.0));
    s.sky = c.z > 0.0 ? 0.0 : 1.0;
    s.x2 = xq + dir * (c.z > 0.0 ? c.z : kGISky);
    s.n2 = c.z > 0.0 ? GIUnpackNormal(clamp(c.w, 0.0, 1023.0)) : -dir;
    s.S = max(a.rgb, vec3(0.0));
    W = a.a;
    return W > 0.0 && !isnan(W) && !isinf(W) && !any(isnan(s.S)) && !any(isinf(s.S)) && !any(isnan(c)) && !any(isinf(c));
}
void ReuseGIPoints(ivec2 texel, vec3 p, vec3 n, float viewZ, float bias, bool giTile, vec3 v, float reuse, vec3 prevPoint, mat3 prevToWorld) {
    int reuseCode = int(reuse + 0.5);
    int reuseFlags = reuseCode / 4096;
    float reuseRest = float(reuseCode - reuseFlags * 4096);
    float cap = mod(reuseRest, 64.0);
    int spatial = clamp(int(min(reuseRest / 64.0, 16.0)), 0, 16);
    float spread = (reuseFlags & 1) != 0 && v.z > 1.0 ? ReuseSpread(p, prevPoint, n, viewZ, v.z) : 1.0;
    const float frame = cb.origin.w;
    const vec3 move = prevPoint - p;
    const vec3 start = p + n * bias;
    GISample sel;
    sel.x2 = p + n * kGISky; sel.n2 = -n; sel.S = vec3(0.0); sel.sky = 1.0;
    float wSum = 0.0, m = 0.0;
    bool fromNeighbour = false;
    ivec2 qt = ivec2(-1);
    // temporal: last frame's reservoir of this surface (the lookup as ReuseGI's: the shuffled texel first, then the plain one, then neighbours)
    if (cap > 0.5 && v.z > 1.0) {
        vec2 q = vec2(0.5 + 0.5 * v.x / (v.z * cb.projection.x), 0.5 - 0.5 * v.y / (v.z * cb.projection.y));
        qt = ivec2(floor(q * cb.projection.zw)) + GIMotion(texel);
        int shuffle = (reuseFlags & 2) != 0 ? int(fract(cb.origin.w * 0.618034 + 0.25) * 16.0) : 0;
        ivec2 shift = ivec2(shuffle & 1, (shuffle >> 1) & 1), mask = ivec2((shuffle >> 2) & 1, (shuffle >> 3) & 1);
        ivec2 shuffled = ((qt + shift) ^ mask) - shift;
        const ivec2 around[5] = ivec2[5](ivec2(0, 0), ivec2(2, 0), ivec2(-2, 0), ivec2(0, 2), ivec2(0, -2));
        int first = any(notEqual(shuffled, qt)) ? -1 : 0;
        int tries = giTile ? 1 : 5;
        bool found = false;
        for (int k = first; k < tries && !found; k++) {
            ivec2 at = k < 0 ? shuffled : qt + around[k];
            if (any(lessThan(at, ivec2(0))) || any(greaterThanEqual(at, ivec2(cb.projection.zw)))) continue;
            vec4 b = imageLoad(prevB, at);
            float tolerance = k <= 0 ? 0.05 : 0.15;
            if (!(b.x > 0.5 && abs(b.y - v.z) < tolerance * v.z + 2.0 && dot(OctDecode(b.zw), n) > 0.9)) continue;
            GISample s;
            float W;
            vec3 xq;
            if (!GILoadPrev(at, b, prevToWorld, move, s, W, xq)) continue;
            found = true;
            float hm = min(b.x, cap) * spread;
            // GIValidate: 1 texel in 8 a frame re-traces the ray to its kept sample point (the closest hit, cut-outs tested, decals passed)
            if ((reuseFlags & 32) != 0 && ((texel.x + 3 * texel.y + int(frame)) & 7) == 0) {
                vec3 d = s.x2 - start;
                float len = length(d);
                vec2 hit = Trace(start, d / max(len, 1.0e-3), 0.05 * bias, s.sky > 0.5 ? cb.gi.x : min(len * 1.05 + 4.0, cb.gi.x), false, 2);
                bool same = s.sky > 0.5 ? hit.x < 0.0 : (hit.x >= 0.0 && abs(hit.x - len) < 0.05 * len + 4.0);
                if (!same) hm = 0.0;
            }
            if (hm > 0.0) {
                float w = GITarget(s, p, n) * W * hm;
                wSum += w;
                m += hm;
                if (w > 0.0) sel = s;
            }
        }
    }
    // spatial: neighbours of last frame's reservoirs round the reprojected point, each weighed by its Jacobian
    if (spatial > 0 && qt.x >= 0 && v.z > 1.0) {
        float spin = 6.2831853 * Decide(texel, 211u, frame, 0.1415927);
        for (int k = 0; k < spatial; k++) {
            float a = spin + float(k) * 2.3999632;
            float r = 3.0 + 9.0 * fract(0.5 + float(k) * 0.618034 + frame * 0.381966);
            ivec2 at = qt + ivec2(round(vec2(cos(a), sin(a)) * r));
            if (any(lessThan(at, ivec2(0))) || any(greaterThanEqual(at, ivec2(cb.projection.zw)))) continue;
            vec4 b = imageLoad(prevB, at);
            if (!(b.x > 0.5) || abs(b.y - v.z) > 0.05 * v.z + 2.0 || dot(OctDecode(b.zw), n) < 0.95) continue;
            GISample s;
            float W;
            vec3 xq;
            if (!GILoadPrev(at, b, prevToWorld, move, s, W, xq)) continue;
            float J = GIJacobian(s, xq, p);
            if (!(J > 0.1 && J < 10.0)) continue;
            float mk = min(b.x, max(cap * 0.5, 1.0)) * spread;
            float w = GITarget(s, p, n) * W * mk * J;
            wSum += w;
            m += mk;
            if (w > 0.0 && Decide(texel, 257u + 31u * uint(k), frame, 0.4142136) * wSum < w) { sel = s; fromNeighbour = true; }
        }
    }
    // this frame's own candidates (cosine-sampled: weight = luminance)
    if (giTile || cap < 0.5) {
        const int candidates = (reuseFlags & 8) != 0 ? 2 : 1;
        vec2 u = SampleU(texel, frame, 41.0, 73.0, vec2(0.381966, 0.5), true);
        for (int c = 0; c < candidates; c++) {
            vec3 d = CosineDirection(n, c == 0 ? u : fract(u + vec2(0.5, 0.25)));
            GISample s;
            s.S = Bounce(start, d, 0.05 * bias, Decide(texel, c == 0 ? 97u : 103u, frame, 0.5497005)).rgb;
            s.sky = gBounceT > 0.0 ? 0.0 : 1.0;
            s.x2 = start + d * (gBounceT > 0.0 ? gBounceT : kGISky);
            s.n2 = gBounceT > 0.0 ? gBounceN : -d;
            float w = Luma(s.S);
            wSum += w;
            m += 1.0;
            if (w > 0.0 && Decide(texel, c == 0 ? 131u : 139u, frame, 0.3247180) * wSum < w) { sel = s; fromNeighbour = false; }
        }
    }
    float target = GITarget(sel, p, n);
    float W = m > 0.0 && target > 0.0 ? wSum / (m * target) : 0.0;
    vec3 toSample = sel.x2 - start;
    float len = length(toSample);
    if (fromNeighbour && W > 0.0 && !Visible(start, toSample / max(len, 1.0e-3), sel.sky > 0.5 ? cb.gi.x : max(len - max(2.0, 0.02 * len), 0.0))) W = 0.0;
    if (isnan(W) || isinf(W)) W = 0.0;
    vec3 dsel = sel.x2 - p;
    float dl = length(dsel);
    vec3 dirSel = dsel / max(dl, 1.0e-3);
    // the estimate, its luminance capped at 2 x GIClamp (a dim own sample chosen among bright blocked neighbours carries the whole weight sum)
    vec3 estimate = sel.S * (max(dot(n, dirSel), 0.0) * W);
    float le = Luma(estimate);
    if (le > 2.0 * cb.gi2.z) estimate *= 2.0 * cb.gi2.z / le;
    imageStore(curA, texel, vec4(sel.S, W));
    imageStore(curB, texel, vec4(m, viewZ, OctEncode(n)));
    imageStore(curB, texel + ivec2(0, imageSize(curB).y / 2), vec4(OctEncode(dirSel), sel.sky > 0.5 ? 0.0 : dl, GIPackNormal(sel.n2)));
#ifdef RT_GI_PASS
    imageStore(giOut, texel, vec4(estimate + GlowDirect(texel, p, n, bias, true), 1.0));
#else
    imageStore(giOut, texel, vec4(estimate, 1.0));
#endif
}
#ifndef RT_GI_PASS
// UNOFFICIAL 2026-11-08 (alsky; tester: Skylighting with RT AO draws hard straight lines on roads and paths, RT AO itself looks right) how
// much one sky ray is blocked, 0 open .. 1 blocked. flags (sky.y / 1000, core/RtAmbient.h): 0 as before, any hit within the reach blocks
// it in full. 1 SkyInsideFix: the closest hit; a back face within insideReach of the start means the ray began under the traced surface
// (a road or path mesh drawn just below the land, the depth a little off far away): it carries on from just past that face, once. The AO
// rays already count such a ray open (their 'inside'); the sky rays took the face for cover, so whole roads lost their sky light with the
// road's own hard edges. 2 SkySoftEdges: a hit counts in full to half the reach and nothing at its end, as the AO rays: no hard edge at
// SkyDistance from walls, cliffs and banks.
float SkyBlocked(vec3 start, vec3 d, float reach, int alpha, int flags, float insideReach) {
    if (flags == 0) return Trace(start, d, 0.0, reach, true, alpha).x >= 0.0 ? 1.0 : 0.0;
    vec2 hit = Trace(start, d, 0.0, reach, false, alpha);
    if ((flags & 1) != 0 && hit.x >= 0.0 && hit.y > 0.5 && hit.x < insideReach) {
        float skip = hit.x + 1.0;
        hit = Trace(start + d * skip, d, 0.0, max(reach - skip, 1.0), false, alpha);
        if (hit.x >= 0.0) hit.x += skip;
    }
    if (hit.x < 0.0) return 0.0;
    return (flags & 2) != 0 ? 1.0 - smoothstep(0.5 * reach, reach, hit.x) : 1.0;
}

void main() {
    // (2026-10-29) Interleave: only every 2nd (checkerboard) or every 4th (one texel of each 2 x 2, in turn) texel is traced a frame;
    // the others keep the result they last had (the shared images persist) and AmbientLight's history blends them. The dispatch is
    // that much smaller and each thread maps to a traced texel (v1 let the skipped threads exit inside full groups: rt-gi-5 measured
    // Interleave 2 at only -17 %, the groups ran as long as their slowest traced texel).
    ivec2 thread = ivec2(gl_GlobalInvocationID.xy);
    int interleave = int(cb.gi2.w + 0.5);
    int turn = int(cb.origin.w + 0.5);
    ivec2 texel = interleave >= 4 ? ivec2(2 * thread.x + (turn & 1), 2 * thread.y + ((turn >> 1) & 1))
                : interleave == 2 ? ivec2(2 * thread.x + ((thread.y + turn) & 1), thread.y)
                : thread;
    if (any(greaterThanEqual(texel, ivec2(cb.projection.zw)))) return;
    vec4 input_ = imageLoad(inputImage, texel);
    float viewZ = input_.x;
    if (!(viewZ > 0.0)) {
        imageStore(outputImage, texel, vec4(cb.ao.w > 3.5 ? 0.0 : 1.0, 1.0, 0.0, 1.0));
        if (cb.gi3.z < 0.5) imageStore(giImage, texel, vec4(0.0, 0.0, 0.0, 1.0));   // (2026-10-31: else the radiance cache is bound there)
        if (cb.gi3.z > 0.5) { imageStore(curA, texel, vec4(0.0)); imageStore(curB, texel, vec4(0.0)); imageStore(giOut, texel, vec4(0.0)); }
        return;
    }
    vec2 uv = (vec2(texel) + 0.5) / cb.projection.zw;
    vec3 view = vec3((uv.x * 2.0 - 1.0) * cb.projection.x, (1.0 - uv.y * 2.0) * cb.projection.y, 1.0) * viewZ;
    vec3 p = (cb.viewToWorld * vec4(view, 0.0)).xyz;
    vec3 n = OctDecode(Unpack2(input_.y));
    // The start lifted off the surface: the depth (24 bits, half resolution) and the scene's triangles disagree more far away.
    float bias = 0.75 + viewZ * 0.003;
    // UNOFFICIAL 2026-11-07 (rtgap-tess, docs/next/RT-DETAIL-GAPS.md 1a) the tessellated bumps' Strength, faded out by view depth as they are
    // (RtContact.glsl rtTessSlack; core/RtTessContact.h): a point in a hollow of the depth buffer lies under the flat RT surface. The
    // constants are full: it rides in viewToWorld's 4th column (x Strength, y FadeStart, z FadeEnd; unused by the view's directions, w 0)
    const vec4 slackIn = cb.viewToWorld[3];
    const float slack = slackIn.x > 0.0 ? slackIn.x * (1.0 - smoothstep(slackIn.y, max(slackIn.z, slackIn.y + 1.0), viewZ)) : 0.0;

    // AO: closest hit; a hit counts in full to half the distance, nothing at the end (no hard edge). A back face right at the start is
    // a ray that began inside something (depth error, tessellated bumps the scene does not have): open, and counted for DebugView 3.
    float aoVisibility = 1.0, debugValue = 1.0;
    int rays = min(int(min(cb.ao.y, 64.0) + 0.5), 64);   // (ptaaa-hangfix: capped)
    if (rays > 0) {
        float frame = cb.ao.z > 0.5 ? cb.origin.w : 0.0;
        vec2 noise = SampleU(texel, frame, 0.0, 17.0, vec2(0.0), cb.ao.z > 1.5);   // (2026-11-09 rtgi-lock; ao.z 2 = SampleLockFix)
        vec3 start = p + n * (bias + slack);
        float reach = cb.ao.x, occlusion = 0.0, inside = 0.0, meanHit = 0.0;
        for (int i = 0; i < rays; i++) {
            vec3 d = CosineDirection(n, fract(noise + R2(float(i))));
            vec2 hit = Trace(start, d, 0.05 * bias, reach, false, int(cb.gi3.y + 0.5));
            if (hit.x < 0.0) { meanHit += 1.0; continue; }
            if (hit.y > 0.5 && hit.x < 4.0 * bias) { inside += 1.0; meanHit += 1.0; continue; }
            occlusion += 1.0 - smoothstep(0.5 * reach, reach, hit.x);
            meanHit += hit.x / reach;
        }
        aoVisibility = 1.0 - occlusion / float(rays);
        debugValue = inside > 0.0 ? 0.0 : 0.25 + 0.75 * meanHit / float(rays);
    }

    // Sky: fixed directions, straight up + one ring at 60 degrees up (8) and with 16 a ring at 30 (the ortho version's rings), each
    // weighed by its cosine to n; open if nothing within the distance. Turned by a 4 x 4 per-texel interleave that never changes with
    // the frame: nothing flickers when standing still.
    float skyVisibility = 1.0, covered = 0.0;
    // (2026-11-08 alsky) sky.y = the rays (0, 8 or 16) + 1000 x SkyBlocked's flags
    int skyCode = int(cb.sky.y + 0.5);
    int skyRays = skyCode % 1000;
    int skyFlags = skyCode / 1000;
    if (skyRays > 0) {
        vec3 start = p + n * (bias + max(8.0, slack));   // (2026-11-07: at least the bumps' slack)
        float reach = cb.sky.x;
        // (alsky) a back face this close to the start is the surface the ray began under (the AO rays' 4 x bias, from the lifted start)
        float insideReach = max(48.0, 4.0 * (bias + max(8.0, slack)));
        vec2 cell = vec2(texel & 3);
        float turn = (cell.x * 4.0 + cell.y) * (3.14159265 / 4.0 / 16.0);
        covered = SkyBlocked(start, vec3(0.0, 0.0, 1.0), reach, int(cb.gi3.y + 0.5), skyFlags, insideReach);
        float total = 0.034 * clamp(n.z, 0.0, 1.0);
        float open = total * (1.0 - covered);
        int rings = skyRays > 8 ? 2 : 1;
        for (int k = 0; k < rings; k++) {
            float c = k == 0 ? 0.5 : 0.8660254;     // cos(elevation): 60, then 30 degrees up
            float s = k == 0 ? 0.8660254 : 0.5;
            float ringWeight = k == 0 ? 0.0324 : 0.0884;
            for (int i = 0; i < 8; i++) {
                float a = turn + (float(i) + 0.5 * float(k)) * (3.14159265 / 4.0);
                vec3 d = vec3(cos(a) * c, sin(a) * c, s);
                float w = ringWeight * clamp(dot(d, n), 0.0, 1.0);
                if (w <= 0.0) continue;
                total += w;
                open += w * (1.0 - SkyBlocked(start, d, reach, 2, skyFlags, insideReach));   // (flags 0: open += w on a miss, as before)
            }
        }
        skyVisibility = total > 1.0e-5 ? open / total : 1.0;
    }
    // GI (rt-ao-gi): one bounce ray, its own rotation (the AO rays' noise turned by a golden-ratio step) so the two decorrelate.
    vec4 gi = vec4(0.0, 0.0, 0.0, 1.0);
    // (2026-10-29) GIInterleave: the GI rays only in every 2nd / 4th 8 x 8 tile of threads a frame, in turn (whole tiles, so the skipped
    // waves really do no GI work; per-texel skipping would leave GI lanes in every wave). The others keep their last bounce light (the
    // shared image persists) for the GI denoiser and ComputeGI's accumulate to blend. The AO and sky rays are not affected.
    int giInterleave = int(cb.gi3.x + 0.5);
    ivec2 tile = ivec2(gl_WorkGroupID.xy);
    bool giTile = giInterleave >= 4 ? ((tile.x & 1) + 2 * (tile.y & 1)) == (turn & 3)
                : giInterleave == 2 ? ((tile.x + tile.y + turn) & 1) == 0
                : true;
    if (cb.gi.y > 0.5 && cb.gi3.z > 0.5) {
        // (2026-10-30) GIReuse at full rate, in this pass: last frame's view from its matrix's rows, then the shared reuse step.
        vec3 a = p + vec3(cb.reuse.zw, cb.gi3.w);
        vec3 r0 = cb.prevRot.xyz, r1 = vec3(cb.prevRot.w, cb.reuse.xy), r2 = cross(r0, r1) * cb.sky.w;
        vec3 v = cb.sky.z > 0.5 ? vec3(dot(r0, a), dot(r1, a), dot(r2, a)) : vec3(0.0);
        // (2026-11-13 rtgi-review B3) reuse flag 16: GISamplePoints; last frame's view -> scene directions = its rows as columns
        if (((int(cb.sky.z + 0.5) / 4096) & 16) != 0) ReuseGIPoints(texel, p, n, viewZ, bias, true, v, cb.sky.z, a, mat3(r0, r1, r2));
        else ReuseGI(texel, p, n, viewZ, bias, true, v, cb.sky.z, a);
    }
    else if (cb.gi.y > 0.5 && !giTile) {
        // (no GI ray this frame here: the image keeps its last value)
    }
    else if (cb.gi.y > 0.5) {
        float frame = cb.ao.z > 0.5 ? cb.origin.w : 0.0;
        vec2 u = SampleU(texel, frame, 41.0, 73.0, vec2(0.381966, 0.5), cb.ao.z > 1.5);   // (2026-11-09 rtgi-lock; was the locked pair)
        gi = Bounce(p + n * bias, CosineDirection(n, u), 0.05 * bias, cb.ao.z > 1.5 ? Decide(texel, 97u, frame, 0.5497005) : fract(Ign(vec2(texel) + 97.0) + frame * 0.569840));
    }
    if ((cb.gi.y < 0.5 || giTile) && cb.gi3.z < 0.5) imageStore(giImage, texel, gi);
    if (cb.ao.w > 3.5 && cb.ao.w < 4.5) aoVisibility = clamp(viewZ / 2000.0, 0.0, 1.0);
    if (cb.ao.w > 4.5 && cb.ao.w < 5.5) aoVisibility = n.z * 0.5 + 0.5;
    // UNOFFICIAL 2026-11-09 (rtgi-lock) DebugView 8: the tangent frame the AO and GI rays' directions are built in (CosineDirection): white = the flat branch
    // (n.z >= 0.999: the azimuth is measured from +Y), grey 0.15 .. 0.85 = the tilted branch, the shade = the angle of its tangent cross(n, up). Two screen
    // regions of another shade are two tangent frames: where the GI's sample pattern runs half a turn out of step
    if (cb.ao.w > 7.5) {
        const bool tilted = abs(n.z) < 0.999;
        const vec3 tangent = normalize(tilted ? cross(n, vec3(0.0, 0.0, 1.0)) : cross(n, vec3(1.0, 0.0, 0.0)));
        aoVisibility = tilted ? 0.15 + 0.7 * (atan(tangent.y, tangent.x) * 0.15915494 + 0.5) : 1.0;
    }
    imageStore(outputImage, texel, vec4(aoVisibility, skyVisibility, covered, debugValue));
}
