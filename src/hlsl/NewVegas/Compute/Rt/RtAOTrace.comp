#else
// ---- (2026-10-31) RT_CACHE_PASS: the radiance cache's update (docs/next/FORK-RT-GAPS.md section 4) ----
// One thread a cell, 1 in cacheC.w of the grid's cells a frame (in turn). Each traces cacheC.x rays (a z-stratified sphere, turned per
// cell and frame) from its centre; a ray's light: a front face's Shade (direct light + the cache's own irradiance there: the
// recursion that adds a bounce a frame) or 0 (a miss: the sky is the game's ambient; a back face: the inside of something, counted).
// The cell's L1 coefficients blend into its history by 1 / M (M up to cacheC.y). A cell whose slot held another cell starts over.
void main() {
    int div = max(int(cb.cacheC.w + 0.5), 1);
    int cells = CacheGrid.x * CacheGrid.y * CacheGrid.z;
    int index = int(gl_WorkGroupID.x * 64u + gl_LocalInvocationIndex) * div + int(cb.cacheC.z + 0.5) % div;
    if (index >= cells) return;
    ivec3 half_ = CacheGrid / 2;
    ivec3 local = ivec3(index % CacheGrid.x, (index / CacheGrid.x) % CacheGrid.y, index / (CacheGrid.x * CacheGrid.y)) - half_;
    // UNOFFICIAL 2026-11-12 (sungi p3) cacheD.w = the level: 0 the fine grid, 1 the coarse one (CacheCascades 2; its own pass, its own turn)
    const int level = int(cb.cacheD.w + 0.5);
    const bool visibility = (CacheFlags() & 1) != 0;
    float size;
    vec3 cameraCell, offset;
    CacheLevel(level, size, cameraCell, offset);
    vec3 stamp;
    ivec2 t = CacheTexel(local, cameraCell, level, stamp);
    vec4 head = imageLoad(cacheImage, t + ivec2(3, 0));
    float hw = abs(head.w), m = floor(hw);
    bool same = cb.cacheC.y > 0.0 && m >= 1.0 && m <= 64.0 && !any(greaterThan(abs(head.xyz - stamp), vec3(0.25)));
    vec4 oldR = same ? imageLoad(cacheImage, t) : vec4(0.0);
    vec4 oldG = same ? imageLoad(cacheImage, t + ivec2(1, 0)) : vec4(0.0);
    vec4 oldB = same ? imageLoad(cacheImage, t + ivec2(2, 0)) : vec4(0.0);
    float oldInside = same ? (hw - m) / 0.9 : 0.0;
    // the distance moments' history (a new cell: nothing seen, 8 cell sizes away every way: visible from everywhere)
    vec4 oldM1 = vec4(8.0), oldM2 = vec4(64.0), oldMz = vec4(8.0, 8.0, 64.0, 64.0);
    if (same && visibility) {
        oldM1 = imageLoad(cacheImage, t + ivec2(4, 0));
        oldM2 = imageLoad(cacheImage, t + ivec2(5, 0));
        oldMz = imageLoad(cacheImage, t + ivec2(6, 0));
        if (any(isnan(oldM1)) || any(isnan(oldM2)) || any(isnan(oldMz)) || any(isinf(oldM1)) || any(isinf(oldM2)) || any(isinf(oldMz))) {
            oldM1 = vec4(8.0); oldM2 = vec4(64.0); oldMz = vec4(8.0, 8.0, 64.0, 64.0);
        }
    }
    if (any(isnan(oldR)) || any(isnan(oldG)) || any(isnan(oldB)) || any(isinf(oldR)) || any(isinf(oldG)) || any(isinf(oldB))) {
        same = false; oldR = oldG = oldB = vec4(0.0); oldInside = 0.0;
