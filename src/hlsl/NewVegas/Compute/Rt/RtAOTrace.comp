    if (!same) m = 0.0;
    // (2026-10-31 b) Lazy cells: settled (full history), and far from every surface (no lookup reaches them: outdoors, the air above) or
    // mostly inside something (lookups weigh them out): traced 1 visit in cacheD.y, so the rays go where the light is read.
    if (cb.cacheC.y > 0.0 && same && m >= cb.cacheC.y && (head.w < 0.0 || oldInside > 0.4) &&
        (int(cb.cacheD.x + 0.5) + index) % max(int(cb.cacheD.y + 0.5), 1) != 0) return;

    vec3 centre = (vec3(local) + 0.5) * size - offset;   // scene space
    int rays = clamp(int(cb.cacheC.x + 0.5), 1, 32);
    float frame = cb.origin.w;
    vec2 turn = fract(vec2(Ign(vec2(index & 255, index >> 8) + 13.0 + 41.0 * float(level)), Ign(vec2(index >> 8, index & 255) + 29.0)) + frame * vec2(0.618034, 0.754878));
    vec4 r = vec4(0.0), g = vec4(0.0), b = vec4(0.0);
    float inside = 0.0, nearest = 1.0e30;
    // UNOFFICIAL 2026-11-12 (sungi p3, F8) per axis bin (+x -x +y -y +z -z): the rays' weights and the weighed distance and its square (cell sizes)
    float binW[6], binD[6], binD2[6];
    for (int k = 0; k < 6; k++) { binW[k] = 0.0; binD[k] = 0.0; binD2[k] = 0.0; }
    const bool skyMisses = cb.gi.y > 5.0;   // SkyMissSH (gi.y + 10): a ray that finds nothing brings the sky's radiance in its direction
    for (int i = 0; i < rays; i++) {
        float z = 1.0 - 2.0 * fract((float(i) + turn.x) / float(rays));
        float phi = 6.2831853 * fract(float(i) * 0.618034 + turn.y);
        float s = sqrt(max(1.0 - z * z, 0.0));
        vec3 d = vec3(s * cos(phi), s * sin(phi), z);
        rayQueryEXT q;
        rayQueryInitializeEXT(q, scene, 0u, RT_CULL, centre + cb.origin.xyz, 0.0, d, cb.gi.x);
        Proceed(q);
        const bool found = rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT;
        if (visibility) {   // a miss counts as 8 cell sizes
            const float dn = found ? min(rayQueryGetIntersectionTEXT(q, true) / size, 8.0) : 8.0;
            const vec3 wd = d * d;
            const int bx = d.x >= 0.0 ? 0 : 1, by = d.y >= 0.0 ? 2 : 3, bz = d.z >= 0.0 ? 4 : 5;
            binW[bx] += wd.x; binD[bx] += wd.x * dn; binD2[bx] += wd.x * dn * dn;
            binW[by] += wd.y; binD[by] += wd.y * dn; binD2[by] += wd.y * dn * dn;
            binW[bz] += wd.z; binD[bz] += wd.z * dn; binD2[bz] += wd.z * dn * dn;
        }
        if (!found) {
            if (skyMisses) {
                vec3 sky = SkyMiss(d);
                r += sky.r * vec4(1.0, d);
                g += sky.g * vec4(1.0, d);
                b += sky.b * vec4(1.0, d);
            }
            continue;
        }
        float th = rayQueryGetIntersectionTEXT(q, true);
        nearest = min(nearest, th);
        if (!rayQueryGetIntersectionFrontFaceEXT(q, true)) { inside += 1.0; continue; }
        uint instance = rayQueryGetIntersectionInstanceIdEXT(q, true), prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, true));
        vec3 n = HitNormal(instance, prim, rayQueryGetIntersectionObjectToWorldEXT(q, true), d);
        const vec2 bary = rayQueryGetIntersectionBarycentricsEXT(q, true);
        rtConeWidth = HitCone(th);   // (2026-11-13 R19; Shade puts it back to 0 before its shadow rays and the next ray)
        vec3 light = Shade(instance, prim, bary, centre + d * th, n, ShadingNormal(instance, prim, bary, n, rayQueryGetIntersectionObjectToWorldEXT(q, true), d), th,
                           fract(Ign(vec2(index & 255, index >> 8) + 97.0 + float(i)) + frame * 0.569840));
        r += light.r * vec4(1.0, d);
        g += light.g * vec4(1.0, d);
        b += light.b * vec4(1.0, d);
    }
    float scale = 1.0 / float(rays);
    float cap = max(abs(cb.cacheC.y), 1.0);
    float alpha = 1.0 / min(m + 1.0, cap);
    m = min(m + 1.0, cap);
    float insideNew = clamp(mix(oldInside, inside * scale, alpha), 0.0, 1.0);
    imageStore(cacheImage, t, mix(oldR, r * scale, alpha));
    imageStore(cacheImage, t + ivec2(1, 0), mix(oldG, g * scale, alpha));
    imageStore(cacheImage, t + ivec2(2, 0), mix(oldB, b * scale, alpha));
    bool far = nearest > cb.cacheD.z * size;   // (from this visit's rays: a near surface they missed makes it lazy for a while, no more)
    if (visibility) {
        // UNOFFICIAL 2026-11-12 (sungi p3, F8) the distance moments (layout above CacheTexel): a bin this visit's rays barely touched (weight
        // under 0.02) keeps its history, and a thin one blends in by its weight (1.5 x, at most 1): few rays leave some bins empty
        float m1[6], m2[6];
        const float oldD[6] = float[6](oldM1.x, oldM1.y, oldM1.z, oldM1.w, oldMz.x, oldMz.y);
        const float oldD2[6] = float[6](oldM2.x, oldM2.y, oldM2.z, oldM2.w, oldMz.z, oldMz.w);
        for (int k = 0; k < 6; k++) {
            const float w = binW[k];
            const float a = w > 0.02 ? alpha * min(1.0, 1.5 * w) : 0.0;
            m1[k] = mix(oldD[k], w > 0.02 ? binD[k] / w : oldD[k], a);
            m2[k] = mix(oldD2[k], w > 0.02 ? binD2[k] / w : oldD2[k], a);
        }
        imageStore(cacheImage, t + ivec2(4, 0), vec4(m1[0], m1[1], m1[2], m1[3]));
        imageStore(cacheImage, t + ivec2(5, 0), vec4(m2[0], m2[1], m2[2], m2[3]));
        imageStore(cacheImage, t + ivec2(6, 0), vec4(m1[4], m1[5], m2[4], m2[5]));
    }
    imageStore(cacheImage, t + ivec2(3, 0), vec4(stamp, (far ? -1.0 : 1.0) * (m + 0.9 * insideNew)));
}
#endif
