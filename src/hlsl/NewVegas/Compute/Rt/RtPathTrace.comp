		if (view == 4) return vec3(surf.rough, surf.metal, 0.0);
#ifndef PT_RESTIR_GI
		// (2026-11-07) PTDebugView 10: the radiance cache's light at the first hit (0 where it has no cell yet)
		if (view == 10) { vec3 cl; return CacheOn() && CacheRead(hit, n, cl) ? cl : vec3(0.0); }
#endif
		// UNOFFICIAL 2026-11-03 (rtgi-cal) PTDebugView 5: the first hit's ARRIVING indirect light, as RT GI's bounce returns it (a cosine
		// ray, the hit's albedo x what lights it, no first surface colour): no direct light at the first hit, a diffuse cosine ray with
		// throughput 1 from it; deeper hits as the picture (PTBounces 1 = one bounce, PTSky 0 = RT GI's misses)
		const bool arriving = view == 5 && bounce == 0;
		// (2026-11-03 rtspec) PTDebugView 8: the first hit's direct light through the GGX lobe alone; 9: none of it, and the first ray
		// from it drawn from the GGX lobe alone (weight = the specular BRDF x cos / its pdf), deeper hits as the picture
		const bool reflection = view == 9 && bounce == 0;
		gSpecOnly = view == 8 && bounce == 0;
		bool cached = false;   // (2026-11-07) PTRadianceCache: the last hit's further bounces came from the cache
#ifndef PT_RESTIR_GI
		if (cache && bounce > 0 && (bounce == bounces || cacheShort)) { vec3 cl; if (CacheRead(hit, n, cl)) { radiance += Indirect(throughput * cl); cached = true; cacheEnd = bounce < bounces; } }
#endif
		bool emRestir = false;
		if (!arriving && !reflection) {
#ifndef PT_RESTIR_GI
			gRestirFirst = bounce == 0 && (view == 0 || view == 3) && RestirDI() && !ownFlash;   // (2026-11-07) PTRestirDI at the first hit
			emRestir = gRestirFirst;
			// (ptaaa-emissive) the emissive light sample is MIS-weighted only where a bounce ray leaves this hit (or the cache stands for it)
			gEmMis = (bounce < bounces && view != 3 && view != 8) || cached;
#endif
			gBounce = bounce;   // (perf-ptcost: PTBounceLights)
			gFlashOnly = ownFlash;   // (2026-11-13 PTFlashOwnPixels)
			const vec3 lit = DirectSides(hit, n, t, v, surf);   // (2026-11-07 ptaaa-materials: Direct + the light from behind, one call site)
			gFlashOnly = false;
#ifndef PT_RESTIR_GI
			gRestirFirst = false;
#endif
			radiance += bounce > 0 ? Indirect(throughput * lit) : throughput * lit;
			if (ownFlash) break;   // (the game's pixel + the flashlight: nothing else of this hit, no bounce)
			// (2026-11-06, section 44) PTLastBounce (flag 65536): the path ends here (PTRealtime: 1 bounce), so the light of further bounces is
			// missing (~3 % of the picture indoors and out once textured meshes kept their colour, section 43). Estimated as if this hit's
			// surroundings were lit as it is: its albedo x its own direct light x 0.75 (replays against 4-bounce means: brightness 0.994 /
			// 0.996, tiles p5 0.89 .. p95 1.05; x 1 overshot near lamps, worst tile 1.17). No rays.
			if (bounce == bounces && bounce > 0 && (uint(p.accum.w) & 65536u) != 0u && view == 0 && !cached)
				radiance += Indirect(throughput * surf.albedo * lit * 0.75);
		}
		else {
			gGlowTotal = 0.0;
#ifndef PT_RESTIR_GI
			gEmTotal = 0.0;
#endif
		}
		gSpecOnly = false;
		// (2026-11-06, section 39) PTLastSky (flag 32768): the path ends here (PTRealtime traces 1 bounce), so this hit lacks the light of
		// further bounces; outdoors most of it is the sky's. Add it as if one more diffuse bounce ray (cosine-weighted, unoccluded) left to
		// the sky: albedo x Sky(l). Overestimates where something covers this hit; indoors Sky() is the interior ambient (PTAmbient, 0).
		if (bounce == bounces && bounce > 0 && (uint(p.accum.w) & 32768u) != 0u && view == 0 && p.skyZenith.w > 0.5 && !cached)
			radiance += Indirect(throughput * surf.albedo * Sky(CosineDirection(n, vec2(Rand(), Rand()))));
#ifndef PT_RESTIR_GI
		if (cache && bounce < bounces && !cacheEnd && cvCount < kCacheVerts) {
			const vec3 tCl = min(max(throughput, vec3(0.0)), vec3(65504.0)), rCl = min(max(radiance, vec3(0.0)), vec3(65504.0));
			cvHit[cvCount] = hit;
			cvN[cvCount] = packSnorm2x16(OctEncode(gGeoSplit ? gGeoN : n));
			cvTR[cvCount] = uvec3(packHalf2x16(tCl.xy), packHalf2x16(rCl.xy), packHalf2x16(vec2(tCl.z, rCl.z)));
			cvCount++;
		}
#endif
		if (bounce == 0) { gSplitTake = false; gSplitRad0 = radiance; }   // (ptaaa-denoiser) the first hit's own light ends here
#ifdef PT_SPLIT_PRIMARY
		{
			const uint at = PayloadWord(gPixel);
			const vec3 rCl = min(max(radiance, vec3(0.0)), vec3(65504.0));
			const vec3 sCl = min(max(gSplitSpec, vec3(0.0)), vec3(65504.0));
			scratch.words[at + 0u] = floatBitsToUint(hit.x);
			scratch.words[at + 1u] = floatBitsToUint(hit.y);
			scratch.words[at + 2u] = floatBitsToUint(hit.z);
			scratch.words[at + 3u] = floatBitsToUint(t);
			scratch.words[at + 4u] = packSnorm2x16(OctEncode(n));
			scratch.words[at + 5u] = packSnorm2x16(OctEncode(gGeoSplit ? gGeoN : n));
			scratch.words[at + 6u] = packHalf2x16(rCl.rg);
			scratch.words[at + 7u] = packHalf2x16(vec2(rCl.b, sCl.r));
			scratch.words[at + 8u] = packHalf2x16(sCl.gb);
			scratch.words[at + 9u] = packHalf2x16(surf.albedo.rg);
			scratch.words[at + 10u] = packHalf2x16(vec2(surf.albedo.b, surf.rough));
			scratch.words[at + 11u] = packHalf2x16(vec2(surf.metal, surf.f0));
			scratch.words[at + 12u] = packHalf2x16(gFirstAlbedo.rg);
			scratch.words[at + 13u] = packHalf2x16(vec2(gFirstAlbedo.b, gFirstRough));
			scratch.words[at + 14u] = packHalf2x16(vec2(min(max(gGlowTotal, 0.0), 65504.0), min(max(gEmTotal, 0.0), 65504.0)));
			uint fl = (surf.kind & 7u) | kSplitFlagHasSurface | (bounces > 0 ? kSplitFlagDoBounce : 0u);
			if (gGeoSplit) fl |= kSplitFlagGeoSplit;
			if (gFirstBump) fl |= kSplitFlagFirstBump;
			if (gContact) fl |= kSplitFlagContact;
			if (gFirstGlowMark) fl |= kSplitFlagGlowMark;
			if (paneShare > 0.0) fl |= kSplitFlagPane;
			if (gSplitVisChecked) fl |= kSplitFlagVisChecked;
			if (viewModel) fl |= kSplitFlagViewModel;
			if (emRestir) fl |= kSplitFlagEmRestir;
			if (gFirstActorShadow) fl |= kSplitFlagActorShadow;
			fl |= (PackVisTint(gSplitVisTint) << 13u);
			fl |= (min(gRayCount, 63u) << 25u);
			scratch.words[at + 15u] = fl;
			gSplitWrotePayload = true;
			break;
		}
#endif
		if (bounce == bounces || cacheEnd || view == 3 || view == 8) break;
		vec3 l, w;
		float pdf;
		if (arriving) { l = CosineDirection(n, vec2(Rand(), Rand())); w = vec3(1.0); pdf = max(dot(n, l), 0.0) / 3.14159265; }
		else if (reflection) {
			if (!Specular()) break;
			float a = max(surf.rough * surf.rough, 0.002), a2 = a * a;
			float u = Rand(), phi = 6.2831853 * Rand();
			float cosT = sqrt((1.0 - u) / (1.0 + (a2 - 1.0) * u)), sinT = sqrt(max(1.0 - cosT * cosT, 0.0));
			vec3 b, tg = Basis(n, b);
			vec3 h = normalize(tg * (sinT * cos(phi)) + b * (sinT * sin(phi)) + n * cosT);
			l = reflect(-v, h);
			float nl = dot(n, l);
			if (nl <= 0.0) break;
			float nh = max(dot(n, h), 0.0), vh = max(dot(v, h), 1.0e-4);
			pdf = GgxD(nh, a2) * nh / (4.0 * vh);
			gSpecOnly = true;
			w = BrdfPi(surf, n, v, l) * (nl / (3.14159265 * max(pdf, 1.0e-6)));
			gSpecOnly = false;
		}
#ifdef PT_RESTIR_GI
		// (2026-11-04 d) the first bounce: the glossy lobe with its usual chance (traced on here, its light stays in the rest, not reused),
		// else a cosine sample for ReSTIR GI (source density (1 - share) x cos / pi; the reuse applies the diffuse part of the BRDF), and
		// from there the path gathers only what arrives along it
		else if (bounce == 0 && view == 0 && surf.kind != kKindGlass) {   // (2026-11-07 ptaaa: a pane goes on as a pane, below)
			const float share = Specular() ? SpecularShare(surf) : 0.0;
			gGISurface = true; gGIT1 = t; gGIN1 = n; gGIShare = share; gGIMetal = Specular() ? surf.metal : 0.0;
			if (Rand() < share) {
				// UNOFFICIAL 2026-11-19: use VNDF sampling (matching NextDirectionReflect) instead of raw GGX NDF for lower grazing variance
				const float a = max(surf.rough * surf.rough, 0.002), a2 = a * a;
				const vec3 h = SampleVndf(n, v, a, vec2(Rand(), Rand()));
				l = reflect(-v, h);
				const float nl = dot(n, l);
				if (nl <= 0.0) break;
				const float nh = max(dot(n, h), 0.0), nv = max(dot(n, v), 1.0e-4);
				const float pdfG = GgxD(nh, a2) * SmithG1(nv, a2) / (4.0 * nv);
				gSpecOnly = true;
				w = BrdfPi(surf, n, v, l) * (nl / (3.14159265 * max(share * pdfG, 1.0e-6)));
				gSpecOnly = false;
				pdf = share * pdfG;
			}
			else {
				l = CosineDirection(n, vec2(Rand(), Rand()));
				w = vec3(1.0);
				pdf = (1.0 - share) * max(dot(n, l), 0.0) / 3.14159265;
				gGIFirst = true; gGIDir = l; gGIDirect = radiance;
				radiance = vec3(0.0);
			}
		}
#endif
		else if (!NextDirection(n, v, surf, l, w, pdf)) break;
		// (2026-11-12 ptbump) a direction drawn round the bumped normal that leaves on the other side of the smooth surface than its lobe
		// (a reflection under it, a transmission above it): the path ends here (no ray through the surface: no light leak)
		if (gGeoSplit && (dot(l, n) < 0.0) != (dot(l, gGeoN) < 0.0)) break;
		// (2026-11-06, section 35) PTBounceHalf (flag 16384): the bounce traced for half the pixels a frame, whole 8 x 8 tiles in a checkerboard
		// that swaps every frame (whole waves skip: no divergence), the traced pixels' indirect light x 2 (unbiased; the denoiser's history
		// fills the rest). Replays: -34 % of the pass, the mean unchanged, +10 % noise a frame.
		if (bounce == 0 && (uint(p.accum.w) & 16384u) != 0u) {
			if ((((gPixel.x >> 3) + (gPixel.y >> 3) + int(uint(p.origin.w))) & 1) != 0) break;
			throughput *= 2.0;
		}
		// (ptaaa-denoiser) the bounce goes on: its direction's specular share (NextDirection's BrdfPi was the last; for glass and a leaf's
		// transmission NextDirection sets it: glass all specular, the leaf all diffuse), a miss unless it hits
		// UNOFFICIAL 2026-11-19: compute SpecLobeChance once instead of twice back-to-back
		const float lobeChance = ((bounce == 0 && Split()) || gBounceRoughen > 0.0) ? SpecLobeChance(n, v, surf, l) : 0.0;
		if (bounce == 0) { gSplitRatio = SpecShare(); gSplitHitT = 60000.0; gSplitSpecLobe = Split() ? lobeChance : 0.0; }
		// (2026-11-09 PTBounceRoughen) how rough this bounce was: the surface's roughness by the chance its direction was the glossy lobe's,
		// 1 (matte) by the rest
		if (gBounceRoughen > 0.0) pathRough = max(pathRough, mix(1.0, surf.rough, clamp(lobeChance, 0.0, 1.0)));
		// (2026-11-07 ptaaa-materials) through glass or a leaf: the next ray leaves from the far side's face (and no glow light sample was taken
		// there: a glow met along it keeps its full weight)
		if (dot(l, n) < 0.0) { n = -n; gGlowTotal = 0.0; }
		prevHit = hit; prevN = n; prevPdf = pdf; prevGlowTotal = gGlowTotal;
#ifndef PT_RESTIR_GI
		prevEmTotal = gEmTotal; prevEmSelect = gEmSelect; prevEmRestir = emRestir;
#endif
		throughput *= w;
		if (bounce >= (gRouletteFrom > 0.5 ? 1 : 2)) {   // Russian roulette: keep the path in proportion to what it still carries
			// (2026-11-10 PTRouletteFrom: already before the SECOND bounce ray, there kept at least 1 time in 4; the first bounce ray is always traced)
			float keep = clamp(max(throughput.r, max(throughput.g, throughput.b)), bounce < 2 ? 0.25 : 0.05, 0.95);
			if (Rand() >= keep) break;
			throughput /= keep;
		}
		pos = hit + (gGeoSplit ? (dot(l, gGeoN) < 0.0 ? -gGeoN : gGeoN) : n) * (1.0 + 0.002 * t);   // (ptbump: off the smooth surface)
		dir = l;
	}
#if !defined(PT_RESTIR_GI) && !defined(PT_SPLIT_PRIMARY)
	// (2026-11-07) PTRadianceCache: each vertex that went on gets what came back through it (its outgoing indirect light)
	// UNOFFICIAL 2026-11-19: subsample bounce-0 writes 1-in-4 pixels (SHaRC style) to slash L2 atomic contention on primary hits.
	const bool writeBounce0 = ((uint(gPixel.x) ^ (uint(gPixel.y) << 1u) ^ uint(p.origin.w)) & 3u) == 0u;
	for (int i = 0; i < cvCount; i++) {
		if (i == 0 && !writeBounce0) continue;
		const vec2 txy = unpackHalf2x16(cvTR[i].x), rxy = unpackHalf2x16(cvTR[i].y), trz = unpackHalf2x16(cvTR[i].z);
		const vec3 T = vec3(txy, trz.x), R = vec3(rxy, trz.y);
		const vec3 rest = radiance - R + (i == 0 ? cacheFirstGlow : vec3(0.0));   // (ptaaa-emissive: the first vertex's glow share)
		CacheAdd(cvHit[i], OctDecode(unpackSnorm2x16(cvN[i])), max(vec3(T.x > 1.0e-4 ? rest.x / T.x : 0.0, T.y > 1.0e-4 ? rest.y / T.y : 0.0, T.z > 1.0e-4 ? rest.z / T.z : 0.0), vec3(0.0)));
	}
#endif
	return radiance;
}
#endif   // !PT_SPLIT_SPATIAL && !PT_SPLIT_BOUNCE

#ifdef PT_SPLIT_SPATIAL
// UNOFFICIAL 2026-11-19 (Phase 3B Pass 2): Uniform 8x8 spatial ReSTIR DI pass reading THIS frame's intermediate temporal
// reservoirs (TempResWord), running an RTXDI shared-memory boiling filter (0 global reads), CGNS + streaming pairwise MIS,
// final visibility ray, and storing final reservoirs into FrameParity() + adding DI radiance into the Primary Payload.
shared float sTileW[64];
shared uint  sTileCount[64];

void RunSplitSpatial(ivec2 pixel) {
	const uint lid = gl_LocalInvocationIndex;
	const bool inBounds = pixel.x < int(p.size.x) && pixel.y < int(p.size.y);
	sTileW[lid] = 0.0;
	sTileCount[lid] = 0u;

	uint head0 = 0u;
	LSample y = NoSample();
	float W = 0.0, M = 0.0, yTarget = 0.0, t = 0.0;
	vec3 yLight = vec3(0.0), yPos = vec3(0.0);
	vec3 hit = vec3(0.0), n = vec3(0.0, 0.0, 1.0), geoN = vec3(0.0, 0.0, 1.0), v = vec3(0.0, 0.0, 1.0);
	Surface surf = HitSurface(vec3(1.0));
	uint fl = 0u;
	uint pAt = 0u;
	float maxM = 20.0;
	bool activePx = false;

	if (inBounds) {
		state = uint(pixel.x) * 1973u + uint(pixel.y) * 9277u + uint(p.origin.w) * 26699u;
		LoadMatKeys();
		LoadBounceRoughen();
		LoadCostKeys();
		LoadEmCostKeys();
		LoadScratchLayout();
		Pcg();
		gPixel = pixel;
		const vec2 camUV = CameraUV(pixel, vec2(Rand(), Rand()));
		const vec3 camDir = normalize(p.forward.xyz + p.right.xyz * (2.0 * camUV.x - 1.0) - p.up.xyz * (2.0 * camUV.y - 1.0));
		state ^= 0x6C8E9CF5u; Pcg();   // decorrelate spatial RNG from Pass 1

		if (gScratchSplit && gScratchRestir) {
			const uint tw = TempResWord(pixel);
			head0 = scratch.words[tw];
			if (head0 != 0u) {
				maxM = FrameTexel(10).x;
				pAt = PayloadWord(pixel);
				fl = scratch.words[pAt + 15u];
				hit = vec3(uintBitsToFloat(scratch.words[pAt + 0u]), uintBitsToFloat(scratch.words[pAt + 1u]), uintBitsToFloat(scratch.words[pAt + 2u]));
				t = uintBitsToFloat(scratch.words[pAt + 3u]);
				n = OctDecode(unpackSnorm2x16(scratch.words[pAt + 4u]));
				geoN = OctDecode(unpackSnorm2x16(scratch.words[pAt + 5u]));
				const vec2 aRG = unpackHalf2x16(scratch.words[pAt + 9u]);
				const vec2 aBR = unpackHalf2x16(scratch.words[pAt + 10u]);
				const vec2 mF0 = unpackHalf2x16(scratch.words[pAt + 11u]);
				surf.albedo = vec3(aRG, aBR.x);
				surf.rough = aBR.y;
				surf.metal = mF0.x;
				surf.f0 = mF0.y;
				surf.kind = fl & 7u;
				v = (fl & kSplitFlagViewModel) != 0u ? -normalize(hit) : -camDir;
				M = min(float(head0 >> 16), maxM);
				W = uintBitsToFloat(scratch.words[tw + 1u]);
				if (!(W > 0.0) || !(W < 3.0e38)) W = 0.0;
				y = W > 0.0 ? CurSample(head0 & 0xFFFFu, scratch.words[tw + 4u], unpackUnorm2x16(scratch.words[tw + 5u])) : NoSample();
				if (Valid(y) && LightAt(y, hit, n, yLight, yPos)) {
					yTarget = RestirTarget(yLight, yPos, hit, surf, n, v);
					if (!(yTarget > 0.0)) { y = NoSample(); W = 0.0; }
				} else { y = NoSample(); W = 0.0; }
				activePx = true;
				const float est = Valid(y) && W > 0.0 ? W * yTarget : 0.0;
				if (est > 0.0 && est < 3.0e38) { sTileW[lid] = est; sTileCount[lid] = 1u; }
			}
		}
	}

	// Uniform 8x8 shared-memory boiling filter (all 64 lanes participate in barriers)
	barrier();
	for (uint stride = 32u; stride > 0u; stride >>= 1u) {
		if (lid < stride) {
			sTileW[lid] += sTileW[lid + stride];
			sTileCount[lid] += sTileCount[lid + stride];
		}
		barrier();
	}
	if (!inBounds || !gScratchSplit || !gScratchRestir) return;
	if (!activePx) { ClearReservoir(); return; }

	const float tileMean = sTileCount[0] >= 16u ? sTileW[0] / float(sTileCount[0]) : 0.0;
	bool yVisChecked = (fl & kSplitFlagVisChecked) != 0u && Valid(y);
	vec3 yVisTint = yVisChecked ? UnpackVisTint(fl >> 13u) : vec3(1.0);
	if (tileMean > 0.0 && Valid(y) && W * yTarget > 16.0 * tileMean) {
		y = NoSample(); W = 0.0; yTarget = 0.0; M = min(M, 1.0); yVisChecked = false;
	}

	const bool geoSplit = (fl & kSplitFlagGeoSplit) != 0u;
	const vec3 lift = hit + (geoSplit ? (dot(geoN, n) < 0.0 ? -geoN : geoN) : n) * (1.0 + 0.002 * t);
	const int raysMode = RestirRaysMode();
	const bool rtxdi2Ray = raysMode == 4;
	gRestirVis = raysMode != 2 && !rtxdi2Ray;

	// Spatial pairwise MIS reading THIS frame's intermediate temporal reservoirs (0-frame lag!)
	const vec2 sp = FrameTexel(10), sr = FrameTexel(11), sq = FrameTexel(12);
	const int spWant = min(int(sp.y + 0.5), kRestirNeighbours);
	if (spWant > 0) {
		const vec3 here = hit + p.origin.xyz;
		const float dist = max(length(hit), 1.0e-3);
		const vec2 at = vec2(pixel) + 0.5;
		const int cgnsK = RestirCgnsK();
		ivec2 cgnsPx[kRestirNeighbours];
		int spCount = spWant;
		if (cgnsK > 0) spCount = RestirCgnsPick(at, here, n, dist, sr.x, sr.y, sq.x * dist, spWant, cgnsK, p.origin.xyz, p.forward.xyz, p.right.xyz, p.up.xyz, cgnsPx);

		int nb = 0;
		const float Mc = M;
		float sumM = M, mcSum = 0.0, nbSum = 0.0;
		const float qcy = Valid(y) ? LightLuma(y, hit, n) : 0.0;
		LSample nbY = NoSample();
		float nbYTarget = 0.0;
		vec3 nbYLight = vec3(0.0), nbYPos = vec3(0.0);

		for (int i = 0; i < spCount; i++) {
			vec2 q = at;
			if (cgnsK > 0) q = vec2(cgnsPx[i]) + 0.5;
			else { const float r = sr.x * sqrt(Rand()), a = 6.2831853 * Rand(); q += r * vec2(cos(a), sin(a)); }
			const ivec2 px = ivec2(floor(q));
			if (px == pixel || any(lessThan(px, ivec2(0))) || any(greaterThanEqual(px, ivec2(p.size.xy)))) continue;
			const uint w = TempResWord(px);
			const uint head = scratch.words[w];
			if (head == 0u) continue;
			const float oldW = uintBitsToFloat(scratch.words[w + 1u]), oldDist = uintBitsToFloat(scratch.words[w + 2u]);
			const vec3 oldN = OctDecode(unpackSnorm2x16(scratch.words[w + 3u]));
			if (dot(oldN, n) < sr.y) continue;
			const vec2 ouv = (vec2(px) + 0.5) * p.size.zw;
			const vec3 oldPoint = p.origin.xyz + normalize(p.forward.xyz + p.right.xyz * (2.0 * ouv.x - 1.0) - p.up.xyz * (2.0 * ouv.y - 1.0)) * oldDist;
			if (abs(dot(oldPoint - here, n)) > sq.x * dist) continue;
			const float oldM = min(float(head >> 16), maxM);
			if (!(oldM > 0.0)) continue;
			LSample old = CurSample(head & 0xFFFFu, scratch.words[w + 4u], unpackUnorm2x16(scratch.words[w + 5u]));
			if (!(oldW > 0.0) || !(oldW < 3.0e38)) old = NoSample();
			const vec3 src = oldPoint - p.origin.xyz;
			nb++;
			sumM += oldM;
			if (Valid(y)) {
				gRestirVis = raysMode <= 1;
				const float qiy = Same(old, y) || LightVisibleFrom(y, src, oldN) ? LightLuma(y, src, oldN) : 0.0;
				gRestirVis = raysMode != 2 && !rtxdi2Ray;
				mcSum += Mc * qcy / max(Mc * qcy + oldM * qiy, 1.0e-30);
			}
			if (!Valid(old)) continue;
			vec3 light, pos;
			if (!LightAt(old, hit, n, light, pos)) continue;
			const float tt = RestirTarget(light, pos, hit, surf, n, v);
			if (!(tt > 0.0) || !(Same(old, y) || LightVisibleFrom(old, hit, n))) continue;
			const float qii = LightLuma(old, src, oldN);
			const float qci = dot(light, vec3(0.2126, 0.7152, 0.0722));
			const float wi = (oldM * qii / max(oldM * qii + Mc * qci, 1.0e-30)) * tt * oldW;
			if (wi > 0.0) {
				nbSum += wi;
				if (Rand() * nbSum < wi) { nbY = old; nbYTarget = tt; nbYLight = light; nbYPos = pos; }
			}
		}
		if (nb > 0) {
			const float cWeight = Valid(y) ? mcSum * yTarget * W : 0.0;
			const float totalSum = cWeight + nbSum;
			if (nbSum > 0.0 && Rand() * totalSum < nbSum) {
				if (!Same(nbY, y)) yVisChecked = false;
				y = nbY; yTarget = nbYTarget; yLight = nbYLight; yPos = nbYPos;
			}
			W = Valid(y) && yTarget > 0.0 ? (totalSum / float(nb)) / yTarget : 0.0;
			M = sumM;
		}
	}

	if (!(W < 3.0e38)) W = 0.0;
	vec3 tint = yVisChecked ? yVisTint : vec3(1.0);
	float storeW = W;
	bool seen = true;
	bool actorShadowSpatial = false;
	if (!gRestirVis && !yVisChecked && Valid(y) && W > 0.0) {
		const vec3 l = yPos - lift;
		const float ldist = length(l);
		seen = ldist > 1.0e-4 && Visible(lift, l / ldist, LightGap(y, ldist));
		tint = gShadowTint;
		if (!seen) {
			if (ldist > 1.0e-4 && (gShadowHitCustom & NVR_RT_CUSTOM_ACTOR) != 0u) actorShadowSpatial = true;
			storeW = 0.0; M = min(M, 1.0);
		}
	}
	gRestirVis = true;
	const vec2 cuv = (vec2(pixel) + 0.5) * p.size.zw;
	const vec3 centre = normalize(p.forward.xyz + p.right.xyz * (2.0 * cuv.x - 1.0) - p.up.xyz * (2.0 * cuv.y - 1.0));
	const float facing = dot(centre, n);
	StoreReservoir(y, min(M, maxM), storeW, abs(facing) > 0.05 ? dot(hit, n) / facing : length(hit), n);

	if (Valid(y) && W > 0.0 && seen) {
		gContact = (fl & kSplitFlagContact) != 0u;
		if (gContact) { gContactFrom = hit; gContactN = geoN; gContactZ = dot(hit, p.forward.xyz); gContactNoise = Rand(); }
		const vec3 diLit = yLight * W * BrdfPi(surf, n, v, normalize(yPos - hit)) * tint *
			(gContact ? PtContact(normalize(yPos - gContactFrom), length(yPos - gContactFrom)) : 1.0);
		const vec2 rRG = unpackHalf2x16(scratch.words[pAt + 6u]);
		const vec2 rBS = unpackHalf2x16(scratch.words[pAt + 7u]);
		const vec2 sGB = unpackHalf2x16(scratch.words[pAt + 8u]);
		vec3 rad0 = vec3(rRG, rBS.x) + diLit;
		vec3 spec0 = vec3(rBS.y, sGB) + (Split() ? diLit * SpecShare() : vec3(0.0));
		rad0 = min(max(rad0, vec3(0.0)), vec3(65504.0));
		spec0 = min(max(spec0, vec3(0.0)), vec3(65504.0));
		scratch.words[pAt + 6u] = packHalf2x16(rad0.rg);
		scratch.words[pAt + 7u] = packHalf2x16(vec2(rad0.b, spec0.r));
		scratch.words[pAt + 8u] = packHalf2x16(spec0.gb);
	}
	if (actorShadowSpatial || gCountRays) {
		uint outFl = fl | (actorShadowSpatial ? kSplitFlagActorShadow : 0u);
		if (gCountRays) {
			const uint prevRays = (outFl >> 25u) & 63u;
			outFl = (outFl & ~(63u << 25u)) | (min(prevRays + gRayCount, 63u) << 25u);
		}
		scratch.words[pAt + 15u] = outFl;
	}
}
#endif   // PT_SPLIT_SPATIAL

#ifdef PT_SPLIT_BOUNCE
// UNOFFICIAL 2026-11-19 (Phase 3B Pass 3): Wave-coherent secondary bounce tracer + Radiance Cache + Final Demodulate & Output.
// Zero G-buffer / ReSTIR DI live registers; sky, ownFlash, and PTBounceHalf skipped tiles bypass bounce tracing cleanly.
void RunSplitBounce(ivec2 pixel) {
	if (!gScratchSplit) return;
	gPixel = pixel;
	const uint pAt = PayloadWord(pixel);
	const uint fl = scratch.words[pAt + 15u];
	const vec2 camUV = CameraUV(pixel, vec2(Rand(), Rand()));
	const vec3 camDir = normalize(p.forward.xyz + p.right.xyz * (2.0 * camUV.x - 1.0) - p.up.xyz * (2.0 * camUV.y - 1.0));
	state ^= 0x9E3779B9u; Pcg();   // decorrelate bounce RNG from Pass 1 & Pass 2

	const vec2 rRG = unpackHalf2x16(scratch.words[pAt + 6u]);
	const vec2 rBS = unpackHalf2x16(scratch.words[pAt + 7u]);
	const vec2 sGB = unpackHalf2x16(scratch.words[pAt + 8u]);
	const vec2 faRG = unpackHalf2x16(scratch.words[pAt + 12u]);
	const vec2 faBR = unpackHalf2x16(scratch.words[pAt + 13u]);
	vec3 radiance = vec3(rRG, rBS.x);
	const vec3 rad0 = radiance;
	const vec3 spec0 = vec3(rBS.y, sGB);
	const vec3 firstAlbedo = vec3(faRG, faBR.x);
	const float firstRough = faBR.y;
	const float t0 = uintBitsToFloat(scratch.words[pAt + 3u]);
	const bool hasSurface = (fl & kSplitFlagHasSurface) != 0u;
	const bool doBounce = (fl & kSplitFlagDoBounce) != 0u;
	const bool bumped = (fl & kSplitFlagFirstBump) != 0u;
	const bool glowMark = (fl & kSplitFlagGlowMark) != 0u;
	const bool isPane = (fl & kSplitFlagPane) != 0u;
	const bool viewModel = (fl & kSplitFlagViewModel) != 0u;
	const bool actorShadow = (fl & kSplitFlagActorShadow) != 0u;
	const uint prevRays = (fl >> 25u) & 63u;
	const bool split = Split() && (uint(p.accum.w) & 512u) != 0u;

	vec3 n0 = OctDecode(unpackSnorm2x16(scratch.words[pAt + 4u]));
	vec3 geoN0 = OctDecode(unpackSnorm2x16(scratch.words[pAt + 5u]));
	const vec3 hit0 = vec3(uintBitsToFloat(scratch.words[pAt + 0u]), uintBitsToFloat(scratch.words[pAt + 1u]), uintBitsToFloat(scratch.words[pAt + 2u]));
	const vec3 v0 = viewModel ? -normalize(hit0) : -camDir;
	const vec2 aRG = unpackHalf2x16(scratch.words[pAt + 9u]);
	const vec2 aBR = unpackHalf2x16(scratch.words[pAt + 10u]);
	const vec2 mF0 = unpackHalf2x16(scratch.words[pAt + 11u]);
	Surface surf0;
	surf0.albedo = vec3(aRG, aBR.x);
	surf0.rough = aBR.y;
	surf0.metal = mF0.x;
	surf0.f0 = mF0.y;
	surf0.kind = fl & 7u;

	const float firstMetal = isPane ? 0.0 : surf0.metal;
	const uint firstKind = isPane ? kKindPlain : surf0.kind;
	const float firstF0 = isPane ? 0.04 : surf0.f0;
	const float firstNV = dot(n0, v0);

	vec3 splitRatio = vec3(0.0);
	float splitHitT = 0.0, splitSpecLobe = 0.0;
	vec3 reflAlbedo = vec3(1.0);
	const int bounces = PtCount(p.accum.y, kPtMaxBounces);
	const bool halfSkip = (uint(p.accum.w) & 16384u) != 0u && ((((pixel.x >> 3) + (pixel.y >> 3) + int(uint(p.origin.w))) & 1) != 0);

	if (doBounce && bounces > 0 && !halfSkip) {
		const bool geoSplit0 = (fl & kSplitFlagGeoSplit) != 0u;
		const vec2 misGE = unpackHalf2x16(scratch.words[pAt + 14u]);
		float prevGlowTotal = misGE.x, prevEmTotal = misGE.y, prevEmSelect = 1.0;
		bool prevEmRestir = (fl & kSplitFlagEmRestir) != 0u;
		const bool cache = CacheOn();
		const bool cacheShort = cache && gCacheShort > 0.5 && bounces > 1 && Rand() * gCacheShort >= 1.0;
		vec3 cvHit[kCacheVerts];
		uint cvN[kCacheVerts];
		uvec3 cvTR[kCacheVerts];
		int cvCount = 0;
		vec3 cacheFirstGlow = vec3(0.0);

		if (cache) {
			const vec3 rCl = min(max(radiance, vec3(0.0)), vec3(65504.0));
			cvHit[0] = hit0;
			cvN[0] = packSnorm2x16(OctEncode(geoSplit0 ? geoN0 : n0));
			cvTR[0] = uvec3(packHalf2x16(vec2(1.0)), packHalf2x16(rCl.xy), packHalf2x16(vec2(1.0, rCl.z)));
			cvCount = 1;
		}

		vec3 l0, w0;
		float pdf0;
		bool go = NextDirection(n0, v0, surf0, l0, w0, pdf0);
		if (go && geoSplit0 && (dot(l0, n0) < 0.0) != (dot(l0, geoN0) < 0.0)) go = false;

		if (go) {
			vec3 throughput = ((uint(p.accum.w) & 16384u) != 0u ? 2.0 : 1.0) * w0;
			const float lobeChance = (Split() || gBounceRoughen > 0.0) ? SpecLobeChance(n0, v0, surf0, l0) : 0.0;
			splitRatio = SpecShare();
			splitHitT = 60000.0;
			splitSpecLobe = Split() ? lobeChance : 0.0;
			float pathRough = gBounceRoughen > 0.0 ? mix(1.0, surf0.rough, clamp(lobeChance, 0.0, 1.0)) : 0.0;
			vec3 prevN = n0;
			if (dot(l0, prevN) < 0.0) { prevN = -prevN; prevGlowTotal = 0.0; }
			vec3 prevHit = hit0;
			float prevPdf = pdf0;
			vec3 pos = hit0 + (geoSplit0 ? (dot(l0, geoN0) < 0.0 ? -geoN0 : geoN0) : prevN) * (1.0 + 0.002 * t0);
			vec3 dir = l0;
			float ptPath = 0.0;
			bool cacheEnd = false;
			gGeoSplit = false;
			gContact = false;
			gSplitTake = false;
			gRestirFirst = false;

			const int alphaMode = int(p.rect.w + 0.5);
			const float rayLength = p.grid[2].z > 0.0 ? p.grid[2].z : p.misc.z;

			for (int bounce = 1; bounce <= bounces; bounce++) {
				rayQueryEXT q;
				gGlassSolid = GlassMode() > 0.5;
				bool traced = false;
				float qT = 0.0;
				uint qInstance = 0u, qPrim = 0u;
				vec2 qBary = vec2(0.0);
				mat4x3 qToScene = mat4x3(1.0);
#ifndef RT_NO_REAL_TEXTURES
				rtConeWidth = 0.0;
#endif
				if (!(gOneCameraQuery > 0.5) && rtHiddenNear(pos, vec3(0.0))) {
					PT_RAY_INIT(q, gl_RayFlagsOpaqueEXT, 0x8Fu, pos + p.origin.xyz, 0.0, dir, rayLength)
					PT_PROCEED_OPAQUE(q)
					PT_TAKE_HIT(q);
					rayQueryEXT qp;
					PT_RAY_INIT(qp, gl_RayFlagsNoOpaqueEXT, alphaMode == 2 ? 0x60u : 0x70u, pos + p.origin.xyz, 0.0, dir, traced ? qT : rayLength)
					uint n_ = 0u;
					while (rayQueryProceedEXT(qp)) {
						PT_GUARD(qp, n_)
						if (rayQueryGetIntersectionTypeEXT(qp, false) != gl_RayQueryCandidateIntersectionTriangleEXT) continue;
						if ((rayQueryGetIntersectionInstanceCustomIndexEXT(qp, false) & NVR_RT_CUSTOM_HIDDEN) != 0u) continue;
						if (alphaMode == 0 || !AlphaTest() || rtAlphaPass(rayQueryGetIntersectionInstanceIdEXT(qp, false), uint(rayQueryGetIntersectionPrimitiveIndexEXT(qp, false)),
						                                                    rayQueryGetIntersectionBarycentricsEXT(qp, false)))
							rayQueryConfirmIntersectionEXT(qp);
					}
					if (rayQueryGetIntersectionTypeEXT(qp, true) == gl_RayQueryCommittedIntersectionTriangleEXT) PT_TAKE_HIT(qp);
				} else if (alphaMode != 1) {
					PT_RAY_INIT(q, gl_RayFlagsOpaqueEXT, alphaMode == 2 ? 0xEFu : 0xFFu, pos + p.origin.xyz, 0.0, dir, rayLength)
					PT_PROCEED_OPAQUE(q)
					if (alphaMode == 3 && rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT &&
						!rtAlphaPass(rayQueryGetIntersectionInstanceIdEXT(q, true), uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, true)), rayQueryGetIntersectionBarycentricsEXT(q, true))) {
						const float past = rayQueryGetIntersectionTEXT(q, true);
						PT_RAY_INIT(q, gl_RayFlagsOpaqueEXT, 0xEFu, pos + p.origin.xyz, past, dir, rayLength)
						PT_PROCEED_OPAQUE(q)
					}
					PT_TAKE_HIT(q);
				} else {
					PT_RAY_INIT(q, AlphaTest() ? 0u : gl_RayFlagsOpaqueEXT, 0xFFu, pos + p.origin.xyz, 0.0, dir, rayLength)
					Proceed(q);
					PT_TAKE_HIT(q);
				}

				if (!traced) {
					radiance += Indirect(throughput * Sky(dir));
					break;
				}
				const float t = qT;
				const vec3 v = -dir;
				RtHitGeom hg = rtHitLoadGeom(qInstance, qPrim, qBary);
				vec3 n = -dir;
				if (hg.hasPos) {
					vec3 face = mat3(qToScene) * rtHitGeomObjectNormal(hg);
					if (dot(face, face) > 1.0e-12) n = normalize(face);
				}
				n = dot(n, dir) > 0.0 ? -n : n;
				n = rtHitGeomSmoothNormal(hg, qBary, n, mat3(qToScene), dir);
				const vec3 hit = pos + dir * t;
#ifndef RT_NO_REAL_TEXTURES
				rtConeWidth = t0 * 2.0 * length(p.up.xyz) * p.size.w + (ptPath + t) * 0.5;
				rtConeDir = (uint(p.accum.w) & 2097152u) != 0u ? vec3(0.0) : dir;
				rtConeToScene = mat3(qToScene);
				rtHitGeomComputeGrads(hg);
#endif
				const vec3 hitAlbedo = clamp(AlbedoAtlas() ? rtHitGeomAlbedo(hg) : records[qInstance].albedo.rgb, 0.0, 1.0);
				Surface surf = HitSurface(hitAlbedo, qInstance);
				if (surf.kind == kKindGlass && gGlassSurface > 0.0) {
					const float share = GlassShare(qInstance, qPrim, qBary);
					if (share > 0.0 && Rand() < share) { surf.kind = kKindPane; surf.albedo = hitAlbedo; surf.rough = 1.0; surf.metal = 0.0; surf.f0 = 0.04; }
				}
				rtHitNormalAtlasOn = NormalAtlas();
				const vec3 bent = rtHitGeomNormalMapped(hg, n, mat3(qToScene));
				if (dot(bent, v) > 0.0) n = bent;
				if (GlowAtlas() && p.skyHorizon.w > 0.0) {
					const vec3 glow = rtHitGeomGlow(hg);
					if (glow != vec3(0.0)) {
						float mis = 1.0;
						if (GlowLightCount() > 0 && prevGlowTotal > 0.0) {
							const int owner = GlowOwner(hit);
							if (owner >= 0) {
								const float light = GlowWeight(owner, prevHit, prevN) / prevGlowTotal * GlowConePdf(GlowSphere(owner), pos, prevN, dir);
								mis = prevPdf / max(prevPdf + light, 1.0e-8);
							}
						}
						if (prevEmTotal > 0.0) {
							const float light = EmPdfAt(qInstance, qPrim, dir, t, prevHit, prevN, prevEmTotal) * prevEmSelect;
							if (light > 0.0) {
								const float balance = prevPdf / max(prevPdf + light, 1.0e-30);
								if (prevEmRestir) { cacheFirstGlow += Indirect(throughput * glow * (p.skyHorizon.w * balance)); mis = 0.0; }
								else mis *= balance;
							}
						}
						radiance += Indirect(throughput * glow * (p.skyHorizon.w * mis));
					}
				}
				if (gBounceRoughen > 0.0) surf.rough = max(surf.rough, pathRough * gBounceRoughen);
				if (bounce == 1) { splitHitT = t; reflAlbedo = surf.albedo; }
				ptPath += t;

				bool cached = false;
				if (cache && (bounce == bounces || cacheShort)) {
					vec3 cl;
					if (CacheRead(hit, n, cl)) { radiance += Indirect(throughput * cl); cached = true; cacheEnd = bounce < bounces; }
				}
				gEmMis = (bounce < bounces) || cached;
				gBounce = bounce;
				gFlashOnly = false;
				const vec3 lit = DirectSides(hit, n, t, v, surf);
				radiance += Indirect(throughput * lit);
				if (bounce == bounces && (uint(p.accum.w) & 65536u) != 0u && !cached)
					radiance += Indirect(throughput * surf.albedo * lit * 0.75);
				if (bounce == bounces && (uint(p.accum.w) & 32768u) != 0u && p.skyZenith.w > 0.5 && !cached)
					radiance += Indirect(throughput * surf.albedo * Sky(CosineDirection(n, vec2(Rand(), Rand()))));
				if (cache && bounce < bounces && !cacheEnd && cvCount < kCacheVerts) {
					const vec3 tCl = min(max(throughput, vec3(0.0)), vec3(65504.0)), rCl = min(max(radiance, vec3(0.0)), vec3(65504.0));
					cvHit[cvCount] = hit;
					cvN[cvCount] = packSnorm2x16(OctEncode(n));
					cvTR[cvCount] = uvec3(packHalf2x16(tCl.xy), packHalf2x16(rCl.xy), packHalf2x16(vec2(tCl.z, rCl.z)));
					cvCount++;
				}
				if (bounce == bounces || cacheEnd) break;
				vec3 l, w;
				float pdf;
				if (!NextDirection(n, v, surf, l, w, pdf)) break;
				if (gBounceRoughen > 0.0) {
					const float lc = SpecLobeChance(n, v, surf, l);
					pathRough = max(pathRough, mix(1.0, surf.rough, clamp(lc, 0.0, 1.0)));
				}
				if (dot(l, n) < 0.0) { n = -n; gGlowTotal = 0.0; }
				prevHit = hit; prevN = n; prevPdf = pdf; prevGlowTotal = gGlowTotal;
				prevEmTotal = gEmTotal; prevEmSelect = gEmSelect; prevEmRestir = false;
				throughput *= w;
				if (bounce >= (gRouletteFrom > 0.5 ? 1 : 2)) {
					const float keep = clamp(max(throughput.r, max(throughput.g, throughput.b)), bounce < 2 ? 0.25 : 0.05, 0.95);
					if (Rand() >= keep) break;
					throughput /= keep;
				}
				pos = hit + n * (1.0 + 0.002 * t);
				dir = l;
			}
			const bool writeBounce0 = ((uint(pixel.x) ^ (uint(pixel.y) << 1u) ^ uint(p.origin.w)) & 3u) == 0u;
			for (int i = 0; i < cvCount; i++) {
				if (i == 0 && !writeBounce0) continue;
				const vec2 txy = unpackHalf2x16(cvTR[i].x), rxy = unpackHalf2x16(cvTR[i].y), trz = unpackHalf2x16(cvTR[i].z);
				const vec3 T = vec3(txy, trz.x), R = vec3(rxy, trz.y);
				const vec3 rest = radiance - R + (i == 0 ? cacheFirstGlow : vec3(0.0));
				CacheAdd(cvHit[i], OctDecode(unpackSnorm2x16(cvN[i])), max(vec3(T.x > 1.0e-4 ? rest.x / T.x : 0.0, T.y > 1.0e-4 ? rest.y / T.y : 0.0, T.z > 1.0e-4 ? rest.z / T.z : 0.0), vec3(0.0)));
			}
		}
	}

	const bool bad = any(isnan(radiance)) || any(isinf(radiance));
	if (bad) radiance = vec3(0.0);
	vec3 spec = vec3(0.0);
	if (split && !bad && hasSurface && Specular()) {
		spec = spec0 + max(radiance - rad0, vec3(0.0)) * splitRatio;
		spec = (any(isnan(spec)) || any(isinf(spec))) ? vec3(0.0) : clamp(spec, vec3(0.0), max(radiance, vec3(0.0)));
	}
	const float lumaC = dot(radiance, vec3(0.2126, 0.7152, 0.0722));
	if (p.misc.y > 0.0 && lumaC > p.misc.y) { radiance *= p.misc.y / lumaC; spec *= p.misc.y / lumaC; }

	const float firstViewZ = (gEarlyLook > 0.5 && p.forward.w > 0.0 && t0 > 0.0) ? t0 * dot(viewModel ? normalize(hit0) : camDir, p.forward.xyz) / p.forward.w : 0.0;
	const float earlyZ = glowMark ? -1.0 : (isnan(firstViewZ) || isinf(firstViewZ) ? 0.0 : firstViewZ);
	const float displayABase = gCountRays ? 1.0 + float(prevRays + gRayCount) : gEarlyLook > 0.5 ? earlyZ : bumped ? 2.0 + gBumpDetail : 1.0;
	const float displayA = (actorShadow && !gCountRays && !(gEarlyLook > 0.5)) ? -displayABase : displayABase;
	const vec3 albedo = max(firstAlbedo, vec3(0.02));

	if (split) {
		vec3 specAlbedo = vec3(0.0);
		bool specMirror = false;
		if (hasSurface && Specular()) {
			const vec3 f0 = firstKind == kKindHair ? clamp(firstAlbedo, vec3(0.004), vec3(0.04)) :
				mix(vec3(firstKind == kKindSkin ? 0.028 : firstF0), firstAlbedo, clamp(firstMetal, 0.0, 1.0));
			specAlbedo = EnvBrdfApprox(f0, clamp(firstRough, 0.0, 1.0), clamp(firstNV, 0.0, 1.0));
			specMirror = gMirrorSurface > 0.0 && firstRough < gMirrorSurface && firstMetal >= 0.99;
			if (specMirror && splitSpecLobe > 0.5) specAlbedo *= max(reflAlbedo, vec3(0.02));
			specAlbedo = max(specAlbedo, vec3(0.01));
		}
		const vec3 diffuse = min(max(radiance - spec, vec3(0.0)) / albedo, vec3(gDenoiseCeil));
		const vec3 specular = specAlbedo.x > 0.0 ? min(spec / specAlbedo, vec3(gDenoiseCeil)) : vec3(0.0);
		const float albedoA = hasSurface ? (1.0 + clamp(firstMetal, 0.0, 1.0)) : 0.0;
		const float outHitT = splitSpecLobe > 0.5 ? splitHitT : 0.0;
		imageStore(albedoOut, pixel, vec4(albedo, albedoA));
		imageStore(display, pixel, vec4(diffuse, displayA));
		imageStore(specOut, pixel, vec4(specular, specMirror ? (outHitT >= 1.0 ? -outHitT : -0.5) : outHitT));
		imageStore(accumA, pixel, vec4(specAlbedo.rg, 0.0, 0.0));
		imageStore(accumB, pixel, vec4(specAlbedo.b, firstRough, 0.0, 0.0));
		return;
	}
	imageStore(albedoOut, pixel, vec4(albedo, hasSurface ? 1.0 : 0.0));
	imageStore(display, pixel, vec4(min(radiance / albedo, vec3(gDenoiseCeil)), displayA));
}
#endif   // PT_SPLIT_BOUNCE

void main() {
	const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
#ifdef PT_SPLIT_SPATIAL
	RunSplitSpatial(pixel);
	return;
#endif
	if (pixel.x >= int(p.size.x) || pixel.y >= int(p.size.y)) return;
	state = uint(pixel.x) * 1973u + uint(pixel.y) * 9277u + uint(p.origin.w) * 26699u;
	LoadMatKeys();   // (2026-11-07 ptaaa-materials) the material models' keys, once
	LoadBounceRoughen();   // (2026-11-09 PTBounceRoughen)
	LoadCostKeys();  // (perf-ptcost) the ray budget's keys, once
	LoadEmCostKeys();   // (2026-11-11 pt-emissive-cost) PTEmissive's cost keys, once
#ifndef PT_RESTIR_GI
	LoadScratchLayout();   // (ptaaa-hangfix) the scratch store's regions, checked once
#endif
	Pcg();
#ifdef PT_SPLIT_BOUNCE
	RunSplitBounce(pixel);
	return;
#endif
#ifdef PT_SPLIT_PRIMARY
	if (!gScratchSplit) return;
	{
		const vec2 uv = CameraUV(pixel, vec2(Rand(), Rand()));
		const vec3 dir = normalize(p.forward.xyz + p.right.xyz * (2.0 * uv.x - 1.0) - p.up.xyz * (2.0 * uv.y - 1.0));
		gPixel = pixel;
		ClearTempReservoir();
		gFirstAlbedo = vec3(1.0);
		gFirstSurface = 0.0;
		gFirstRough = 1.0; gFirstMetal = 0.0; gFirstNV = 1.0; gFirstKind = kKindPlain; gFirstF0 = 0.04;
		gSplitTake = false; gSplitSpec = vec3(0.0); gSplitRad0 = vec3(0.0); gSplitRatio = vec3(0.0); gSplitHitT = 0.0; gSplitSpecLobe = 0.0;
		gReflAlbedo = vec3(1.0);
		gFirstViewZ = 0.0; gFirstGlowMark = false; gFirstBump = false;
		gFirstActorShadow = false; gFirstSunDiff = vec3(0.0); gFirstSunVis = 1.0; gFirstSunHitT = 0.0;
		gSplitVisChecked = false; gSplitVisTint = vec3(1.0); gSplitWrotePayload = false;
		vec3 c = Path(dir);
		StoreSunSplit(pixel, gFirstAlbedo);
		if (!gSplitWrotePayload) {
			if (any(isnan(c)) || any(isinf(c))) c = vec3(0.0);
			const uint at = PayloadWord(pixel);
			const vec3 rCl = min(max(c, vec3(0.0)), vec3(65504.0));
			const vec3 sCl = min(max(gSplitSpec, vec3(0.0)), vec3(65504.0));
			scratch.words[at + 3u] = floatBitsToUint(0.0);
			scratch.words[at + 6u] = packHalf2x16(rCl.rg);
			scratch.words[at + 7u] = packHalf2x16(vec2(rCl.b, sCl.r));
			scratch.words[at + 8u] = packHalf2x16(sCl.gb);
			scratch.words[at + 12u] = packHalf2x16(gFirstAlbedo.rg);
			scratch.words[at + 13u] = packHalf2x16(vec2(gFirstAlbedo.b, gFirstRough));
			uint fl = 0u;
			if (gFirstBump) fl |= kSplitFlagFirstBump;
			if (gFirstGlowMark) fl |= kSplitFlagGlowMark;
			if (gFirstActorShadow) fl |= kSplitFlagActorShadow;
			fl |= (min(gRayCount, 63u) << 25u);
			scratch.words[at + 15u] = fl;
		}
		return;
	}
#endif
#if !defined(PT_SPLIT_PRIMARY) && !defined(PT_SPLIT_SPATIAL) && !defined(PT_SPLIT_BOUNCE)
#ifdef PT_RESTIR_GI
	{   // (2026-11-04 d) one path: the first-bounce sample and the rest apart, for RtRestirGI.comp (which demodulates)
		const vec2 uv = CameraUV(pixel, vec2(Rand(), Rand()));   // (2026-11-10 early kick: texel 23.x)
		gPixel = pixel;
		gFirstAlbedo = vec3(1.0);
		gFirstSurface = 0.0;
		vec3 c = Path(normalize(p.forward.xyz + p.right.xyz * (2.0 * uv.x - 1.0) - p.up.xyz * (2.0 * uv.y - 1.0)));
		if (any(isnan(c)) || any(isinf(c))) c = vec3(0.0);
		if (any(isnan(gGIDirect)) || any(isinf(gGIDirect))) gGIDirect = vec3(0.0);
		imageStore(albedoOut, pixel, vec4(max(gFirstAlbedo, vec3(0.02)), gFirstSurface > 0.0 && gGISurface ? 1.0 + gGIMetal : gFirstSurface));
		imageStore(accumA, pixel, vec4(rgiPack24(gGIDir), gGIFirst ? gGIT2 : 0.0, 0.0, 0.0));
		imageStore(accumB, pixel, vec4(rgiPack24(gGIN2), rgiPackNormalM(gGIN1, gGIShare * 255.0), 0.0, 0.0));
		imageStore(display, pixel, vec4(gGIFirst ? c : vec3(0.0), gGISurface ? gGIT1 : 0.0));
		imageStore(giDirect, pixel, vec4(gGIFirst ? gGIDirect : c, 1.0));
		return;
	}
#endif
	const int paths = max(PtCount(p.accum.z, kPtMaxPaths), 1);   // (hangfix: capped)
	vec3 albedoSum = vec3(0.0);
	float surfaceSum = 0.0;
	vec3 sum = vec3(0.0);
	// (2026-11-07 ptaaa-denoiser) PTDenoiseSplit: each path's light split into diffuse and specular (the sum unchanged); only the picture
	// (PTDebugView 0) and with the demodulation (512)
	const bool split = Split() && (uint(p.accum.w) & 512u) != 0u && int(p.misc.w + 0.5) == 0;
	vec3 specSum = vec3(0.0), specAlbedoSum = vec3(0.0);
	float roughSum = 0.0, metalSum = 0.0, specHitT = 0.0;
	bool specMirror = false;   // (2026-11-09 pt-mirrors) PTDenoiseMirrorSurface: the first path's reflected thing stands in for the surface
	float earlyZ = 0.0;   // (2026-11-11 PTEarlyLook slice 2) the first path's first hit: view z / farZ, 0 a miss, -1 a glow the game draws
	bool bumped = false;   // (2026-11-12 ptbump) the first path's first hit was lit with its bumped normal (PTBumpNormals)
	bool actorShadow = false;   // UNOFFICIAL 2026-11-20: any path's primary direct shadow hit a moving actor (NVR_RT_CUSTOM_ACTOR)
	for (int s = 0; s < paths; s++) {
		const vec2 uv = CameraUV(pixel, vec2(Rand(), Rand()));   // (2026-11-10 early kick: texel 23.x; the random numbers drawn either way)
		const vec3 dir = normalize(p.forward.xyz + p.right.xyz * (2.0 * uv.x - 1.0) - p.up.xyz * (2.0 * uv.y - 1.0));
		gPixel = pixel;
#ifndef PT_RESTIR_GI
		if (s == 0 && RestirDI()) ClearReservoir();   // (2026-11-07) no first surface this frame: no reservoir (RestirLamps overwrites it)
#endif
		gFirstAlbedo = vec3(1.0);
		gFirstSurface = 0.0;
		gFirstRough = 1.0; gFirstMetal = 0.0; gFirstNV = 1.0; gFirstKind = kKindPlain; gFirstF0 = 0.04;   // (ptaaa-denoiser)
		gSplitTake = false; gSplitSpec = vec3(0.0); gSplitRad0 = vec3(0.0); gSplitRatio = vec3(0.0); gSplitHitT = 0.0; gSplitSpecLobe = 0.0;
		gReflAlbedo = vec3(1.0);   // (pt-mirrors)
		gFirstViewZ = 0.0; gFirstGlowMark = false;   // (2026-11-11 PTEarlyLook)
		gFirstActorShadow = false;
		if (s == 0) { gFirstSunDiff = vec3(0.0); gFirstSunVis = 1.0; gFirstSunHitT = 0.0; }
		vec3 c = Path(dir);
		actorShadow = actorShadow || gFirstActorShadow;
		if (s == 0) earlyZ = gFirstGlowMark ? -1.0 : (isnan(gFirstViewZ) || isinf(gFirstViewZ) ? 0.0 : gFirstViewZ);
		if (s == 0) bumped = gFirstBump;   // (2026-11-12 ptbump)
		const bool bad = any(isnan(c)) || any(isinf(c));
		if (bad) c = vec3(0.0);
		// (ptaaa-denoiser) the specular part: the first hit's direct light through its GGX lobe + what came through the first bounce x that
		// direction's specular share of the BRDF (exact for either lobe's sample: the one-sample mixture's weight is the whole BRDF's)
		vec3 spec = vec3(0.0);
		if (split && !bad && gFirstSurface > 0.0 && Specular()) {
			spec = gSplitSpec + max(c - gSplitRad0, vec3(0.0)) * gSplitRatio;
			spec = (any(isnan(spec)) || any(isinf(spec))) ? vec3(0.0) : clamp(spec, vec3(0.0), max(c, vec3(0.0)));
		}
