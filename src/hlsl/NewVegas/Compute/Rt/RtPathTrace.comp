//   23.x early kick (2026-11-10, env NVR_RT_EARLY_PT; RtPathTrace.cpp SubmitBeforeWorld): 1 = this frame was recorded before the world
//        was drawn (no G-buffer: a traced first surface); the camera rays go through the pixel centre + the depth's jitter (p.rect.xy),
//        as ScreenHit places the screen's surface, so the traced first surface lies on the pixel the game rasterises (the denoiser's and
//        the upscaler's depth / normals / motion). 0: the random point in the pixel, as before.
float gRouletteFrom = 0.0, gHairFirst = 0.0;
bool gCameraJitter = false;
// (2026-11-11 PTDenoiseCeiling, frame row texel 23.y; a tester's video: an object the flashlight lit from close by went BLACK under path
// tracing) the light handed to the denoiser is divided by the surface's colour (down to 0.02) and was capped only at 60000, the largest
// half float. The denoiser keeps the SQUARE of its brightness in a half float too (the second moment, RtDenoiseTemporalRgb.frag): above
// about 256 that square is infinite, the variance not a number, and the pixel black. A strong light close up (the flashlight on a
// sphere at arm's length) passes 256 easily. Capped at the ceiling (200: its square 40000 fits), far above anything the picture can show
// as other than white. 0 in the row = the old 60000.
float gDenoiseCeil = 60000.0;
void LoadCostKeys() {
#ifdef PT_TEST_RR
	gRouletteFrom = float(PT_TEST_RR);   // (replay experiments: the key compiled in)
#endif
	if ((uint(p.accum.w) & 1024u) == 0u) return;
#ifndef PT_TEST_RR
	gRouletteFrom = FrameTexel(30).y;
#endif
	{ const float hairBits = FrameTexel(30).x; gHairKind = hairBits >= 1.5 ? 1.0 : 0.0; gHairFirst = hairBits - 2.0 * gHairKind; }   // (1: first surface, 2: hair's own highlight)
	const vec2 a = FrameTexel(28), b = FrameTexel(29);
	gRestirRays = a.x; gBounceLights = a.y; gOneCameraQuery = b.x; gCountRays = b.y > 0.5;
	gCameraJitter = FrameTexel(23).x > 0.5;   // (2026-11-10 early kick)
	{ const float ceil_ = FrameTexel(23).y; gDenoiseCeil = ceil_ > 0.0 ? min(ceil_, 60000.0) : 60000.0; }   // (2026-11-11 PTDenoiseCeiling)
}
// The camera ray's point in the pixel (screen uv): the random sub-pixel point (rnd) as before, or with texel 23.x the jittered centre
vec2 CameraUV(ivec2 pixel, vec2 rnd) { return gCameraJitter ? (vec2(pixel) + 0.5) * p.size.zw + p.rect.xy : (vec2(pixel) + rnd) * p.size.zw; }
int RestirRaysMode() { return int(clamp(gRestirRays, 0.0, 3.0) + 0.5); }
float GlassMode() { return MatKeys().x; }
float Luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

// GLASS: a thin pane of n = 1.5. Its tint is the hue of the glass texture's average colour (records' albedo), never its darkness (glass
// textures are drawn see-through: a grey one is not a grey filter), x PTGlassTint
vec3 GlassTint(vec3 albedo) {
	const float m = max(max(albedo.r, albedo.g), max(albedo.b, 1.0e-3));
	return mix(vec3(1.0), clamp(albedo / m, 0.0, 1.0), clamp(MatKeys().y, 0.0, 1.0));
}
// unpolarised Fresnel reflectance of one air-glass face at the incidence cosine c (exact, not Schlick: 4 % head on, 100 % grazing)
float FresnelGlass(float c) {
	const float eta = 1.5;
	c = clamp(c, 1.0e-3, 1.0);
	const float ct = sqrt(max(1.0 - (1.0 - c * c) / (eta * eta), 0.0));
	const float rs = (c - eta * ct) / (c + eta * ct), rp = (eta * c - ct) / (eta * c + ct);
	return 0.5 * (rs * rs + rp * rp);
}
// The pane as a whole (both faces, the light bouncing between them; a = one pass through it per colour): reflectance R, transmittance T.
// a = 1: R + T = 1 exactly (host scene `materials`, glass furnace)
void GlassSlab(float c, vec3 a, out vec3 R, out vec3 T) {
	const float r = FresnelGlass(c);
	const vec3 d = max(1.0 - r * r * a * a, vec3(1.0e-6));
	T = (1.0 - r) * (1.0 - r) * a / d;
	R = r + (1.0 - r) * (1.0 - r) * r * a * a / d;
}
// A shadow ray crossing a pane: its transmittance at the crossing's angle (the triangle's own normal)
vec3 GlassShadow(uint instance, uint prim, mat3 toScene, vec3 dir) {
	float c = 1.0;
	if (records[instance].vertexOffset != 0xFFFFFFFFu) {
		const vec3 f = toScene * rtHitObjectNormal(instance, prim);
		if (dot(f, f) > 1.0e-12) c = abs(dot(normalize(f), dir));
	}
	vec3 R, T;
	GlassSlab(c, GlassTint(records[instance].albedo.rgb), R, T);
	return T;
}

// (2026-11-07 ptaaa-materials) shadow rays pass glass panes, tinted by them: gShadowTint is the product of the panes' transmittance along
// the last Visible ray (1 when it met none; Direct multiplies the sun and the lamp by it). A pane's triangle reported twice (the API allows
// a duplicate any-hit) counts once (the last two crossings are remembered).
vec3 gShadowTint = vec3(1.0);
bool Visible(vec3 from, vec3 dir, float tMax) {
	gShadowTint = vec3(1.0);
	// (merge 2026-11-07) a near-eye ray (ptaaa-firstperson) returns untinted: glass panes within arm's reach of the eye are rare
	// (2026-11-07 ptaaa-firstperson) a ray from (the view model, a surface within arm's reach) or toward (the flashlight, the Pip-Boy
	// light: lamps at the eye; the lamp lies ~16 units past tMax) a point near the eye passes over the hidden first-person body
	// (RtHidden.glsl). The scene's eye is at 0 here (camera-relative points, p.origin = RtCore::Eye())
	// (merge 2026-11-07, the ptaaa size fix) ONE query loop for both cases (the path tracer calls Visible from ~9 inlined places: two loops
	// each with its own alpha test were too much code for the AMD driver's pipeline build). Near the eye: rtBlockedPassHidden's two queries
	// (kRtAnyHit, mask 0xFF: the opaque 0x8F, then 0x70 every candidate tested, the hidden body passed over), as before; else one query
	// over everything, glass tinting, cut-outs tested. Same answers as the two functions it replaces.
	const bool near = rtHiddenPassOver(from, from + dir * (tMax + 16.0), vec3(0.0));
	if (near && !(tMax > 0.0)) return true;
	const bool glass = !near && GlassMode() > 0.5;
	uint seen0 = 0xFFFFFFFFu, seen1 = 0xFFFFFFFFu;
	for (int k = near ? 0 : 1; k < 2; k++) {   // 0: near the eye, the opaque world first; 1: the candidates' query
		const uint flags = gl_RayFlagsTerminateOnFirstHitEXT | (k == 0 ? gl_RayFlagsOpaqueEXT : near ? gl_RayFlagsNoOpaqueEXT : AlphaTest() ? 0u : gl_RayFlagsOpaqueEXT);
		rayQueryEXT s;
		PT_RAY_INIT(s, flags, k == 0 ? 0x8Fu : near ? 0x70u : 0xFFu, from + p.origin.xyz, 0.0, dir, tMax)   // (hangfix)
		uint n_ = 0u;
		while (rayQueryProceedEXT(s)) {
			PT_GUARD(s, n_)   // (hangfix)
			if (rayQueryGetIntersectionTypeEXT(s, false) != gl_RayQueryCandidateIntersectionTriangleEXT) continue;
			const uint ci = rayQueryGetIntersectionInstanceCustomIndexEXT(s, false);
			const uint instance = rayQueryGetIntersectionInstanceIdEXT(s, false), prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(s, false));
			if (near && (ci & NVR_RT_CUSTOM_HIDDEN) != 0u) continue;   // (the hidden body, near the eye)
			if (!near && rtIsGlass(instance)) {
				const uint key = (instance * 2654435761u) ^ (prim * 40503u + 1u);
				if (glass && key != seen0 && key != seen1) {
					seen1 = seen0; seen0 = key;
					gShadowTint *= GlassShadow(instance, prim, mat3(rayQueryGetIntersectionObjectToWorldEXT(s, false)), dir);
				}
				continue;
			}
			if ((near && !AlphaTest()) || rtAlphaPassShadow(ci, instance, prim, rayQueryGetIntersectionBarycentricsEXT(s, false)))
				rayQueryConfirmIntersectionEXT(s);
		}
		if (rayQueryGetIntersectionTypeEXT(s, true) == gl_RayQueryCommittedIntersectionTriangleEXT) return false;
	}
	return true;
}

vec3 Basis(vec3 n, out vec3 b) {
	vec3 t = normalize(abs(n.z) < 0.999 ? cross(n, vec3(0.0, 0.0, 1.0)) : cross(n, vec3(1.0, 0.0, 0.0)));
	b = cross(n, t);
	return t;
}

vec3 CosineDirection(vec3 n, vec2 u) {
	vec3 b, t = Basis(n, b);
	float r = sqrt(u.x), phi = 6.2831853 * u.y;
	return normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(max(1.0 - u.x, 0.0)));
}

// RT reflections' PanoAlong (Reflections.glsl): hemi-octahedral, z up, below the horizon = the horizon ring; bilinear by hand
vec3 Panorama(vec3 d) {
	d = normalize(vec3(d.xy, max(d.z, 0.0)) + vec3(0.0, 0.0, 1.0e-4));
	vec3 v = d / (abs(d.x) + abs(d.y) + d.z);
	const float size = 128.0;   // Reflections.h pano[]: 128 x 128
	vec2 f = (vec2(v.x + v.y, v.x - v.y) * 0.5 + 0.5) * size - 0.5;
	ivec2 i = ivec2(floor(f));
	vec2 w = f - vec2(i);
	ivec2 hi = ivec2(int(size) - 1);
	vec3 a = imageLoad(skyPano, clamp(i, ivec2(0), hi)).rgb, b = imageLoad(skyPano, clamp(i + ivec2(1, 0), ivec2(0), hi)).rgb;
	vec3 c = imageLoad(skyPano, clamp(i + ivec2(0, 1), ivec2(0), hi)).rgb, e = imageLoad(skyPano, clamp(i + ivec2(1, 1), ivec2(0), hi)).rgb;
	return max(mix(mix(a, b, w.x), mix(c, e, w.x), w.y), vec3(0.0));
}

vec3 Sky(vec3 d) {
	if (p.skyZenith.w < 0.5) return p.ambient.rgb;
	if (SkyPanorama()) return Panorama(d) * (d.z < 0.0 ? 0.3 : 1.0) * p.ambient.w;
	if (d.z < 0.0) return p.skyHorizon.rgb * 0.3;
	return mix(p.skyHorizon.rgb, p.skyZenith.rgb, sqrt(d.z));
}

// The committed hit's triangle normal in scene space, facing the ray (the ray's reverse when the helper had no room for the data)
vec3 HitNormal(uint instance, uint prim, mat4x3 toScene, vec3 d) {
	vec3 n = -d;
	if (records[instance].vertexOffset != 0xFFFFFFFFu) {
		vec3 face = mat3(toScene) * rtHitObjectNormal(instance, prim);
		if (dot(face, face) > 1.0e-12) n = normalize(face);
	}
	return dot(n, d) > 0.0 ? -n : n;
}

// ---- (2026-11-02 e) materials: Lambert + GGX (PTSpecular, flag 128). A surface: albedo, roughness (perceptual), metal. The game's
// units fold pi into the light (a Lambert surface facing a light of colour E sends albedo x E), so the direct light uses pi x the BRDF
// and a path's throughput the physical BRDF x cos / pdf (diffuse alone: x albedo, as before).
bool Specular() { return (uint(p.accum.w) & 128u) != 0u; }
// (2026-11-07 ptaaa-materials) kind: the material model (HitSurface from the record, ScreenHit from the MaterialBuffer's class); for glass
// the albedo is the pane's tint (GlassTint)
struct Surface { vec3 albedo; float rough; float metal; uint kind; };
const uint kKindPlain = 0u, kKindGlass = 1u, kKindFoliage = 2u, kKindSkin = 3u, kKindCloth = 4u, kKindHair = 5u;   // (hair: 2026-11-10, a traced TINTED record with texel 30.x's bit 2)

// ---- UNOFFICIAL 2026-11-07 (ptaaa-materials) THIN TRANSLUCENT surfaces: leaves and grass (foliage) and skin's thin parts. R is the diffuse
// colour sent back on the lit side, T the colour sent through to the far side (diffuse again: a thin leaf or ear scatters what it lets
// through). Foliage: T = PTFoliage x R; skin: T = 0.25 PTSkin x R x flesh red (Skin.hlsl SKIN_TRANSMIT_TINT). Both are scaled per colour
// so that R + T never exceeds the albedo's share of 1: realistic albedos keep R = albedo (front-lit leaves look as before), an albedo-1
// card in a white furnace keeps exactly what it receives (host scene `materials`).
// Light from behind reaches the far side through Translucent (a second light sample from the far side's face); the path goes through
// with chance Luma(T) / Luma(R + T) (NextDirection). A thick part (a torso, a trunk) stops that light by itself: the far side's sample
// starts 1 unit inside it and its own back faces block the ray, so only parts thinner than that let light through (ears, fingers, leaves).
const vec3 kSkinTransmitTint = vec3(1.0, 0.28, 0.12);
vec3 TransmitShare(Surface s) {
	if (s.kind == kKindFoliage) return vec3(max(MatKeys().z, 0.0));
	if (s.kind == kKindSkin) return 0.25 * max(MatKeys().w, 0.0) * kSkinTransmitTint;
	return vec3(0.0);
}
vec3 ReflectColour(Surface s) {
	const vec3 t = TransmitShare(s);
	return s.albedo * min(vec3(1.0), 1.0 / max(s.albedo * (1.0 + t), vec3(1.0e-4)));
}
vec3 TransmitColour(Surface s) { return TransmitShare(s) * ReflectColour(s); }
float TransmitChance(Surface s) {
	if (s.kind != kKindFoliage && s.kind != kKindSkin) return 0.0;
	const float t = Luma(TransmitColour(s));
	return t > 0.0 ? t / max(t + Luma(ReflectColour(s)), 1.0e-6) : 0.0;
}
// SKIN: the diffuse light under a light at cosine nl wraps past the terminator, per colour (red widest: light scattered under the skin
// comes out red), normalised (nl + w) / (1 + w)^2: under an even sky never more than Lambert (pi (1 + 2w) / (1 + w)^2 <= pi), head-on 1 / (1 + w)
// of it, at the terminator w / (1 + w)^2 where Lambert has 0. pi x the BRDF toward the light: that / nl. Light samples only (bounce
// weights keep Lambert: gBounceEval).
bool gBounceEval = false;
vec3 SkinWrap() { return vec3(0.3, 0.12, 0.08) * clamp(MatKeys().w, 0.0, 2.0); }
vec3 SkinWrapPi(float nl) { const vec3 w = SkinWrap(); nl = max(nl, 1.0e-4); return (nl + w) / ((1.0 + w) * (1.0 + w) * nl); }
// CLOTH: a sheen lobe (Estevez & Kulla 2017 "Charlie" distribution, Neubelt & Pettineo's visibility) of colour PTClothSheen x sqrt(albedo),
// roughness = the surface's (at least 0.3); the diffuse under it gives up the sheen's directional albedo (bounded from above by
// 0.05 + 0.7 exp(-1.9 nv) for roughness 0.3-1, fitted to its numeric integral): energy never grows.
float SheenD(float nh, float a) { const float inv = 1.0 / a; return (2.0 + inv) * pow(max(1.0 - nh * nh, 0.0), 0.5 * inv) / 6.2831853; }
float SheenV(float nl, float nv) { return 1.0 / (4.0 * (nl + nv - nl * nv)); }
float SheenAlbedoBound(float nv) { return 0.05 + 0.7 * exp(-1.9 * clamp(nv, 0.0, 1.0)); }

// (2026-11-10 hair; measured on an RTX-class card: traced hair of albedo ~0.02 came out pale grey, and dark brown as in the game with
// PTSpecular off: the plain dielectric's white 4 % highlight is as strong as that hair's whole diffuse light) hair's highlight takes
// the hair's own colour, between 0.4 % and 4 %: a dark head keeps a dark, coloured sheen, a blond one nearly the plain highlight.
vec3 FresnelF0(Surface s) {
	if (s.kind == kKindHair) return clamp(s.albedo, vec3(0.004), vec3(0.04));
	return mix(vec3(s.kind == kKindSkin ? 0.028 : 0.04), s.albedo, s.metal);
}   // (skin: Skin.hlsl SKIN_F0)
// (2026-11-07 ptaaa-denoiser) the specular albedo PTDenoiseSplit divides the specular light by: Karis' fit of the split-sum environment
// BRDF (as DlssRRGuides.comp / Shaders/Includes/PBR.hlsl EnvBRDFApprox), clamped to 1. Only a demodulation factor (the show pass
// multiplies the same stored value back), so its accuracy changes how much texture the denoiser sees, never the light.
vec3 EnvBrdfApprox(vec3 f0, float rough, float nv) {
	const vec4 r = rough * vec4(-1.0, -0.0275, -0.572, 0.022) + vec4(1.0, 0.0425, 1.04, -0.04);
	const float a004 = min(r.x * r.x, exp2(-9.28 * nv)) * r.x + r.y;
	const vec2 ab = vec2(-1.04, 1.04) * a004 + r.zw;
	return clamp(f0 * ab.x + ab.y, vec3(0.0), vec3(1.0));
}
float GgxD(float nh, float a2) { float d = nh * nh * (a2 - 1.0) + 1.0; return a2 / (3.14159265 * d * d); }
float SmithG1(float x, float a2) { return 2.0 * x / (x + sqrt(a2 + (1.0 - a2) * x * x)); }

// UNOFFICIAL 2026-11-07 (RT-PATH-TRACING.md section 49) multiple-scattering energy compensation: a single-scattering GGX lobe loses the light
// that bounces between microfacets (at roughness 1 a metal kept only 35-60 % of what it should reflect: rough metal came out too dark). The
// table is E(nv, rough), this BRDF's own albedo with Fresnel 1 (tools/nvr-rt-host/ggx_energy_table.py); the lobe is scaled by
// 1 + F0 (1 / E - 1) (Turquin 2019, Fdez-Aguera 2019). Host scene specfurnace: a white metal box under a uniform sky = the sky everywhere.

// (the table rides in the lamp image's frame row, texels 32-287 (RtRestirRow.h kGgxEnergy; flag 1048576): as a constant array here it cost
// ~12 s of pipeline compile per variant on the AMD driver)
float EnergyAt(int k) { const vec2 t = imageLoad(lampImage, ivec2(32 + (k >> 1), kFrameRow)).rg; return (k & 1) != 0 ? t.y : t.x; }
float SpecE(float nv, float rough) {
	if ((uint(p.accum.w) & 1048576u) == 0u) return 1.0;   // no table this frame: no compensation
	const vec2 f = vec2(clamp(nv, 0.0, 1.0) * 31.0, clamp(rough, 0.0, 1.0) * 15.0);
	const ivec2 i = min(ivec2(f), ivec2(30, 14));
	const vec2 w = f - vec2(i);
	float e[4];   // (merge 2026-11-07, the size fix: one EnergyAt site) e00, e10, e01, e11
	for (int c = 0; c < 4; c++) e[c] = EnergyAt((i.y + (c >> 1)) * 32 + i.x + (c & 1));
	const float e00 = e[0], e10 = e[1], e01 = e[2], e11 = e[3];
	return max(mix(mix(e00, e10, w.x), mix(e01, e11, w.x), w.y), 0.05);
}

bool gSpecOnly = false;   // (2026-11-03 rtspec) PTDebugView 8 / 9: BrdfPi without the diffuse part

// UNOFFICIAL 2026-11-07 (ptaaa-denoiser) PTDenoiseSplit (flag 4194304, with PTDenoise's 512): the last BrdfPi's specular part and its
// whole (pi x the BRDF). What a caller adds right after the call is light x BrdfPi x factors common to both parts, so x SpecShare()
// (per channel) is exactly its specular part (the split's direct light and the first bounce's share; main() writes the two signals)
vec3 gBrdfSpec = vec3(0.0), gBrdfAll = vec3(0.0);
vec3 SpecShare() {
	return vec3(gBrdfAll.x > 1.0e-12 ? gBrdfSpec.x / gBrdfAll.x : 0.0, gBrdfAll.y > 1.0e-12 ? gBrdfSpec.y / gBrdfAll.y : 0.0,
		gBrdfAll.z > 1.0e-12 ? gBrdfSpec.z / gBrdfAll.z : 0.0);
}

// pi x the BRDF toward l (seen from v), both away from the surface
vec3 BrdfPi(Surface s, vec3 n, vec3 v, vec3 l) {
	gBrdfSpec = vec3(0.0);   // (ptaaa-denoiser; the early returns below are all diffuse)
	// (2026-11-07 ptaaa-materials) the far side of a thin leaf / ear (DirectSides: its albedo is the transmitted colour T): Lambert
	if (gBackSide) { gBrdfAll = gSpecOnly ? vec3(0.0) : s.albedo; return gBrdfAll; }
	if (s.kind == kKindGlass) { gBrdfAll = vec3(0.0); return gBrdfAll; }   // a smooth pane reflects and transmits like a mirror (NextDirection): no light sample meets it
	const vec3 base = s.kind == kKindFoliage || s.kind == kKindSkin ? ReflectColour(s) : s.albedo;
	const vec3 shape = s.kind == kKindSkin && !gBounceEval ? SkinWrapPi(dot(n, l)) : vec3(1.0);   // skin's wrap (light samples)
	if (!Specular()) { gBrdfAll = gSpecOnly ? vec3(0.0) : base * shape; return gBrdfAll; }
	vec3 diffuse = base * (1.0 - s.metal) * shape;
	float nl = max(dot(n, l), 1.0e-4), nv = max(dot(n, v), 1.0e-4);
	vec3 h = normalize(v + l);
	float nh = max(dot(n, h), 0.0), vh = max(dot(v, h), 0.0);
	float a = max(s.rough * s.rough, 0.002), a2 = a * a;
	vec3 F = FresnelF0(s) + (1.0 - FresnelF0(s)) * pow(1.0 - vh, 5.0);
	vec3 spec = F * (GgxD(nh, a2) * SmithG1(nl, a2) * SmithG1(nv, a2) / (4.0 * nl * nv));
	spec *= 1.0 + FresnelF0(s) * (1.0 / SpecE(nv, s.rough) - 1.0);   // (2026-11-07) the light of multiple scattering
	if (s.kind == kKindCloth) {   // (2026-11-07 ptaaa-materials) the sheen lobe on top, the diffuse giving up its share (the split: specular)
		const vec3 sheen = clamp(MatSheen(), 0.0, 1.0) * sqrt(max(s.albedo, vec3(0.0)));
		diffuse *= 1.0 - max(max(sheen.r, sheen.g), sheen.b) * SheenAlbedoBound(nv);
		spec += sheen * (SheenD(nh, clamp(s.rough, 0.3, 1.0)) * SheenV(nl, nv));
	}
	gBrdfSpec = 3.14159265 * spec;   // (ptaaa-denoiser)
	gBrdfAll = (gSpecOnly ? vec3(0.0) : diffuse * (1.0 - F)) + gBrdfSpec;
	return gBrdfAll;
}

// (ptaaa-denoiser) PTDenoiseSplit's capture: while gSplitTake (the first hit's Direct only) each light added also adds its specular
// part to gSplitSpec. A light added without the macro counts as diffuse (the sum stays exact; only the split is coarser).
bool Split() { return (uint(p.accum.w) & 4194304u) != 0u; }
bool gSplitTake = false;
vec3 gSplitSpec = vec3(0.0);
#define PT_DIRECT_ADD(E, X) { const vec3 add_ = (X); E += add_; if (gSplitTake) gSplitSpec += add_ * SpecShare(); }

// (2026-11-07) a half vector from GGX's VISIBLE normals (Heitz 2018, "Sampling the GGX distribution of visible normals"): every sample faces
// v, so far fewer go under the surface than with the plain NDF (rough metal at grazing angles was the noisiest), and the path weight
// becomes G1(l) x the compensation. Its density for l: G1(v) D(h) / (4 nv) (BsdfPdf).
vec3 SampleVndf(vec3 n, vec3 v, float a, vec2 u) {
	vec3 b, t = Basis(n, b);
	const vec3 vl = vec3(dot(v, t), dot(v, b), max(dot(v, n), 1.0e-4));
	const vec3 vh = normalize(vec3(a * vl.x, a * vl.y, vl.z));
	const float lensq = vh.x * vh.x + vh.y * vh.y;
	const vec3 t1 = lensq > 0.0 ? vec3(-vh.y, vh.x, 0.0) * inversesqrt(lensq) : vec3(1.0, 0.0, 0.0);
	const vec3 t2 = cross(vh, t1);
	const float r = sqrt(u.x), phi = 6.2831853 * u.y;
	const float p1 = r * cos(phi), s = 0.5 * (1.0 + vh.z);
	const float p2 = (1.0 - s) * sqrt(max(1.0 - p1 * p1, 0.0)) + s * (r * sin(phi));
	const vec3 nh = p1 * t1 + p2 * t2 + sqrt(max(1.0 - p1 * p1 - p2 * p2, 0.0)) * vh;
	const vec3 hl = normalize(vec3(a * nh.x, a * nh.y, max(nh.z, 0.0)));
	return normalize(t * hl.x + b * hl.y + n * hl.z);
}

// The specular lobe's share of the one-sample mixture NextDirection uses
// (2026-11-09 pt-mirrors) with PTDenoiseMirrorSurface on (gMirrorSurface > 0): a pure metal (metal >= 0.99: its diffuse part
// (1 - metal) x albedo is nil) always takes its specular lobe. At the 0.9 cap one bounce ray in ten went down the diffuse lobe, where a
// mirror's BRDF is ~0: a black sample one frame in ten on every mirror and chrome pixel (the dark grain), the other nine x 1.11.
// Unbiased either way (the mixture's density changes with it: BsdfPdf, SpecLobeChance); only the noise goes.
float SpecularShare(Surface s) {
	if (gMirrorSurface > 0.0 && s.metal >= 0.99) return 1.0;
	return clamp(0.15 + 0.7 * s.metal + 0.25 * (1.0 - s.rough), 0.1, 0.9);
}

// (2026-11-03 b) the chance density (per solid angle) that NextDirection picks l: what multiple importance sampling weighs the glow
// light sample against
float BsdfPdf(vec3 n, vec3 v, Surface s, vec3 l) {
	if (s.kind == kKindGlass) return 0.0;   // (2026-11-07 ptaaa-materials) mirror-like lobes: no density in any given direction
	const float q = TransmitChance(s);   // (ptaaa-materials) thin translucent: the far side's cosine lobe with chance q
	float nl = dot(n, l);
	if (nl <= 0.0) return q * max(-nl, 0.0) / 3.14159265;
	if (!Specular()) return (1.0 - q) * nl / 3.14159265;
	float a = max(s.rough * s.rough, 0.002), a2 = a * a, ps = SpecularShare(s);
	vec3 h = normalize(v + l);
	float nh = max(dot(n, h), 0.0), nv = max(dot(n, v), 1.0e-4);
	return (1.0 - q) * (ps * GgxD(nh, a2) * SmithG1(nv, a2) / (4.0 * nv) + (1.0 - ps) * nl / 3.14159265);   // (2026-11-07: the VNDF's density)
}

// (2026-11-07 ptaaa-denoiser) the chance that direction l came from the specular lobe of NextDirection's mixture (its share of the
// mixture's density at l): PTDenoiseSplit writes the bounce ray's hit distance as the specular one only above 0.5 (a metal's diffuse
// lobe sample carries specular light, but its hit is not the reflection's)
float SpecLobeChance(vec3 n, vec3 v, Surface s, vec3 l) {
	const float nl = dot(n, l);
	if (!Specular() || nl <= 0.0) return 0.0;
	const float a = max(s.rough * s.rough, 0.002), a2 = a * a, ps = SpecularShare(s);
	const vec3 h = normalize(v + l);
	const float nh = max(dot(n, h), 0.0), nv = max(dot(n, v), 1.0e-4);
	const float pS = ps * GgxD(nh, a2) * SmithG1(nv, a2) / (4.0 * nv), pD = (1.0 - ps) * nl / 3.14159265;
	return pS / max(pS + pD, 1.0e-20);
}

// The next direction from a hit: the diffuse or the specular lobe (one-sample mixture), the throughput's factor (BRDF x cos / pdf).
// false: the path ends (the sample went under the surface). (2026-11-03 b) pdf: the direction's chance density (BsdfPdf).
// (2026-11-07 ptaaa-materials) l may now point to the FAR side (glass let through, a leaf's transmission): Path then starts the next ray
// from the far side's face.
bool NextDirectionReflect(vec3 n, vec3 v, Surface s, float q, out vec3 l, out vec3 weight, out float pdf);
bool NextDirection(vec3 n, vec3 v, Surface s, out vec3 l, out vec3 weight, out float pdf) {
	pdf = 0.0;
	if (s.kind == kKindGlass) {   // the pane: mirror reflection or straight through, chosen in proportion to R and T (each then weighs R / P, T / (1 - P))
		vec3 R, T;
		GlassSlab(abs(dot(n, v)), s.albedo, R, T);
		const float pr = Luma(R) / max(Luma(R) + Luma(T), 1.0e-6);
		if (Rand() < pr) { l = reflect(-v, n); weight = R / max(pr, 1.0e-6); }
		else { l = -v; weight = T / max(1.0 - pr, 1.0e-6); }
		gBrdfSpec = gBrdfAll = vec3(1.0);   // (ptaaa-denoiser's split: both mirror-like lobes count as specular)
		pdf = 1.0e6;   // (a glow light met along a mirror-like lobe keeps its full weight: no light sample could have found it)
		return true;
	}
	const float q = TransmitChance(s);
	if (q > 0.0 && Rand() < q) {   // through a thin leaf / ear: the far side's cosine lobe
		l = CosineDirection(-n, vec2(Rand(), Rand()));
		pdf = q * max(-dot(n, l), 0.0) / 3.14159265;
		weight = TransmitColour(s) / q;
		gBrdfSpec = vec3(0.0); gBrdfAll = vec3(1.0);   // (ptaaa-denoiser's split: diffuse)
		return true;
	}
	gBounceEval = true;
	const bool going = NextDirectionReflect(n, v, s, q, l, weight, pdf);
	gBounceEval = false;
	return going;
}

// The lit side's lobes (the diffuse and GGX mixture, as before 2026-11-07), taken with chance 1 - q (the weight and pdf include it)
bool NextDirectionReflect(vec3 n, vec3 v, Surface s, float q, out vec3 l, out vec3 weight, out float pdf) {
	pdf = 0.0;
	if (!Specular()) { l = CosineDirection(n, vec2(Rand(), Rand())); weight = BrdfPi(s, n, v, l) / (1.0 - q); pdf = (1.0 - q) * max(dot(n, l), 0.0) / 3.14159265; return true; }
	float a = max(s.rough * s.rough, 0.002), a2 = a * a;
	float ps = SpecularShare(s);
	if (Rand() < ps) {
		const vec2 u = vec2(Rand(), Rand());
		l = reflect(-v, SampleVndf(n, v, a, u));   // (2026-11-07: visible normals, was the plain NDF)
	}
	else l = CosineDirection(n, vec2(Rand(), Rand()));
	float nl = dot(n, l);
	weight = vec3(0.0);
	if (nl <= 0.0) return false;
	pdf = BsdfPdf(n, v, s, l);
	weight = BrdfPi(s, n, v, l) * (nl / (3.14159265 * max(pdf, 1.0e-6)));
	return true;
}

// ---- UNOFFICIAL 2026-11-03 b PTGlowLights: glowing meshes as lights.
// The lamp image holds, after the lamps, rect.z glow lights: each glow-mapped mesh's world bound sphere (centre, radius) and a guess
// of its light (only steers how often it is picked). At every hit ONE glow light is picked (its own one-pass reservoir, apart from
// the lamps' pick: rtpt-glow2 showed one shared pick took samples from the lamps and made the lamp-lit floor noisier), a direction is
// sent into its sphere, and where that ray meets a glowing surface the sphere holds, the surface's real glow counts (the glow atlas
// x PTGlow: the sphere only says WHERE to look, the light comes from the mesh itself). A bounce ray that meets the same glowing
// point counts it too; both are weighed by multiple importance sampling (balance heuristic: each counts f / (pdf_light + pdf_bounce)),
// so the sum is unbiased, and wherever the sphere aim is poor (a thin neon tube in a big sphere: most aimed rays miss the glow) the
// bounce ray's share takes over: never much worse than without the light sample.
vec4 GlowSphere(int k) {
	int i = LampCount() + k;
	return vec4(imageLoad(lampImage, ivec2(4 * i, 0)).rg, imageLoad(lampImage, ivec2(4 * i + 1, 0)).rg);
}

// The pick weight of glow light k from a hit: its guessed colour x r^2 / d^2 x the cosine toward its centre, counting the part of the
// sphere above the surface (never 0 while any of it is: the light sample must be able to reach every point it owns)
float GlowWeight(vec4 sphere, vec3 guess, vec3 hit, vec3 n) {
	vec3 l = sphere.xyz - hit;
	float dist = length(l), r = sphere.w, c = dist > r ? clamp(dot(n, l) / dist + r / dist, 0.0, 1.0) : 1.0;
	return dot(guess, vec3(0.2126, 0.7152, 0.0722)) * (r * r / max(dist * dist, r * r) * c);
}
float GlowWeight(int k, vec3 hit, vec3 n) {
	int i = LampCount() + k;
	vec3 guess = vec3(imageLoad(lampImage, ivec2(4 * i + 2, 0)).rg, imageLoad(lampImage, ivec2(4 * i + 3, 0)).r);
	return GlowWeight(GlowSphere(k), guess, hit, n);
}

// Which glow light owns a glowing point: the first sphere that holds it, -1 none (only that light's sample counts the point:
// overlapping spheres would count it twice). Points no sphere holds are found by bounce rays alone, at full weight.
int GlowOwner(vec3 at) {
	int glows = GlowLightCount();
	for (int k = 0; k < glows; k++) {
		vec4 sphere = GlowSphere(k);
		vec3 d = at - sphere.xyz;
		if (dot(d, d) <= sphere.w * sphere.w) return k;
	}
	return -1;
}

// The chance density (per solid angle, from `lift`) that the glow sample sends its ray along l toward sphere k: uniform in the cone
// the sphere fills, or cosine-weighted from inside it. pick = the chance glow light k was picked.
float GlowConePdf(vec4 sphere, vec3 lift, vec3 n, vec3 l) {
	vec3 toC = sphere.xyz - lift;
	float dist = length(toC), r = sphere.w;
	if (dist <= r * 1.001) return max(dot(n, l), 0.0) / 3.14159265;
	float cosMax = sqrt(max(1.0 - r * r / (dist * dist), 0.0));
	return dot(l, toC / dist) >= cosMax ? 1.0 / (6.2831853 * (1.0 - cosMax)) : 0.0;
}

// Glow light `index` (picked with chance `pick`) at a hit, MIS-weighted against the bounce ray
vec3 GlowSample(vec3 lift, vec3 n, vec3 v, Surface s, vec4 sphere, int index, float pick) {
	vec3 toC = sphere.xyz - lift;
	float dist = length(toC), r = sphere.w;
	vec3 l;
	if (dist <= r * 1.001) l = CosineDirection(n, vec2(Rand(), Rand()));
	else {
		float cosMax = sqrt(max(1.0 - r * r / (dist * dist), 0.0));
		float cosT = 1.0 - Rand() * (1.0 - cosMax), sinT = sqrt(max(1.0 - cosT * cosT, 0.0)), phi = 6.2831853 * Rand();
		vec3 axis = toC / dist, b, tg = Basis(axis, b);
		l = normalize(tg * (sinT * cos(phi)) + b * (sinT * sin(phi)) + axis * cosT);
	}
	float c = dot(n, l);
	if (c <= 0.0) return vec3(0.0);
	rayQueryEXT q;
	PT_RAY_INIT(q, AlphaTest() ? 0u : gl_RayFlagsOpaqueEXT, 0xFFu, lift + p.origin.xyz, 0.0, l, dist + r)   // (hangfix)
	ProceedShadow(q);
	if (rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionTriangleEXT) return vec3(0.0);
	uint instance = rayQueryGetIntersectionInstanceIdEXT(q, true);
	if ((records[instance].flags & RT_HIT_GLOW_FLAG) == 0u) return vec3(0.0);   // something in the way, or a part with no glow map
	if (GlowOwner(lift + l * rayQueryGetIntersectionTEXT(q, true)) != index) return vec3(0.0);
	vec3 glow = rtHitGlow(instance, uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, true)), rayQueryGetIntersectionBarycentricsEXT(q, true));
	// f / (pdf_light + pdf_bounce), f = glow x pi x BRDF x cos / pi (the game's units fold pi into the light)
	float pdf = pick * GlowConePdf(sphere, lift, n, l) + BsdfPdf(n, v, s, l);
	return glow * p.skyHorizon.w * BrdfPi(s, n, v, l) * (c / (3.14159265 * max(pdf, 1.0e-8)));
}

float gGlowTotal;   // (2026-11-03 b) the last Direct()'s glow pick total (the bounce ray's MIS weight at the next hit needs it)
int gBounce = 0;    // (perf-ptcost) the path vertex Direct() lights (0: the first hit), set by Path()
ivec2 gPixel;   // the pixel this thread traces (ScreenHit)

// UNOFFICIAL 2026-11-07 the flashlight (RtPathTrace.cpp Lamps): always lamp 0 when it is on; its cone in the frame row's texel 15 .x
// (the lamp image: the lamp texels' spare word carries ReSTIR's number remap) or lampColor[0].w (no lamp image): 1 + (angle x 512 + u)
// x 512 + v, the cone's half-angle in degrees and its direction octahedral, 9 bits each; 0 = no flashlight. The share of lamp k reaching
// `toPoint` (lamp -> point, unit): full inside half the cone, nothing outside it, smooth between (as the game's own flashlight pass)
float LampSpot(int k, vec3 toPoint) {
	if (k != 0) return 1.0;
	const float code = LampImage() ? FrameTexel(15).x : p.lampColor[0].w;
	if (code < 0.5) return 1.0;
	const uint c = uint(code - 1.0 + 0.5);
	const vec2 e = vec2(float((c >> 9u) & 511u), float(c & 511u)) / 511.0 * 2.0 - 1.0;
	vec3 d = vec3(e, 1.0 - abs(e.x) - abs(e.y));
	if (d.z < 0.0) d.xy = (1.0 - abs(d.yx)) * vec2(d.x >= 0.0 ? 1.0 : -1.0, d.y >= 0.0 ? 1.0 : -1.0);
	const float angle = radians(float(c >> 18u));
	return smoothstep(cos(angle), cos(0.5 * angle), dot(normalize(d), toPoint));
}
// UNOFFICIAL 2026-11-11 the flashlight's NearFade and HotspotLimit ([Shaders.Flashlight.Main] / .Interiors, the old flashlight's keys), frame
// row texel 31 (x NearFade in units, y HotspotLimit; 0 off; RtPathTrace.cpp writes them only while lamp 0 is the flashlight): lamp 0's
// light at `dist` from it, as FlashlightDeferred.hlsl shapes it. The knee here acts on the light arriving (before the surface's colour), the
// raster pass's on the light it adds. Both 0 (or no lamp image: no row) = the light unchanged.
vec3 FlashShape(int k, float dist, vec3 light) {
	if (k != 0 || !LampImage()) return light;
	const vec2 t = FrameTexel(31);
	if (t.x > 0.0) light *= smoothstep(0.0, t.x, dist);
	if (t.y > 0.0) { const float limit = 1.0 / t.y; light *= limit / max(limit, dot(light, vec3(0.2126, 0.7152, 0.0722))); }
	return light;
}

#ifndef PT_RESTIR_GI
// ---- UNOFFICIAL 2026-11-07 (ptaaa-emissive) PTEmissive: glowing TRIANGLES as lights (RT-PATH-TRACING.md section "ptaaa-emissive";
// src/core/RtEmissiveRow.h has the data, RtEmissiveBuild.comp builds the list each frame before this pass). At a hit ONE emissive sample, as
// RTXDI samples emissive triangles: an instance in proportion to its total power x the share of its bound sphere above the surface /
// max(d^2, r^2) (a one-pass reservoir over all of them: the exact chance is known), a triangle in proportion to its power (binary search in
// the instance's running sums), a uniform point on it; the light there is the glow map's texel (finest mip) x PTGlow, one shadow ray. Its
// density per solid angle: chance x share / area x d^2 / |cos at the light|. A bounce ray that meets the same triangle evaluates the same
// density (the record's bits 8-15 name the instance) and the two are weighed by the balance heuristic, so neither counts the light twice;
// where the path ends at this hit (its last bounce, DebugView 3) the light sample counts in full. At the first hit with PTRestirDI the sample
// is a candidate of ReSTIR DI next to the lamp loop's (RestirDirect) and a bounce ray from there that meets a listed triangle counts nothing
// (that light is all ReSTIR's; the radiance cache still gets its balance share). Replaces PTGlowLights' bound spheres (the C++ turns them off).
const int kEmissiveRow = 50;   // RtEmissiveRow.h kRow (after the frame row)
// ---- (ptaaa-hangfix) the scratch store's layout as this frame's keys give it, checked once a thread (LoadScratchLayout, main's start): each
// region (ReSTIR DI's reservoirs, the radiance cache's table, PTEmissive's blocks + list) must lie inside the store and clear of the
// reservoirs (and the emissive one clear of the cache); a region that does not is off this frame. Same answers wherever the host's layout
// is right (core\RtPathTrace.cpp CacheBaseWords / EmissiveBaseWords). (tools/nvr-rt-playground sized its reservoirs for the old 4 words a
// pixel: its cache's first entries lay under the second reservoir set, each pass writing over the other's words.)
const uint kEmMax = 128u, kEmTriangles = 65536u, kEmWords = 128u * 32u + 65536u;   // RtEmissiveRow.h kMax, kTrianglesMax, kScratchWords
bool gScratchRestir = false, gScratchCache = false;
uint gCacheBase = 0u, gCacheMask = 0u, gEmBase = 0u;
int gEmCount = 0;
void LoadScratchLayout() {
	if (!LampImage()) return;
	const uint total = uint(scratch.words.length());
	const float pages = float(total / 4096u);   // (bases are in 4096-word pages: compared as floats first, no uint overflow)
	const uint reservoirs = 12u * uint(max(p.size.x, 0.0)) * uint(max(p.size.y, 0.0));   // two sets of 6 words a pixel (ReservoirWord)
	const bool restir = (uint(p.accum.w) & 262144u) != 0u;
	gScratchRestir = reservoirs <= total;
	const vec2 c9 = FrameTexel(9), c12 = FrameTexel(12);
	if ((uint(p.accum.w) & 524288u) != 0u && c9.y >= 0.5 && c9.y <= 22.5 && c12.y >= 0.0 && c12.y <= pages) {
		const uint base = uint(c12.y + 0.5) * 4096u, entries = 1u << uint(c9.y + 0.5);
		if (base + 16u * entries <= total && (!restir || base >= reservoirs)) { gScratchCache = true; gCacheBase = base; gCacheMask = entries - 1u; }
	}
	const vec2 e22 = FrameTexel(22);
	// (flag 8388608: RtPathTrace.cpp could not add the list's build pass this frame: the blocks are last frame's, never read)
	if (e22.x >= 0.5 && e22.y >= 0.0 && e22.y <= pages && (uint(p.accum.w) & 8388608u) == 0u) {
		const uint base = uint(e22.y + 0.5) * 4096u, cacheEnd = gCacheBase + 16u * (gCacheMask + 1u);
		if (base + kEmWords <= total && (!restir || base >= reservoirs) && (!gScratchCache || base >= cacheEnd || base + kEmWords <= gCacheBase)) {
			gEmBase = base;
			gEmCount = PtCount(e22.x, int(kEmMax));
		}
	}
}
int EmCount() { return gEmCount; }   // (hangfix: was the frame row's texel 22 .x, unchecked)
uint EmBlock(int e) { return gEmBase + uint(e) * 32u; }
uint EmList() { return gEmBase + kEmMax * 32u; }
float EmF(uint w) { return uintBitsToFloat(scratch.words[w]); }
// (hangfix) a block's triangles and their place in the list: 1 .. kEmTriangles, the whole run inside the list (the trace's binary search
// and its CDF reads stay in it)
bool EmListOk(uint b) { const uint tris = scratch.words[b + 6u], first = scratch.words[b + 7u]; return tris >= 1u && tris <= kEmTriangles && first <= kEmTriangles - tris; }
float gEmTotal = 0.0;   // the last pick's instance weights' sum at its hit (a bounce ray's MIS weight at the next hit needs it)
bool gEmMis = true;     // (Path) false: the path ends at this hit, so the light sample counts in full

// Instance e's pick weight from a hit (> 0 wherever any of its bound sphere is above the surface: every point it can light is reachable)
float EmWeight(int e, vec3 hit, vec3 n) {
	const uint b = EmBlock(e);
	if (scratch.words[b] == 0u) return 0.0;
	const vec3 l = vec3(EmF(b + 2u), EmF(b + 3u), EmF(b + 4u)) - p.origin.xyz - hit;
	const float r = EmF(b + 5u), dist = length(l);
	const float c = dist > r ? clamp(dot(n, l) / dist + r / dist, 0.0, 1.0) : 1.0;
	return EmF(b + 1u) * c / max(dist * dist, r * r);
}
// Instance e's triangle `prim` in scene space: its record, corners; false: not listed
bool EmTriangle(int e, uint prim, out uint g, out vec3 a, out vec3 b, out vec3 c) {
	const uint k = EmBlock(e);
	g = scratch.words[k];
	a = b = c = vec3(0.0);
	if (g == 0u || prim >= scratch.words[k + 6u]) return false;
	g -= 1u;
	// (hangfix) a record of this frame's list with its geometry data (the build pass checks both; a stale block must not index past them)
	// (RtEmissiveBuild.comp lists an instance only when every one of its triangles lies inside the geometry data)
	if (g >= uint(records.length()) || records[g].vertexOffset == 0xFFFFFFFFu) return false;
	const vec4 r0 = vec4(EmF(k + 8u), EmF(k + 9u), EmF(k + 10u), EmF(k + 11u));
	const vec4 r1 = vec4(EmF(k + 12u), EmF(k + 13u), EmF(k + 14u), EmF(k + 15u));
	const vec4 r2 = vec4(EmF(k + 16u), EmF(k + 17u), EmF(k + 18u), EmF(k + 19u));
	const uvec3 i = rtHitTriangle(g, prim);
	const vec3 o0 = rtHitObjectPosition(g, i.x), o1 = rtHitObjectPosition(g, i.y), o2 = rtHitObjectPosition(g, i.z);
	a = vec3(dot(r0.xyz, o0) + r0.w, dot(r1.xyz, o0) + r1.w, dot(r2.xyz, o0) + r2.w) - p.origin.xyz;
	b = vec3(dot(r0.xyz, o1) + r0.w, dot(r1.xyz, o1) + r1.w, dot(r2.xyz, o1) + r2.w) - p.origin.xyz;
	c = vec3(dot(r0.xyz, o2) + r0.w, dot(r1.xyz, o2) + r1.w, dot(r2.xyz, o2) + r2.w) - p.origin.xyz;
	return true;
}
// Triangle prim's share of instance e's power
float EmShare(int e, uint prim) {
	const uint k = EmBlock(e);
	if (!EmListOk(k)) return 0.0;   // (hangfix)
	const uint at = EmList() + scratch.words[k + 7u] + prim;
	const float total = EmF(k + 1u);
	return total > 0.0 && prim < scratch.words[k + 6u] ? max(EmF(at) - (prim > 0u ? EmF(at - 1u) : 0.0), 0.0) / total : 0.0;
}
// The emissive instance of a traced hit's record (-1: none listed this frame)
int EmOf(uint instance) {
	const uint f = records[instance].flags;
	if ((f & 0x24u) != 0x04u) return -1;   // (glow, not alpha-tested: bits 8-15 are its alpha reference there)
	const int e = int((f >> 8) & 0xFFu) - 1;
	return e >= 0 && e < EmCount() && scratch.words[EmBlock(e)] == instance + 1u ? e : -1;
}
// A point of instance e's triangle prim: where (scene space), its triangle's unit normal and area, its record; false: not listed
bool EmPoint(int e, uint prim, vec2 bary, out vec3 pos, out vec3 ny, out float area, out uint g) {
	vec3 a, b, c;
	pos = ny = vec3(0.0); area = 0.0;
	if (!EmTriangle(e, prim, g, a, b, c)) return false;
	const vec3 x = cross(b - a, c - a);
	area = 0.5 * length(x);
	if (!(area > 0.0)) return false;
	ny = x / (2.0 * area);
	pos = a * (1.0 - bary.x - bary.y) + b * bary.x + c * bary.y;
	return true;
}
// Its light: the glow texel there (the finest mip: the exact radiance) x PTGlow
vec3 EmLe(uint g, uint prim, vec2 bary) {
#ifndef RT_NO_REAL_TEXTURES
	const float cw = rtConeWidth; const vec3 cd = rtConeDir;
	rtConeWidth = 0.0; rtConeDir = vec3(0.0);
#endif
	const vec3 le = max(rtHitGlow(g, prim, bary), vec3(0.0)) * p.skyHorizon.w;
#ifndef RT_NO_REAL_TEXTURES
	rtConeWidth = cw; rtConeDir = cd;
#endif
	return le;
}
// One emissive sample from a hit: instance, triangle, point (barycentrics quantized as the reservoirs keep them) and its density per unit
// area; sets gEmTotal. false: nothing to sample
bool EmPick(vec3 hit, vec3 n, out int e, out uint prim, out vec2 bary, out float pdfArea) {
	e = -1; prim = 0u; bary = vec2(0.0); pdfArea = 0.0;
	const int count = EmCount();
	float total = 0.0, chosen = 0.0;
	for (int k = 0; k < count; k++) {
		const float w = EmWeight(k, hit, n);
		if (!(w > 0.0)) continue;
		total += w;
		if (Rand() * total < w) { e = k; chosen = w; }
	}
	gEmTotal = total;
	if (e < 0) return false;
	const uint b = EmBlock(e);
	if (!EmListOk(b)) return false;   // (hangfix: a block whose run leaves the list gives no sample; the build never writes one)
	const uint list = EmList() + scratch.words[b + 7u], tris = scratch.words[b + 6u];
	const float u = Rand() * EmF(b + 1u);
	uint lo = 0u, hi = tris - 1u;
	// (hangfix) at most 32 halvings (17 cover kEmTriangles): a NaN in the sums only steers the search, never past the run
	for (int it = 0; it < 32 && lo < hi; it++) { const uint mid = (lo + hi) >> 1; if (EmF(list + mid) > u) hi = mid; else lo = mid + 1u; }
	prim = lo;
	const vec2 r = vec2(Rand(), Rand());
	const float su = sqrt(r.x);
	bary = unpackUnorm2x16(packUnorm2x16(vec2(su * (1.0 - r.y), su * r.y)));
	const float share = EmShare(e, prim);
	uint g; vec3 a, bb, c;
	if (!(share > 0.0) || !EmTriangle(e, prim, g, a, bb, c)) return false;
	const float area = 0.5 * length(cross(bb - a, c - a));
	if (!(area > 0.0)) return false;
	pdfArea = chosen / total * share / area;
	return true;
}
// The emissive light at a hit by one sample (no ReSTIR; EmPick drew it), MIS-weighted against the bounce ray (gEmMis) or in full, UNSHADOWED:
// Direct traces its shadow ray (dir, its length tMax) with the other light samples' (perf-ptcost). select: the chance Direct traces this
// sample (PTBounceLights 0; else 1): the light sample's density is select x pdf in the balance heuristic; Direct divides by select.
float gEmSelect = 1.0;   // (perf-ptcost) the last Direct's select (the bounce ray's MIS weight at the next hit needs it, with gEmTotal)
vec3 EmissiveCandidate(vec3 lift, vec3 n, vec3 v, Surface s, int e, uint prim, vec2 bary, float pdfArea, float select, out vec3 dir, out float tMax, out vec3 spec) {
	dir = vec3(0.0, 0.0, 1.0); tMax = 0.0; spec = vec3(0.0);
	vec3 pos, ny; float area; uint g;
	if (!EmPoint(e, prim, bary, pos, ny, area, g)) return vec3(0.0);
	vec3 l = pos - lift;
	const float d2 = dot(l, l);
	if (!(d2 > 1.0e-6)) return vec3(0.0);
	const float d = sqrt(d2);
	l /= d;
	const float cx = dot(n, l), cy = abs(dot(ny, l));
	if (cx <= 0.0 || cy <= 1.0e-6) return vec3(0.0);
	const vec3 le = EmLe(g, prim, bary);
	if (!(dot(le, vec3(1.0)) > 0.0)) return vec3(0.0);
	dir = l; tMax = max(d * 0.998 - 0.02, 0.0);
	const float pdf = pdfArea * d2 / cy;
	const float m = gEmMis ? select * pdf / (select * pdf + BsdfPdf(n, v, s, l)) : 1.0;
	const vec3 c = le * BrdfPi(s, n, v, l) * (cx * m / (3.14159265 * pdf));
	spec = SpecShare();
	return c;
}
// The density (per solid angle) with which the previous hit's light sample (EmissiveSample at prevHit / prevN, its weights' sum prevTotal)
// would have drawn the glowing point a bounce ray from there met (instance, prim) at distance t along dir; 0: it cannot draw it
float EmPdfAt(uint instance, uint prim, vec3 dir, float t, vec3 prevHit, vec3 prevN, float prevTotal) {
	if (!(prevTotal > 0.0)) return 0.0;
	const int e = EmOf(instance);
	if (e < 0) return 0.0;
	const float share = EmShare(e, prim);
	if (!(share > 0.0)) return 0.0;
	uint g; vec3 a, b, c;
	if (!EmTriangle(e, prim, g, a, b, c)) return 0.0;
	const vec3 x = cross(b - a, c - a);
	const float area = 0.5 * length(x);
	if (!(area > 0.0)) return 0.0;
	const float cy = abs(dot(x / (2.0 * area), dir));
	if (cy <= 1.0e-6) return 0.0;
	return EmWeight(e, prevHit, prevN) / prevTotal * share / area * t * t / cy;
}

// ---- UNOFFICIAL 2026-11-07 PTRestirDI: ReSTIR DI for the lamps at the first hit (RT-PATH-TRACING.md section 47; Bitterli et al. 2020,
// as RTXDI does it). The lamp loop's pick stays the first candidate (resampled importance sampling over EVERY lamp in reach: the source
// density is its unshadowed diffuse light / the total), resampled to the target p = the luminance of its light through the full BRDF
// (GGX highlights included). Its shadow ray is traced at once: an occluded candidate keeps its count M, not its weight (RTXDI's initial
// visibility), so the reservoirs remember lamps that really light the pixel. Then last frame's reservoir at the reprojected pixel and
// PTRestirDISpatial of its neighbours (within PTRestirDIRadius pixels) are merged, each where its surface is this one (plane distance and
// normal tests), its lamp still in the list (the CPU's remap of lamp numbers) and its count capped at PTRestirMaxM. The chosen lamp gets
// one shadow ray (none when it is the visible first candidate): occluded, the reservoir is kept with W = 0. 1 / M weights (the classic
// estimator; section 47 measures it against the exact sum).
// (2026-11-07 ptaaa-emissive) The light samples are lamps OR points on emissive triangles (PTEmissive): one light space, the emissive pick a
// second canonical candidate (its own domain, so both count with MIS weight 1: wSum = t_lamp / p_lamp + t_em / p_em); an emissive sample's
// light is per unit area (Le cos cos' / (pi d^2)) and its density per unit area. A reservoir names it by instance (remapped by the CPU as the
// lamps), triangle and barycentrics, so a reused sample is rebuilt on this frame's triangle (moving glow follows).
bool RestirDI() { return (uint(p.accum.w) & 262144u) != 0u && LampImage() && gScratchRestir; }   // (hangfix: + the reservoirs fit the store)
bool gRestirFirst = false;   // Direct() at the path's first hit, the picture views (PTRestirDI)
int FrameParity() { return int(FrameTexel(7).y + 0.5) & 1; }

// Lamp k's light at a surface point (colour x falloff x cos): false out of its reach or behind the surface
bool LampAt(int k, vec3 hit, vec3 n, out vec3 light, out vec3 pos) {
	vec2 a = imageLoad(lampImage, ivec2(4 * k, 0)).rg, b = imageLoad(lampImage, ivec2(4 * k + 1, 0)).rg;
	vec2 c = imageLoad(lampImage, ivec2(4 * k + 2, 0)).rg, d = imageLoad(lampImage, ivec2(4 * k + 3, 0)).rg;
	pos = vec3(a, b.x);
	light = vec3(0.0);
	vec3 l = pos - hit;
	const float dist = length(l), reach = b.y;
	if (dist >= reach || dist < 1.0e-3) return false;
	light = FlashShape(k, dist, vec3(c, d.x) * (LampFall(dist / reach) * max(dot(n, l / dist), 0.0) * LampSpot(k, -l / dist)));   // (2026-11-11 FlashShape)
	return dot(light, vec3(0.2126, 0.7152, 0.0722)) > 0.0;
}
// (ptaaa-emissive) a light sample: lamp >= 0 a lamp; em >= 0 instance em's triangle tri at bary; neither: none
struct LSample { int lamp; int em; uint tri; vec2 bary; };
LSample NoSample() { LSample y; y.lamp = -1; y.em = -1; y.tri = 0u; y.bary = vec2(0.0); return y; }
LSample LampSample(int k) { LSample y = NoSample(); y.lamp = k; return y; }
bool Valid(LSample y) { return y.lamp >= 0 || y.em >= 0; }
bool Same(LSample a, LSample b) { return a.lamp == b.lamp && a.em == b.em && (a.em < 0 || (a.tri == b.tri && a.bary == b.bary)); }
// Sample y's light at a surface point and where it is: a lamp as LampAt; an emissive point Le cos cos' / (pi d^2) (per unit area), seen
// from the point lifted as the rays leave it (as EmissiveSample and the bounce rays: the same integrand)
bool LightAt(LSample y, vec3 at, vec3 n, out vec3 light, out vec3 pos) {
	if (y.lamp >= 0) return LampAt(y.lamp, at, n, light, pos);
	light = vec3(0.0); pos = vec3(0.0);
	if (y.em < 0) return false;
	vec3 ny; float area; uint g;
	if (!EmPoint(y.em, y.tri, y.bary, pos, ny, area, g)) return false;
	vec3 l = pos - (at + n * (1.0 + 0.002 * length(at)));
	const float d2 = dot(l, l);
	if (!(d2 > 1.0e-6)) return false;
	l *= inversesqrt(d2);
	const float cx = dot(n, l), cy = abs(dot(ny, l));
	if (cx <= 0.0 || cy <= 1.0e-6) return false;
	light = EmLe(g, y.tri, y.bary) * (cx * cy / (3.14159265 * d2));
	return dot(light, vec3(0.2126, 0.7152, 0.0722)) > 0.0;
}
// The shadow ray's length to a sample's point from `from`: a lamp short of its fixture, an emissive point just short of its surface
float LightGap(LSample y, float d) { return y.lamp >= 0 ? max(d - 16.0, 0.0) : max(d * 0.998 - 0.02, 0.0); }
float RestirTarget(vec3 light, vec3 pos, vec3 hit, Surface s, vec3 n, vec3 v) {
	return dot(light * BrdfPi(s, n, v, normalize(pos - hit)), vec3(0.2126, 0.7152, 0.0722));
}
vec2 OctEncode(vec3 n) {
	n /= abs(n.x) + abs(n.y) + abs(n.z);
	return n.z >= 0.0 ? n.xy : (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
}
vec3 OctDecode(vec2 e) {
	vec3 n = vec3(e, 1.0 - abs(e.x) - abs(e.y));
	if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
	return normalize(n);
}
// (2026-11-07 ptaaa-emissive) 6 words a reservoir (was 4): [0] the sample's code (0 none, lamp + 1, 0x8000 | emissive instance) | M << 16,
// [1] W, [2] the surface's distance, [3] its normal (octahedral), [4] the emissive sample's triangle, [5] its barycentrics (2 x unorm16)
uint ReservoirWord(int set, ivec2 px) { return 6u * (uint(set) * uint(p.size.x) * uint(p.size.y) + uint(px.y) * uint(p.size.x) + uint(px.x)); }
void StoreReservoir(LSample y, float M, float W, float dist, vec3 n) {
	const uint at = ReservoirWord(FrameParity(), gPixel);
	const uint code = y.lamp >= 0 ? uint(y.lamp + 1) : y.em >= 0 ? 0x8000u | uint(y.em) : 0u;
	scratch.words[at] = code | (uint(clamp(M, 0.0, 65535.0)) << 16);
	scratch.words[at + 1u] = floatBitsToUint(W);
	scratch.words[at + 2u] = floatBitsToUint(dist);
	scratch.words[at + 3u] = packSnorm2x16(OctEncode(n));
	scratch.words[at + 4u] = y.tri;
	scratch.words[at + 5u] = packUnorm2x16(y.bary);
}
void ClearReservoir() { scratch.words[ReservoirWord(FrameParity(), gPixel)] = 0u; }

// The direct light (lamps, PTEmissive's glow) leaving the first hit toward v (shadowed), by ReSTIR DI. k0: the lamp loop's pick (-1: none),
// total / w0 its weights. Every target includes VISIBILITY (a light is only picked after a shadow ray from here says it is seen), so the
// chosen sample needs no final ray. Three steps:
//   1. the canonical reservoir: the lamp loop's pick and (PTEmissive) one emissive pick (resampled importance sampling, M = 1);
//   2. temporal: last frame's reservoir at the reprojected pixel, merged with 1 / Z (Z = the counts of the two whose surface could have
//      produced the chosen sample: it reaches it and is not shadowed there);
//   3. spatial: PTRestirDISpatial of last frame's neighbours around the reprojected pixel, merged by PAIRWISE MIS (Lin et al. 2022, as
//      RTXDI does): each neighbour i is weighed against the canonical one only, by the balance heuristic over the unshadowed light x
//      visibility at both surfaces, so a neighbour whose light barely reached it (huge weight W) cannot dominate here.
// Two shadow rays per neighbour at most (its sample from here, the canonical sample from there). Unbiased with these targets.
const int kRestirNeighbours = 8;
float LightLuma(LSample y, vec3 at, vec3 n) { vec3 light, pos; return LightAt(y, at, n, light, pos) ? dot(light, vec3(0.2126, 0.7152, 0.0722)) : 0.0; }
// (perf-ptcost) PTRestirDIRays 0 / 2 / 3: the targets are unshadowed, so "visible from" is "within its reach and in front" (no ray)
bool gRestirVis = true;
bool LightVisibleFrom(LSample y, vec3 at, vec3 n) {
	vec3 light, pos;
	if (!LightAt(y, at, n, light, pos)) return false;
	if (!gRestirVis) return true;
	const vec3 from = at + n * (1.0 + 0.002 * length(at));
	const vec3 l = pos - from;
	const float d = length(l);
	return Visible(from, l / d, LightGap(y, d));
}
// Last frame's sample code -> this frame's sample (the CPU's remaps: lamps in their texel 4j + 3 .g, emissive instances in their entry's float
// 14); none when its light is gone
LSample OldSample(uint code, uint tri, vec2 bary) {
	LSample y = NoSample();
	if (code == 0u) return y;
	if ((code & 0x8000u) != 0u) {
		const int j = int(code & 0x7FFFu);
		if (j >= 128) return y;
		y.em = int(imageLoad(lampImage, ivec2(8 * j + 7, kEmissiveRow)).r + 0.5) - 1;
		y.tri = tri; y.bary = bary;
		if (y.em >= EmCount()) y.em = -1;
		return y;
	}
	if (code > uint(kPtMaxLamps)) return y;   // (hangfix: a code past the lamp image; the CPU's remap never gives one)
	y.lamp = int(imageLoad(lampImage, ivec2(4 * (int(code) - 1) + 3, 0)).g + 0.5) - 1;   // last frame's number -> this frame's
	if (y.lamp >= LampCount()) y.lamp = -1;   // (hangfix: within this frame's lamps, as the remap gives them)
	return y;
}
vec3 RestirDirect(vec3 hit, vec3 lift, vec3 n, vec3 v, Surface s, int k0, float total, float w0) {
	const float maxM = FrameTexel(10).x;
	// (perf-ptcost) PTRestirDIRays (LoadCostKeys): 0 / 1 / 3 visibility in the targets (the shadow rays below; 0 and 3 skip the temporal
	// ones on the same spot, 3 also the neighbours' MIS rays); 2 unshadowed targets + one final ray
	const int raysMode = RestirRaysMode();
	gRestirVis = raysMode != 2;
	// (perf-ptcost, PTRestirDIRays 3) the canonical candidates (the lamp, the emissive point) are streamed by their unshadowed weights and
	// only the winner gets a shadow ray (one, not one each); occluded, the canonical reservoir holds no sample (M 1). Still a reservoir for
	// the shadowed target: E[g(y) W] = sum_i w_i V_i g(y_i) / t_i = the integral of g x V (the weights' own normalisation, wSum / t). Host:
	// the mean right, 0.6-0.7 rays a pixel fewer with emissive lights, but the emissive scene's ReSTIR run 1.4 x noisier (a visible loser is
	// lost when the winner is shadowed): not in mode 0
	const bool canonOne = raysMode == 3;
	const bool canonEach = gRestirVis && !canonOne;   // (mode 1: a ray for each candidate before it enters, as before)
	// 1. canonical
	LSample y = NoSample();
	float yTarget = 0.0;
	vec3 yLight = vec3(0.0), yPos = vec3(0.0);
	float W = 0.0, M = 1.0, wSum = 0.0;
	if (k0 >= 0 && w0 > 0.0 && total > 0.0) {
		vec3 light, pos;
		if (LampAt(k0, hit, n, light, pos)) {
			const float t = RestirTarget(light, pos, hit, s, n, v);
			const vec3 l = pos - lift;
			const float dist = length(l);
			if (t > 0.0 && (!canonEach || Visible(lift, l / dist, max(dist - 16.0, 0.0)))) {   // (short of its fixture, as Direct)
				y = LampSample(k0); yTarget = t; yLight = light; yPos = pos; wSum = t * total / w0;   // (RIS weight t x total / w0)
			}
		}
	}
	gEmTotal = 0.0;
	if (EmCount() > 0) {   // (ptaaa-emissive) the emissive candidate: its own domain, MIS weight 1 (wSum = t / its density per unit area)
		LSample c = NoSample();
		float pdfArea;
		if (EmPick(hit, n, c.em, c.tri, c.bary, pdfArea)) {
			vec3 light, pos;
			if (LightAt(c, hit, n, light, pos)) {
				const float t = RestirTarget(light, pos, hit, s, n, v);
				const vec3 l = pos - lift;
				const float dist = length(l);
				if (t > 0.0 && (!canonEach || Visible(lift, l / dist, LightGap(c, dist)))) {
					const float wi = t / pdfArea;
					wSum += wi;
					if (Rand() * wSum < wi) { y = c; yTarget = t; yLight = light; yPos = pos; }
				}
			}
		}
		else c.em = -1;
	}
	if (canonOne && Valid(y)) {   // (perf-ptcost) the winner's one shadow ray
		const vec3 l = yPos - lift;
		const float dist = length(l);
		if (!(dist > 1.0e-4) || !Visible(lift, l / dist, LightGap(y, dist))) y = NoSample();
	}
	if (Valid(y)) W = wSum / yTarget;
	const vec2 f1 = FrameTexel(1);
	if (f1.y > 0.5) {   // last frame's reservoirs are valid
		const vec3 pf = vec3(FrameTexel(0), f1.x), pr = vec3(FrameTexel(2), FrameTexel(3).x), pu = vec3(FrameTexel(4), FrameTexel(5).x);
		const vec3 pe = vec3(FrameTexel(6), FrameTexel(7).x);
		const vec2 sp = FrameTexel(10), sr = FrameTexel(11), sq = FrameTexel(12);
		const vec3 here = hit + p.origin.xyz, rel = here - pe;
		const float depth = dot(rel, pf);
		if (depth > 1.0e-3) {
			const vec2 ndc = vec2(dot(rel, pr) / (dot(pr, pr) * depth), -dot(rel, pu) / (dot(pu, pu) * depth));
			const vec2 at = (ndc * 0.5 + 0.5) * p.size.xy;
			const int count = min(1 + int(sp.y + 0.5), 1 + kRestirNeighbours);
			const float dist = length(rel);
			int nb = 0;
			LSample nY[kRestirNeighbours];
			float nW[kRestirNeighbours], nM[kRestirNeighbours];
			vec3 nPoint[kRestirNeighbours], nN[kRestirNeighbours];
			for (int i = 0; i < count; i++) {
				vec2 q = at;
				if (i > 0) { const float r = sr.x * sqrt(Rand()), a = 6.2831853 * Rand(); q += r * vec2(cos(a), sin(a)); }
				const ivec2 px = ivec2(floor(q));
				if (any(lessThan(px, ivec2(0))) || any(greaterThanEqual(px, ivec2(p.size.xy)))) continue;
				const uint w = ReservoirWord(FrameParity() ^ 1, px);
				const uint head = scratch.words[w];
				if (head == 0u) continue;   // no surface there last frame
				const float oldW = uintBitsToFloat(scratch.words[w + 1u]), oldDist = uintBitsToFloat(scratch.words[w + 2u]);
				const vec3 oldN = OctDecode(unpackSnorm2x16(scratch.words[w + 3u]));
				// the same surface: its normal within the test, and its point (last frame's centre ray through that pixel) on this hit's plane
				if (dot(oldN, n) < sr.y) continue;
				const vec2 ouv = (vec2(px) + 0.5) / p.size.xy;
				const vec3 oldPoint = pe + normalize(pf + pr * (2.0 * ouv.x - 1.0) - pu * (2.0 * ouv.y - 1.0)) * oldDist;
				if (abs(dot(oldPoint - here, n)) > sq.x * dist) continue;
				const float oldM = min(float(head >> 16), maxM);
				if (!(oldM > 0.0)) continue;
				// (a reservoir that found no lit light: its count still counts)
				LSample old = OldSample(head & 0xFFFFu, scratch.words[w + 4u], unpackUnorm2x16(scratch.words[w + 5u]));
				if (!(oldW > 0.0) || !(oldW < 3.0e38)) old = NoSample();
				const vec3 src = oldPoint - p.origin.xyz;
				if (i == 0) {
					// 2. temporal, 1 / Z
					float tSum = Valid(y) ? yTarget * W : 0.0;   // (the canonical's weight, M = 1)
					vec3 light, pos;
					// (perf-ptcost, PTRestirDIRays 0 / 3) last frame's point within 1.5 pixels of this hit: the same spot. Its sample was seen
					// there (every target holds visibility), so it is taken as seen here, and y seen here as seen there: no rays (a still
					// camera: 1 ray a pixel less; host scene restirdi: the error vs the exact sum lower, 0.0097 vs 0.0133, the mean the same)
					const bool sameSpot = (raysMode == 0 || raysMode == 3) && length(oldPoint - here) < 1.5 * max(dist * 2.0 * length(p.up.xyz) * p.size.w, 0.05);
					if (Valid(old) && LightAt(old, hit, n, light, pos)) {
						const float t = RestirTarget(light, pos, hit, s, n, v);
						const float wi = t * oldW * oldM;
						if (wi > 0.0 && (Same(old, y) || sameSpot || LightVisibleFrom(old, hit, n))) {
							tSum += wi;
							if (Rand() * tSum < wi) { y = old; yTarget = t; yLight = light; yPos = pos; }
						}
					}
					if (Valid(y)) {   // Z: this pixel (y is seen here) + last frame's if it could have produced y
						const float Z = 1.0 + (Same(old, y) || (sameSpot ? LightLuma(y, src, oldN) > 0.0 : LightVisibleFrom(y, src, oldN)) ? oldM : 0.0);
						W = tSum / (Z * yTarget);
					}
					M += oldM;
					continue;
				}
				if (nb < kRestirNeighbours) { nY[nb] = old; nW[nb] = oldW; nM[nb] = oldM; nPoint[nb] = src; nN[nb] = oldN; nb++; }
			}
			// 3. spatial, pairwise MIS against the canonical (y, W, M)
			if (nb > 0) {
				const float k = float(nb), Mc = M;
				const float qcy = Valid(y) ? LightLuma(y, hit, n) : 0.0;   // the canonical sample here (seen)
				float mc = 0.0, sumM = Mc;
				float nWeight[kRestirNeighbours];
				for (int i = 0; i < nb; i++) {
					// the canonical's share in pair i: does neighbour i's surface see the canonical sample?
					if (Valid(y)) {
						// (perf-ptcost, PTRestirDIRays 3) only an MIS weight: the canonical sample at the neighbour's surface unshadowed (no ray;
						// host scene restirdi: 1.2 % dark, shadow edges 2.5 % of the pixels off > 15 %: a test value)
						gRestirVis = raysMode <= 1;
						const float qiy = Same(nY[i], y) || LightVisibleFrom(y, nPoint[i], nN[i]) ? LightLuma(y, nPoint[i], nN[i]) : 0.0;
						gRestirVis = raysMode != 2;
						mc += Mc * qcy / max(Mc * qcy + nM[i] * qiy, 1.0e-30);
					}
					sumM += nM[i];
					nWeight[i] = 0.0;
					if (!Valid(nY[i])) continue;
					vec3 light, pos;
					if (!LightAt(nY[i], hit, n, light, pos)) continue;
					const float t = RestirTarget(light, pos, hit, s, n, v);
					if (!(t > 0.0) || !(Same(nY[i], y) || LightVisibleFrom(nY[i], hit, n))) continue;
					const float qii = LightLuma(nY[i], nPoint[i], nN[i]);   // its own sample there (seen there: its weight was kept)
					const float qci = dot(light, vec3(0.2126, 0.7152, 0.0722));
					const float mi = nM[i] * qii / max(nM[i] * qii + Mc * qci, 1.0e-30) / k;
					nWeight[i] = mi * t * nW[i];
				}
				mc /= k;
				// stream: the canonical first, then the neighbours
				float sum = Valid(y) ? mc * yTarget * W : 0.0;
				int ny = -1;
				for (int i = 0; i < nb; i++) {
					const float wi = nWeight[i];
					if (!(wi > 0.0)) continue;
					sum += wi;
					if (Rand() * sum < wi) ny = i;
				}
				if (ny >= 0) {
					vec3 light, pos;
					LightAt(nY[ny], hit, n, light, pos);
					y = nY[ny]; yTarget = RestirTarget(light, pos, hit, s, n, v); yLight = light; yPos = pos;
				}
				W = Valid(y) && yTarget > 0.0 ? sum / yTarget : 0.0;
				M = sumM;
			}
		}
	}
	if (!(W < 3.0e38)) W = 0.0;
	// (perf-ptcost, PTRestirDIRays 2, a test value) unshadowed targets: ONE shadow ray, for the chosen sample (RTXDI's final visibility); an
	// occluded sample gives 0 and is stored with W 0 (RTXDI's visibility reuse). Host scene restirdi: 1.5 % dark, the error 1.8 x mode 0's.
	// (Keeping the occluded sample instead is unbiased but its noise was 5.5 x; dropping the reservoir 36 % too bright: measured, not kept.)
	vec3 tint = vec3(1.0);
	float storeW = W;
	bool seen = true;
	if (!gRestirVis && Valid(y) && W > 0.0) {
		const vec3 l = yPos - lift;
		const float dist = length(l);
		seen = dist > 1.0e-4 && Visible(lift, l / dist, LightGap(y, dist));
		tint = gShadowTint;
		if (!seen) storeW = 0.0;
	}
	gRestirVis = true;
	// the surface as next frame rebuilds it: the distance along this pixel's CENTRE ray (no jitter) to the hit's tangent plane, so the
	// rebuilt point lies on the surface (the jittered hit's own distance put it up to a pixel's footprint under a slanted floor)
	const vec2 cuv = (vec2(gPixel) + 0.5) * p.size.zw;
	const vec3 centre = normalize(p.forward.xyz + p.right.xyz * (2.0 * cuv.x - 1.0) - p.up.xyz * (2.0 * cuv.y - 1.0));
	const float facing = dot(centre, n);
	StoreReservoir(y, min(M, maxM), storeW, abs(facing) > 0.05 ? dot(hit, n) / facing : length(hit), n);   // (from this frame's eye)
	// (2026-11-07 rtgap-tess 1b) the chosen light's contact march (after the reuse: darkening only, not in the targets)
	return Valid(y) && W > 0.0 && seen ? yLight * W * BrdfPi(s, n, v, normalize(yPos - hit)) * tint *
		(gContact ? PtContact(normalize(yPos - gContactFrom), length(yPos - gContactFrom)) : 1.0) : vec3(0.0);
}

// ---- UNOFFICIAL 2026-11-07 PTRadianceCache (flag 524288, RT-PATH-TRACING.md section 48): a world-space radiance cache in the helper's scratch
// store, as NVIDIA's SHaRC does it. Cells: world position (the hit + the camera's world position) / a size that grows with the distance from
// the camera (PTCacheCell near it, x 2 per level, ~ distance / 32), x 6 normal directions; a hash table of 2^n entries (16 words each, from
// word CacheBase()): [0] the cell's check hash (0 = empty), [1-3] this frame's sum of samples (fixed point x 256, atomics), [4] their count,
// [5] frames since the last sample, [6] the resolved sample count (float), [8-10] the resolved light (float).
//   - every path vertex that goes on (all but the last) adds what came back through it: the light the rest of the path gathered / the
//     throughput that reached it = the OUTGOING INDIRECT light of that surface (its albedo included);
//   - the path's LAST hit takes its indirect light from the cache (its own direct light is traced as before), at a point jittered inside its
//     cell (no blocks): the cache's own values came from paths that also ended in the cache, so the bounces never stop (multi-bounce light
//     carried by the cache), where 3 traced bounces left the rest out;
//   - RtPathTraceCache.comp (a pass after this one) folds each cell's frame sum into its resolved light (a running mean, at most
//     PTCacheMaxSamples samples deep: it follows changing light) and frees cells nobody wrote for PTCacheMaxAge frames.
// A cell with fewer than PTCacheMinSamples samples is a miss (then PTLastSky / PTLastBounce if set).
bool CacheOn() { return (uint(p.accum.w) & 524288u) != 0u && LampImage() && gScratchCache; }   // (hangfix: + its table lies in the store)
uint Hash32(uint x) { x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16; return x; }
// The cell of a point (hit: from the camera, scene axes), its table slot and check hash
void CacheKey(vec3 hit, vec3 n, vec3 offset, out uint slot, out uint check) {
	const float cell0 = max(FrameTexel(13).x, 1.0);
	const float level = clamp(ceil(log2(max(length(hit), 1.0) / (cell0 * 32.0))), 0.0, 15.0);
	const float size = cell0 * exp2(level);
	const vec3 world = hit + offset * size + vec3(FrameTexel(8), FrameTexel(9).x);
	const ivec3 c = ivec3(floor(world / size));
	const vec3 a = abs(n);
	const uint axis = a.x >= a.y && a.x >= a.z ? 0u : a.y >= a.z ? 1u : 2u;
	const uint face = axis * 2u + ((axis == 0u ? n.x : axis == 1u ? n.y : n.z) < 0.0 ? 1u : 0u);
	const uint h = Hash32(uint(c.x) * 73856093u ^ Hash32(uint(c.y) * 19349663u ^ Hash32(uint(c.z) * 83492791u ^ (uint(level) << 3u | face))));
	slot = h & gCacheMask;   // (hangfix: LoadScratchLayout's checked size; was the frame row's log2, unchecked)
	check = Hash32(h ^ 0x9E3779B9u) | 1u;
}
uint CacheEntry(uint slot, uint i) {
	return gCacheBase + ((slot + i) & gCacheMask) * 16u;   // (hangfix: LoadScratchLayout's checked base and size)
}
// The cell's resolved indirect light at a point (jittered inside its cell along the surface); false: no cell / too few samples yet
bool CacheRead(vec3 hit, vec3 n, out vec3 light) {
	light = vec3(0.0);
	vec3 b, t = Basis(n, b);
	uint slot, check;
	CacheKey(hit, n, t * (Rand() - 0.5) + b * (Rand() - 0.5), slot, check);
	for (uint i = 0u; i < 4u; i++) {
		const uint e = CacheEntry(slot, i), k = scratch.words[e];
		if (k == 0u) return false;
		if (k != check) continue;
		if (uintBitsToFloat(scratch.words[e + 6u]) < FrameTexel(14).y) return false;
		light = vec3(uintBitsToFloat(scratch.words[e + 8u]), uintBitsToFloat(scratch.words[e + 9u]), uintBitsToFloat(scratch.words[e + 10u]));
		return true;
	}
	return false;
}
void CacheAdd(vec3 hit, vec3 n, vec3 light) {
	if (any(isnan(light)) || any(isinf(light))) return;
	uint slot, check;
	CacheKey(hit, n, vec3(0.0), slot, check);
	const uvec3 q = uvec3(clamp(light, vec3(0.0), vec3(1024.0)) * 256.0 + 0.5);
	for (uint i = 0u; i < 4u; i++) {
		const uint e = CacheEntry(slot, i);
		const uint k = atomicCompSwap(scratch.words[e], 0u, check);
		if (k != 0u && k != check) continue;
		atomicAdd(scratch.words[e + 1u], q.x); atomicAdd(scratch.words[e + 2u], q.y); atomicAdd(scratch.words[e + 3u], q.z);
		atomicAdd(scratch.words[e + 4u], 1u);
		return;
	}
}
const int kCacheVerts = 4;   // the vertices a path writes (the first ones)
#endif

// The sun, one lamp and (PTGlowLights) one glow light at a hit (next event estimation): the light that leaves it toward v
vec3 Direct(vec3 hit, vec3 n, float t, vec3 v, Surface s) {
	if (s.kind == kKindGlass) { gGlowTotal = 0.0; return vec3(0.0); }   // (2026-11-07 ptaaa-materials) mirror-like lobes: carried by the path
	vec3 lift = hit + n * (1.0 + 0.002 * t);
	vec3 e = vec3(0.0);
	// (perf-ptcost) the light samples are gathered first as candidates (unshadowed light, its shadow ray's direction and length, the light's
	// specular share for PTDenoiseSplit), then traced in ONE loop (one Visible call site: the shader inlines every call): 0 the sun, 1 the
	// picked lamp, 2 the emissive point. The random numbers come in the same order as before.
	vec3 cE[3], cDir[3], cSpec[3];
	float cDist[3];
	for (int k = 0; k < 3; k++) { cE[k] = cDir[k] = cSpec[k] = vec3(0.0); cDist[k] = 0.0; }
	if (p.sunDir.w > 0.5) {
		vec3 b, tg = Basis(p.sunDir.xyz, b);
		float r = sqrt(Rand()) * p.sunColor.w, phi = 6.2831853 * Rand();
		vec3 l = normalize(p.sunDir.xyz + (tg * cos(phi) + b * sin(phi)) * r);
		float c = dot(n, l);
		if (c > 0.0) { cE[0] = p.sunColor.rgb * c * BrdfPi(s, n, v, l); cSpec[0] = SpecShare(); cDir[0] = l; cDist[0] = 30000.0; }
	}
	// (2026-11-03) ONE lamp of all the frame's lamps (the lamp image, flag 1024: up to 80, 4 RG32F texels each; else the 8 in the
	// constants), picked in proportion to its unshadowed light here by a one-pass weighted reservoir, and a shadow ray to it.
	// (2026-11-03 b) the glow lights after them: their own reservoir in the same loop (scalars only: no per-thread arrays)
#ifdef PT_LIGHT_GRID
	// (2026-11-04) PTLightGrid: only the lamps listed in the hit's grid cell (those whose reach meets it, in the same order: every other
	// lamp has weight 0 here, and a lamp of weight 0 draws no random number, so the pick is the all-lamp loop's, bit for bit); a hit
	// outside the grid is out of every lamp's reach. Then the glow lights, all of them, after the lamps as before.
	const int lamps = LampCount(), glows = GlowLightCount();   // (hangfix: capped)
	int first = 0, listed = 0;
	const ivec3 dims = ivec3(int(p.grid[0].w + 0.5), int(p.grid[1].w + 0.5), int(p.grid[2].x + 0.5));
	const ivec3 cell = ivec3(floor((hit - p.grid[0].xyz) * p.grid[1].xyz));
	if (all(greaterThanEqual(cell, ivec3(0))) && all(lessThan(cell, dims))) {
		const vec2 entry = GridTexel((cell.z * dims.y + cell.y) * dims.x + cell.x);
		first = int(entry.x + 0.5) + 2 * dims.x * dims.y * dims.z;   // (as a float number from the cells' start: entry e at texel e / 2)
		listed = PtCount(entry.y, kPtMaxLamps);   // (hangfix: a cell lists each lamp once at most)
	}
	float total = 0.0, chosenWeight = 0.0, gTotal = 0.0, gChosenWeight = 0.0;
	vec3 chosenLight = vec3(0.0), chosenPos = vec3(0.0);
	vec4 gChosen = vec4(0.0);
	int gIndex = -1, chosenK = -1;
	for (int j = 0; j < listed; j++) {
		const int e = first + j;
		const vec2 two = GridTexel(e >> 1);
		const int k = int(((e & 1) != 0 ? two.y : two.x) + 0.5);
		vec2 a = imageLoad(lampImage, ivec2(4 * k, 0)).rg, b = imageLoad(lampImage, ivec2(4 * k + 1, 0)).rg;
		vec2 c = imageLoad(lampImage, ivec2(4 * k + 2, 0)).rg, d = imageLoad(lampImage, ivec2(4 * k + 3, 0)).rg;
		vec4 pos = vec4(a, b), colour = vec4(c, d);
		vec3 l = pos.xyz - hit;
		float dist = length(l), reach = pos.w;
		if (dist >= reach || dist < 1.0e-3) continue;
		vec3 light = FlashShape(k, dist, colour.rgb * (LampFall(dist / reach) * max(dot(n, l / dist), 0.0) * LampSpot(k, -l / dist)));   // (2026-11-11 FlashShape)
		float w = dot(light, vec3(0.2126, 0.7152, 0.0722));
		if (!(w > 0.0)) continue;
		total += w;
		if (Rand() * total < w) { chosenWeight = w; chosenLight = light; chosenPos = pos.xyz; chosenK = k; }
	}
	for (int g = 0; g < glows; g++) {   // a glow light: pos = its sphere, guess its guessed light
		const int k = lamps + g;
		vec4 pos = vec4(imageLoad(lampImage, ivec2(4 * k, 0)).rg, imageLoad(lampImage, ivec2(4 * k + 1, 0)).rg);
		vec3 guess = vec3(imageLoad(lampImage, ivec2(4 * k + 2, 0)).rg, imageLoad(lampImage, ivec2(4 * k + 3, 0)).r);
		float w = GlowWeight(pos, guess, hit, n);
		if (!(w > 0.0)) continue;
		gTotal += w;
		if (Rand() * gTotal < w) { gChosenWeight = w; gChosen = pos; gIndex = g; }
	}
#else
	int lamps = LampCount(), lights = min(lamps + GlowLightCount(), kPtMaxLights);   // (hangfix: capped at the lamp image's lights)
	float total = 0.0, chosenWeight = 0.0, gTotal = 0.0, gChosenWeight = 0.0;
	vec3 chosenLight = vec3(0.0), chosenPos = vec3(0.0);
	vec4 gChosen = vec4(0.0);
	int gIndex = -1, chosenK = -1;
	for (int k = 0; k < lights; k++) {
		vec4 pos, colour;
		if (LampImage()) {
			vec2 a = imageLoad(lampImage, ivec2(4 * k, 0)).rg, b = imageLoad(lampImage, ivec2(4 * k + 1, 0)).rg;
			vec2 c = imageLoad(lampImage, ivec2(4 * k + 2, 0)).rg, d = imageLoad(lampImage, ivec2(4 * k + 3, 0)).rg;
			pos = vec4(a, b); colour = vec4(c, d);
		}
		else if (k < 8) { pos = p.lampPos[k]; colour = p.lampColor[k]; }
		else break;
		if (k >= lamps) {   // a glow light: pos = its sphere, colour its guessed light
			float w = GlowWeight(pos, colour.rgb, hit, n);
			if (!(w > 0.0)) continue;
			gTotal += w;
			if (Rand() * gTotal < w) { gChosenWeight = w; gChosen = pos; gIndex = k - lamps; }
			continue;
		}
		vec3 l = pos.xyz - hit;
		float dist = length(l), reach = pos.w;
		if (dist >= reach || dist < 1.0e-3) continue;
		vec3 light = FlashShape(k, dist, colour.rgb * (LampFall(dist / reach) * max(dot(n, l / dist), 0.0) * LampSpot(k, -l / dist)));   // (2026-11-11 FlashShape)
		float w = dot(light, vec3(0.2126, 0.7152, 0.0722));
		if (!(w > 0.0)) continue;
		total += w;
		if (Rand() * total < w) { chosenWeight = w; chosenLight = light; chosenPos = pos.xyz; chosenK = k; }
	}
#endif
	bool restirHere = false;
#ifndef PT_RESTIR_GI
	gEmTotal = 0.0;
	gEmSelect = 1.0;
	restirHere = gRestirFirst;
	if (restirHere) PT_DIRECT_ADD(e, RestirDirect(hit, lift, n, v, s, chosenK, total, chosenWeight))   // (ptaaa-emissive: the lamps + PTEmissive)
#endif
	if (!restirHere && total > 0.0 && chosenWeight > 0.0) {
		const vec3 l = chosenPos - lift;
		const float dist = length(l);
		cE[1] = chosenLight * (total / chosenWeight) * BrdfPi(s, n, v, normalize(chosenPos - hit)); cSpec[1] = SpecShare();
		cDir[1] = l / dist; cDist[1] = max(dist - 16.0, 0.0);   // (short of its fixture)
	}
	// (2026-11-07 ptaaa-emissive) PTEmissive: one glowing triangle's point (its pick here; its light below, once its chance is known)
	bool emOk = false;
#ifndef PT_RESTIR_GI
	int emE = -1; uint emPrim = 0u; vec2 emBary = vec2(0.0); float emPdfArea = 0.0;
	if (!restirHere && EmCount() > 0) emOk = EmPick(hit, n, emE, emPrim, emBary, emPdfArea);
#endif
	// (perf-ptcost) PTBounceLights 0: at a bounce hit (not the first: the picture's own direct light keeps every sample) ONE of the three
	// is traced, chosen with chance P_k = 0.75 w_k / sum w + 0.25 / (how many have w > 0) (the floor bounds the noise where a weight
	// guesses badly) and divided by it: unbiased. w = the unshadowed light's luminance for the sun and the lamp; the emissive weight
	// must not depend on the point drawn (the bounce ray's MIS weight at the next hit uses P_e x the point's density): gEmTotal, the
	// instances' power x cos / d^2 summed (EmPick), x PTGlow x 0.5 / pi (a mean cos at the light) x the albedo's luminance
	// (also the far side of a thin leaf / ear at the first hit, DirectSides: its transmitted light is the smaller share; grass and leaves
	// under PTRealtime traced the sun, the lamp and the emissive point twice there)
	const bool pickOne = (gBounce > 0 || gBackSide) && gBounceLights < 0.5 && !restirHere;
	const float kPickFloor = PT_PICK_FLOOR;
	float P[3] = { 1.0, 1.0, 1.0 };
	int chosenC = -1;
	if (pickOne) {
		float w[3];
		w[0] = Luma(cE[0]); w[1] = Luma(cE[1]);
#ifndef PT_RESTIR_GI
		w[2] = gEmTotal > 0.0 ? gEmTotal * p.skyHorizon.w * (0.5 / 3.14159265) * max(Luma(s.albedo), 0.05) : 0.0;
#else
		w[2] = 0.0;
#endif
		float sum = 0.0, count = 0.0;
		for (int k = 0; k < 3; k++) { if (!(w[k] > 0.0) || !(w[k] < 3.0e38)) w[k] = 0.0; sum += w[k]; count += w[k] > 0.0 ? 1.0 : 0.0; }
		if (sum > 0.0) {
			const float u = Rand();
			float acc = 0.0;
			for (int k = 0; k < 3; k++) {
				P[k] = w[k] > 0.0 ? (1.0 - kPickFloor) * w[k] / sum + kPickFloor / count : 0.0;
				acc += P[k];
				if (chosenC < 0 && w[k] > 0.0 && u < acc) chosenC = k;
			}
			if (chosenC < 0) for (int k = 2; k >= 0; k--) if (chosenC < 0 && w[k] > 0.0) chosenC = k;   // (u at the float edge)
		}
#ifndef PT_RESTIR_GI
		gEmSelect = P[2];
#endif
	}
#ifndef PT_RESTIR_GI
	if (emOk && (!pickOne || chosenC == 2)) cE[2] = EmissiveCandidate(lift, n, v, s, emE, emPrim, emBary, emPdfArea, pickOne ? P[2] : 1.0, cDir[2], cDist[2], cSpec[2]);
#endif
	for (int k = 0; k < 3; k++) {
		if (pickOne && k != chosenC) continue;
		if (!(dot(cE[k], vec3(1.0)) > 0.0)) continue;
		if (!Visible(lift, cDir[k], cDist[k])) continue;
		// the sun and the lamp: the contact march (2026-11-07 1b) and the panes' tint (ptaaa: through glass); the emissive point: neither
		vec3 add = cE[k] * (pickOne ? 1.0 / P[k] : 1.0);
		if (k == 0) add *= PtContact(cDir[0], 30000.0) * gShadowTint;
		else if (k == 1) add *= (gContact ? PtContact(normalize(chosenPos - gContactFrom), length(chosenPos - gContactFrom)) : 1.0) * gShadowTint;
		e += add;
		if (gSplitTake) gSplitSpec += add * cSpec[k];   // (ptaaa-denoiser: as PT_DIRECT_ADD, with that light's own share)
	}
	gGlowTotal = gTotal;
	if (gIndex >= 0 && gChosenWeight > 0.0) PT_DIRECT_ADD(e, GlowSample(lift, n, v, s, gChosen, gIndex, gChosenWeight / gTotal))
	return e;
}

// A traced hit's material (2026-11-03): the material rule in the record's bits 26-31 (VegasShaders.materials.txt, as the object shaders
// use it): roughness (k / 7)^2 (2026-11-07 perf-reflfix2; was k / 7), metal (k - 1) / 6; a rough dielectric (0.8, 0) where the rule gives none
Surface HitSurface(vec3 albedo) { Surface s; s.albedo = albedo; s.rough = 0.8; s.metal = 0.0; s.kind = kKindPlain; return s; }
Surface HitSurface(vec3 albedo, uint instance) {
	Surface s = HitSurface(albedo);
	uint f = records[instance].flags;
	uint r = (f >> 26u) & 7u, m = (f >> 29u) & 7u;
	if (r != 0u) s.rough = float(r * r) / 49.0;   // (2026-11-07 perf-reflfix2) (k / 7)^2: finer near 0 (was k / 7; NvrRtProtocol.h)
	if (m != 0u) s.metal = float(m - 1u) / 6.0;
	// (2026-11-07 ptaaa-materials) the record's material kind (NvrRtProtocol.h NVR_RT_RECORD_KIND_*), each with its setting on
	const uint kind = rtRecordKind(f);
	const vec4 keys = MatKeys();
	if (gHairKind > 0.5 && (f & RT_HIT_TINTED_FLAGS) == RT_HIT_TINTED_FLAGS) { s.kind = kKindHair; s.rough = max(s.rough, 0.8); s.metal = 0.0; }
	if (kind == 1u && keys.x > 0.5) { s.kind = kKindGlass; s.albedo = GlassTint(records[instance].albedo.rgb); s.rough = 0.0; s.metal = 0.0; }
	else if (kind == 2u && keys.z > 0.0) s.kind = kKindFoliage;
	else if (kind == 3u && keys.w > 0.0) s.kind = kKindSkin;
	return s;
}

// (2026-11-07 ptaaa-materials) the light leaving a hit: Direct on its lit side, then for a thin leaf / ear (foliage, skin with its
// transmission on) the light from BEHIND: the same light sample from the far side's face (its own lift: a thick part's inside blocks it),
// times the transmitted colour T, Lambert, with no glow light sample, no ReSTIR and no contact march. (merge 2026-11-07: ONE Direct call
// site in a loop, not a second call: the shader inlines every call, and a second copy of Direct with the emissive sample and ReSTIR made
// RtPathTrace.spv too big for the AMD driver's pipeline creation.) The results and the random numbers' order are as before.
vec3 DirectSides(vec3 hit, vec3 n, float t, vec3 v, Surface s) {
	const bool through = (s.kind == kKindFoliage || s.kind == kKindSkin) && Luma(TransmitColour(s)) > 0.0;
	const bool contact = gContact;
#ifndef PT_RESTIR_GI
	const bool restir = gRestirFirst;
#endif
	float glowTotal = 0.0;
	vec3 e = vec3(0.0);
	for (int side = 0; side < (through ? 2 : 1); side++) {
		Surface b = s;
		if (side == 1) {   // the far side
			glowTotal = gGlowTotal;   // (the lit side's: the next bounce's glow MIS needs it)
			b.albedo = TransmitColour(s);
			gContact = false; gBackSide = true;
#ifndef PT_RESTIR_GI
			gRestirFirst = false;
#endif
		}
		e += Direct(hit, side == 1 ? -n : n, t, v, b);
	}
	if (through) {
		gBackSide = false; gContact = contact; gGlowTotal = glowTotal;
#ifndef PT_RESTIR_GI
		gRestirFirst = restir;
#endif
	}
	return e;
}

// (2026-11-02 b) The screen's surface at this pixel (flag 8): x 1 = found (a world draw wrote its colour there), the position (camera
// relative), its normal and its colour, linear; (2026-11-02 e) its roughness and metal from the MaterialBuffer (flag 256: r = class +
// 0.49 x metal, b = roughness or -1; class 4 land, 5 plants). Its distance from the eye is compared with the traced first hit.
bool gScreenDrawnElse = false;   // (2026-11-05) the game drew something at this pixel that NVR's AlbedoBuffer did not capture
// (2026-11-07 ptaaa-firstperson) the first-person view model (arms, gun, Pip-Boy) in the G-buffer: RtPathTrace.cpp ViewModelPrep marks
// its pixels in the normals' alpha (the world's 1, people's 2: RtDenoise's mask): 4 + s where the first-person pass captured its colour, normal and material
// (s = tan(world FOV / 2) / tan(view-model FOV / 2), Reflections' WeaponFovScale), -1 where it did not (the game's own pixel). The depth
// there is the view model's own (CombineDepth: its view z), drawn from the same eye with its own, narrower FOV and no TAA jitter: its
// point is the world ray's with the sideways part / s. It is the nearest thing on screen and not in the traced scene: the camera ray is
// not traced there, the screen's surface is the first hit (its colour, normal, material), lit and bounced from its true point; its rays
// leave from near the eye, so they pass over the hidden first-person body (RtHidden.glsl).
bool gViewModel = false;
bool ScreenHit(ivec2 pixel, out vec3 hit, out vec3 n, out Surface s) {
	hit = n = vec3(0.0);
	s = HitSurface(vec3(0.0));
	gScreenDrawnElse = false;
	gViewModel = false;
	if (!GBuffer()) return false;
	float d = imageLoad(gDepth, pixel).r;
	vec4 a = imageLoad(gAlbedo, pixel);
	const vec4 nv = imageLoad(gNormals, pixel);
	gScreenDrawnElse = d > 0.0 && d < 0.9999 && (a.a < 0.5 || nv.a < -0.5);   // (ptaaa-firstperson) + a view-model pixel without a capture
	if (!(d > 0.0 && d < 0.9999) || a.a < 0.5 || nv.a < -0.5) return false;
	vec2 uv = (vec2(pixel) + 0.5) * p.size.zw + p.rect.xy;
	float lateral = 1.0;
	if (nv.a > 3.5) { gViewModel = true; uv = (vec2(pixel) + 0.5) * p.size.zw; lateral = 1.0 / max(nv.a - 4.0, 0.05); }
	hit = (p.forward.xyz + (p.right.xyz * (2.0 * uv.x - 1.0) - p.up.xyz * (2.0 * uv.y - 1.0)) * lateral) * (d * p.forward.w);
	vec3 v = nv.rgb * 2.0 - 1.0;
	n = normalize(p.right.xyz) * v.x + normalize(p.up.xyz) * v.y + normalize(p.forward.xyz) * v.z;
	// (ptaaa-hangfix) a G-buffer normal that is zero (0.5 0.5 0.5 stored) or not a number: no screen surface here (normalize gave NaN, every
	// ray from the pixel started at NaN); the traced hit stands in. A real normal: unchanged
	if (!(dot(n, n) > 1.0e-8) || !(dot(n, n) < 1.0e30)) { hit = n = vec3(0.0); gViewModel = false; return false; }
	n = normalize(n);
	if (dot(n, hit) > 0.0) n = -n;
	s.albedo = clamp(a.rgb, 0.0, 1.0);
	if ((uint(p.accum.w) & 256u) != 0u) {
		vec4 m = imageLoad(gMaterial, pixel);
		float cls = floor(m.r);
		if (cls >= 1.0) {
			s.metal = clamp((m.r - cls) / 0.49, 0.0, 1.0);
			s.rough = m.b >= 0.0 ? clamp(m.b, 0.05, 1.0) : cls == 4.0 || cls == 5.0 ? 0.95 : 0.7;
			// (2026-11-07 ptaaa-materials) the class's material model: 3 cloth (ClothWind), 5 plants (PlantPass), 6 skin (SkinFill)
			const vec4 keys = MatKeys();
			if (cls == 3.0 && MatSheen() > 0.0) s.kind = kKindCloth;
			else if (cls == 5.0 && keys.z > 0.0) s.kind = kKindFoliage;
			else if (cls == 6.0 && keys.w > 0.0) s.kind = kKindSkin;
		}
	}
	return true;
}

#ifdef PT_RESTIR_GI
bool gGIFirst = false;   // (2026-11-04 d) the path left its first surface by the reuse's cosine sample
bool gGISurface = false; // a first surface (also when its glossy lobe was taken: then no sample, the light stays in the rest)
float gGIT1 = 0.0, gGIT2 = 0.0, gGIShare = 0.0, gGIMetal = 0.0;
vec3 gGIN1 = vec3(0.0, 0.0, 1.0), gGIN2 = vec3(0.0, 0.0, 1.0), gGIDir = vec3(0.0, 0.0, 1.0), gGIDirect = vec3(0.0);
#endif
vec3 gFirstAlbedo;   // (2026-11-03) the path's first surface colour (1: the sky / the frame)
float gFirstSurface; // 1: the path met a surface first; 0: the sky / the game's frame (exact: the show pass skips the denoiser there)
// (2026-11-07 ptaaa-denoiser) PTDenoiseSplit: the first surface's roughness, metal and cos(view) (its specular albedo), the path's light
// after the first hit's own (glow + direct: what came later came through the first bounce), that bounce direction's specular share of
// the BRDF (per channel) and its ray's hit distance (60000 a miss, 0 no bounce). Set by main() before each Path().
float gFirstRough = 1.0, gFirstMetal = 0.0, gFirstNV = 1.0;
vec3 gSplitRad0 = vec3(0.0), gSplitRatio = vec3(0.0);
float gSplitHitT = 0.0, gSplitSpecLobe = 0.0;   // (+ the chance that the bounce direction was the specular lobe's: SpecLobeChance)
// UNOFFICIAL 2026-11-09 (pt-mirrors) PTDenoiseMirrorSurface: the colour of what the first bounce ray met (1: a miss, the sky). On a smooth
// metal (a mirror, chrome) whose bounce was the specular lobe, the reflected thing stands in for the surface: main() divides the specular
// light by it too (it rides in the specular albedo, so the show pass multiplies it back) and marks the hit distance negative, and the
// denoiser treats the reflection like a diffuse surface seen through the mirror (RtDenoiseTemporalSpec / RtDenoiseAtrousRgb).
vec3 gReflAlbedo = vec3(1.0);

// (2026-11-04 c) PTIndirectClamp: light that reaches the first hit through a bounce (sky, glow, direct light at hits 1+), luminance
// capped at grid[2].w (0 = none). Biased (darker where real bright indirect light is), the usual firefly cut for a 1-path denoiser.
vec3 Indirect(vec3 c) {
	const float cap = p.grid[2].w, l = dot(c, vec3(0.2126, 0.7152, 0.0722));
	return cap > 0.0 && l > cap ? c * (cap / l) : c;
}

// (2026-11-07) a committed hit into the path's locals (traced, qT, qInstance, qPrim, qBary, qToScene): a rayQueryEXT cannot be copied
#define PT_TAKE_HIT(Q) { traced = rayQueryGetIntersectionTypeEXT(Q, true) == gl_RayQueryCommittedIntersectionTriangleEXT; if (traced) { \
	qT = rayQueryGetIntersectionTEXT(Q, true); qInstance = rayQueryGetIntersectionInstanceIdEXT(Q, true); \
	qPrim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(Q, true)); qBary = rayQueryGetIntersectionBarycentricsEXT(Q, true); \
	qToScene = rayQueryGetIntersectionObjectToWorldEXT(Q, true); } }
// (NVR_RT_CUSTOM_HIDDEN: RtHidden.glsl)

vec3 Path(vec3 dir) {
	vec3 pos = vec3(0.0), radiance = vec3(0.0), throughput = vec3(1.0);
	int bounces = PtCount(p.accum.y, kPtMaxBounces), view = int(p.misc.w + 0.5);   // (hangfix: bounces capped)
	// (2026-11-03 b) PTGlowLights: the previous hit (where this bounce ray left) for the MIS weight of the glow it meets
	vec3 prevHit = vec3(0.0), prevN = vec3(0.0, 0.0, 1.0);
	float prevPdf = 0.0, prevGlowTotal = 0.0;
	float pathRough = 0.0;   // (2026-11-09 PTBounceRoughen) the roughest bounce so far (a matte bounce: 1)
#ifndef PT_RESTIR_GI
	// (2026-11-07) PTRadianceCache: the vertices that go on (where, the throughput that reached them, the light gathered up to their own)
	const bool cache = CacheOn() && view == 0;
	vec3 cvHit[kCacheVerts], cvN[kCacheVerts], cvT[kCacheVerts], cvR[kCacheVerts];
	int cvCount = 0;
	// (2026-11-07 ptaaa-emissive) PTEmissive: the previous hit's emissive weights' sum (0: it took no emissive sample), whether ReSTIR DI took
	// its emissive light (then a bounce ray's glow from a listed triangle counts 0 in the picture), and that glow's balance share for the
	// radiance cache's first vertex (the cache's readers weigh their own light samples by the balance heuristic)
	float prevEmTotal = 0.0, prevEmSelect = 1.0;   // (perf-ptcost: + the chance its sample was traced, PTBounceLights)
	bool prevEmRestir = false;
	vec3 cacheFirstGlow = vec3(0.0);
	// (2026-11-10 PTCacheShort) this path may end at its first bounce hit, in the cache (one path in gCacheShort is traced in full)
	const bool cacheShort = cache && gCacheShort > 0.5 && bounces > 1 && Rand() * gCacheShort >= 1.0;
#endif
	bool cacheEnd = false;
	float ptFirstT = 0.0, ptPath = 0.0;   // (2026-11-07) real textures' mip: the camera ray's length, the bounces' since
	for (int bounce = 0; bounce <= bounces; bounce++) {
		rayQueryEXT q;
		gGlassSolid = GlassMode() > (bounce > 0 ? 0.5 : 1.5);   // (2026-11-07 ptaaa-materials) bounce rays meet glass panes; the camera's with PTGlass 2
		// (2026-11-04 b) bounce rays: the alpha test is ~30 % of the pass outdoors (helper replays, section 25): PTBounceAlpha 0 / 2 skip it
		// (cut-out cards solid / left out), PTBounceDistance cuts them short (a miss then takes the sky outdoors, nothing indoors)
		// (two calls, not variable flags / mask: one call with them cost the default path 5-8 % in helper replays)
		const int alphaMode = int(p.rect.w + 0.5);   // PTBounceAlpha: 1 tested as the camera's rays, 0 cut-outs solid, 2 left out, 3 the nearest card's texel
		const float rayLength = bounce > 0 && p.grid[2].z > 0.0 ? p.grid[2].z : p.misc.z;   // PTBounceDistance (0: misc.z)
		// (2026-11-07, a tester's video: dotted grey squares round a tree against the sky, smearing as the camera turned) where the
		// screen has no surface of its own (the sky: the G-buffer's depth at the far plane), the game's frame is the camera ray's answer:
		// the traced scene holds things the game does not draw there (the tree's leaf cards, whose hashed cut-out test made each a
		// dotted square; the player's own body in first person), and the screen is the truth for what the camera sees
		if (bounce == 0 && GBuffer() && ScreenFrame() && view != 2 && view != 3 && view != 4 && view < 5) {
			const float d0 = imageLoad(gDepth, gPixel).r;
			if (!(d0 > 0.0 && d0 < 0.9999)) { radiance = pow(max(imageLoad(gFrame, gPixel).rgb, vec3(0.0)), vec3(2.2)); break; }
		}
		bool traced = false;
		gHairSkipT = 1.0e30;   // (hair-through)
		float qT = 0.0;
		uint qInstance = 0u, qPrim = 0u;
		vec2 qBary = vec2(0.0);
		mat4x3 qToScene = mat4x3(1.0);
		// (2026-11-02 b) the first hit from the screen: its colour (the land's blended layers, decals the atlas lacks) and smooth normal
		// where the traced hit is the same surface (within 3 % or 8 units); the screen's surface alone where the rays see nothing or
		// something else (grass, people, things not in the RT scene): it lights and bounces, with no glow of its own.
		// (2026-11-07 ptaaa-firstperson: read before the camera ray, which the view model's pixels skip)
		vec3 sHit, sN;
		Surface sS;
		bool screen = bounce == 0 && ScreenHit(gPixel, sHit, sN, sS);
		const bool viewModel = screen && gViewModel;
		// (2026-11-07 ptaaa-firstperson) a bounce ray that leaves from near the eye (off the view model, or a surface within arm's reach)
		// passes over the hidden first-person body (RtHidden.glsl): the world without people and cut-outs (opaque), then people, the
		// player's parts and cut-outs up to that hit, each candidate tested, hidden ones passed over (cut-outs as PTBounceAlpha says:
		// 0 solid, 2 left out, 1 / 3 their texture)
		if (bounce > 0 && rtHiddenNear(pos, vec3(0.0))) {
			PT_RAY_INIT(q, gl_RayFlagsOpaqueEXT, 0x8Fu, pos + p.origin.xyz, 0.0, dir, rayLength)   // (hangfix: PT_RAY_INIT, the loop caps)
			PT_PROCEED_OPAQUE(q)
			PT_TAKE_HIT(q);
			rayQueryEXT qp;
			PT_RAY_INIT(qp, gl_RayFlagsNoOpaqueEXT, alphaMode == 2 ? 0x60u : 0x70u, pos + p.origin.xyz, 0.0, dir, traced ? qT : rayLength)
			uint n_ = 0u;
			while (rayQueryProceedEXT(qp)) {
				PT_GUARD(qp, n_)
				if (rayQueryGetIntersectionTypeEXT(qp, false) != gl_RayQueryCandidateIntersectionTriangleEXT) continue;
				if ((rayQueryGetIntersectionInstanceCustomIndexEXT(qp, false) & NVR_RT_CUSTOM_HIDDEN) != 0u) continue;
				if (alphaMode == 0 || !AlphaTest() || rtAlphaPass(rayQueryGetIntersectionInstanceIdEXT(qp, false), uint(rayQueryGetIntersectionPrimitiveIndexEXT(qp, false)),
				                                                    rayQueryGetIntersectionBarycentricsEXT(qp, false)))
					rayQueryConfirmIntersectionEXT(qp);
			}
			if (rayQueryGetIntersectionTypeEXT(qp, true) == gl_RayQueryCommittedIntersectionTriangleEXT) PT_TAKE_HIT(qp);
		}
		else if (bounce > 0 && alphaMode != 1) {   // opaque: no candidates to confirm; 2 without NVR_RT_MASK_ALPHA (FORK-RT-CORE.md's mask table)
			PT_RAY_INIT(q, gl_RayFlagsOpaqueEXT, alphaMode == 2 ? 0xEFu : 0xFFu, pos + p.origin.xyz, 0.0, dir, rayLength)   // (hangfix)
			PT_PROCEED_OPAQUE(q)
			// 3: the nearest card's texel decides (as the game's alpha test); through a hole the ray goes on with the other cards left out
			if (alphaMode == 3 && rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT &&
				!rtAlphaPass(rayQueryGetIntersectionInstanceIdEXT(q, true), uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, true)), rayQueryGetIntersectionBarycentricsEXT(q, true))) {
				const float past = rayQueryGetIntersectionTEXT(q, true);
				PT_RAY_INIT(q, gl_RayFlagsOpaqueEXT, 0xEFu, pos + p.origin.xyz, past, dir, rayLength)   // (hangfix)
				PT_PROCEED_OPAQUE(q)
			}
			PT_TAKE_HIT(q);
		}
		// (2026-11-05 rtfull-gs-body) the camera's rays leave the far LOD out (NVR_RT_MASK_FAR 0x80: FarLandLOD / FarObjectLOD): where the
		// screen has no world surface of NVR's, the game draws that distant land itself and a camera ray that met its coarse quads showed
		// them as grey slabs (Goodsprings' hills under PTRealtime once the far ring had loaded); missing it, the ray takes the game's frame.
		// Bounce and shadow rays keep it. (Constant masks: a variable mask cost the default path 5-8 %, section 27.)
		// (2026-11-07, a tester's "the player's head projected over the entire sky") the camera's rays also pass over the player's own body
		// in first person (FirstPersonBody: traced for shadows and reflections, not drawn; instance custom index NVR_RT_CUSTOM_HIDDEN, as
		// RtLampPrimary.comp). The eye sits inside that body's head, so the one camera ray through everything met the inside of the head
		// first: where the screen has no surface (the sky) the picture was the head's inside (hair, a hat, an eye) filling the sky, and on
		// every other pixel the traced hit never matched the screen's, so the first hit lost its real texture, normal map and glow. Two
		// queries now: the world without cut-outs and people (0x0F: land, objects, lamp glass, lamp models; opaque), then cut-outs, people
		// and the player's rigid parts (0x70) up to that hit, every candidate tested, the hidden ones passed over; the nearer is the hit.
		// (2026-11-07 ptaaa-firstperson) the view model's pixels: no camera ray (the screen's surface is the first hit)
		// (perf-ptcost) only while this frame's scene holds the hidden body; without it the one query below gives the same hit (the people and
		// the player's parts are opaque unless alpha-tested, and then under 0x10 with the cut-outs)
		else if (bounce == 0 && !viewModel && !(gOneCameraQuery > 0.5)) {
			PT_RAY_INIT(q, gl_RayFlagsOpaqueEXT, 0x0Fu, pos + p.origin.xyz, 1.0, dir, rayLength)   // (hangfix: PT_RAY_INIT, the loop caps)
			PT_PROCEED_OPAQUE(q)
			PT_TAKE_HIT(q);
			rayQueryEXT qp;
			PT_RAY_INIT(qp, gl_RayFlagsNoOpaqueEXT, 0x70u, pos + p.origin.xyz, 1.0, dir, traced ? qT : rayLength)
			uint n_ = 0u;
			while (rayQueryProceedEXT(qp)) {
				PT_GUARD(qp, n_)
				if (rayQueryGetIntersectionTypeEXT(qp, false) != gl_RayQueryCandidateIntersectionTriangleEXT) continue;
				if ((rayQueryGetIntersectionInstanceCustomIndexEXT(qp, false) & NVR_RT_CUSTOM_HIDDEN) != 0u) continue;
				if (!AlphaTest() || rtAlphaPass(rayQueryGetIntersectionInstanceIdEXT(qp, false), uint(rayQueryGetIntersectionPrimitiveIndexEXT(qp, false)),
				                                rayQueryGetIntersectionBarycentricsEXT(qp, false)))
					rayQueryConfirmIntersectionEXT(qp);
				else PT_NOTE_HAIR_SKIP(qp)   // (hair-through)
			}
			if (rayQueryGetIntersectionTypeEXT(qp, true) == gl_RayQueryCommittedIntersectionTriangleEXT) PT_TAKE_HIT(qp);
		}
		// bounce rays with PTBounceAlpha 1, and (perf-ptcost) the camera's ray as ONE query over everything but the far LOD (0x7F) when no hidden
		// body is in this frame's scene (frame row texel 29: RtCore counts them)
		else if (bounce > 0 || !viewModel) {
			PT_RAY_INIT(q, AlphaTest() ? 0u : gl_RayFlagsOpaqueEXT, bounce > 0 ? 0xFFu : 0x7Fu, pos + p.origin.xyz, bounce > 0 ? 0.0 : 1.0, dir, rayLength)   // (hangfix)
			Proceed(q);
			PT_TAKE_HIT(q);
		}
		// (2026-11-07 ptaaa-firstperson) the view model is seen along its own ray (its FOV): the view vector toward its true point
		if (viewModel) dir = normalize(sHit);
		vec3 hit, n, v = -dir;
		Surface surf;
		float t;
		// (2026-11-07 rtgap-tess, 1a) with the tessellated bumps on, the screen's surface lies up to Strength off the traced (flat) one,
		// along the ray Strength / cos: within that it is the same surface, and the traced point starts the rays (one in a hollow started
		// under the flat land and was blocked at once: dark speckles); the screen's colour, normal and material stay
		float same = max(0.03 * length(sHit), 8.0);
		if (screen && traced) {
			const float slack = rtTessSlack(PtSlack(), dot(sHit, p.forward.xyz));
			if (slack > 0.0) same += slack / max(abs(dot(HitNormal(qInstance, qPrim, qToScene, dir), dir)), 0.35);
		}
		// (1b) the first hit's contact march starts on the screen's surface (where the depth buffer has it)
		gContact = screen && !viewModel;   // (ptaaa-firstperson: the march walks the world's projection; the view model has its own)
		if (screen) { gContactFrom = sHit; gContactN = sN; gContactZ = dot(sHit, p.forward.xyz); gContactNoise = Rand(); }
		// (2026-11-10 BlendedHair, texel 30.x) traced hair in front of the screen's surface: the hair is the first surface
		const bool hairFront = bounce == 0 && screen && traced && !viewModel && gHairFirst > 0.5 && qT < length(sHit) + same &&   // (not a margin IN FRONT: short hair and beards lie on the skin, under 0.1 unit off it; the nearest traced hit being hair is the test)
			(records[qInstance].flags & RT_HIT_TINTED_FLAGS) == RT_HIT_TINTED_FLAGS;
		// (2026-11-11 hair-through; a tester on an RTX 4090: "hair is taking on the material of objects it's overlapping, much like it did
		// in front of a mirror") hair's alpha is a blend's coverage (BlendedHair), so a share of the camera's rays passes THROUGH a hair
		// card and meets what is behind it. The depth buffer there still holds the HAIR, while the colour and material buffers hold what
		// was drawn before it (hair is blended: it writes neither). The traced hit, far behind the screen's depth, counted as "not the
		// screen's surface", and the screen's won: a surface at the hair's place with the wall's, the ceiling's or the mirror's colour and
		// material, lit there. Such a ray now keeps its traced hit, with that hit's own colour and material: what really is behind the hair.
		const bool hairThrough = bounce == 0 && screen && traced && !viewModel && !hairFront && gHairKind > 0.5 &&
			gHairSkipT < length(sHit) + same && qT > length(sHit) + same;
		if (hairFront || hairThrough) gContact = false;
		if (screen && !hairFront && !hairThrough && (!traced || abs(qT - length(sHit)) > same)) {
			hit = sHit; n = sN; surf = sS; t = length(sHit);
		}
		else {
			if (!traced) {
				if (bounce == 0 && ScreenFrame() && view != 2 && view != 3 && view != 4 && view < 5) {   // (2026-11-02 c) past the RT scene: the game's frame
					radiance = pow(max(imageLoad(gFrame, gPixel).rgb, vec3(0.0)), vec3(2.2));
					break;
				}
