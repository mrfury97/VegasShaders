	for (uint i = 0u; i < 4u; i++) {
		const uint e = CacheEntry(slot, i);
		uint k = scratch.words[e];
		if (k == 0u) k = atomicCompSwap(scratch.words[e], 0u, check);   // plain read avoids atomic write-lock on existing cells
		if (k != 0u && k != check) continue;
