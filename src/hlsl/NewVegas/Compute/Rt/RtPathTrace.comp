		const uint cur = scratch.words[e + 4u];
		if (cur >= 512u) return;
		if (cur >= 64u && (Hash32(uint(gPixel.x) ^ (uint(gPixel.y) << 16u) ^ uint(p.origin.w)) & 7u) != 0u) return;
		atomicAdd(scratch.words[e + 1u], q.x); atomicAdd(scratch.words[e + 2u], q.y); atomicAdd(scratch.words[e + 3u], q.z);
		atomicAdd(scratch.words[e + 4u], 1u);
		return;
	}
