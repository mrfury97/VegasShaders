		if (p.misc.y > 0.0 && l > p.misc.y) { c *= p.misc.y / l; spec *= p.misc.y / l; }
		sum += c;
		albedoSum += gFirstAlbedo;
		surfaceSum += gFirstSurface;
		if (split) {
			specSum += spec;
			if (gFirstSurface > 0.0 && Specular()) {
				// UNOFFICIAL 2026-11-19: match FresnelF0 for skin (0.028), hair (0.004..0.04), and decoded FD_SV_F0 in specular guide demodulation
				const vec3 f0 = gFirstKind == kKindHair ? clamp(gFirstAlbedo, vec3(0.004), vec3(0.04)) :
					mix(vec3(gFirstKind == kKindSkin ? 0.028 : gFirstF0), gFirstAlbedo, clamp(gFirstMetal, 0.0, 1.0));
				vec3 specAlbedoPath = EnvBrdfApprox(f0, clamp(gFirstRough, 0.0, 1.0), clamp(gFirstNV, 0.0, 1.0));
				// (2026-11-09 pt-mirrors) PTDenoiseMirrorSurface: a smooth metal whose bounce took the specular lobe: the reflected thing's colour
				// joins the specular albedo (divided out here, multiplied back by the show pass with this frame's), so the denoiser smooths only
				// the reflected light, as it smooths a diffuse surface's, and the reflected textures stay sharp. Pure metals only (metal >= 0.99,
				// which then always take the specular lobe: SpecularShare): a smooth dielectric takes the diffuse lobe on most frames, where the
				// reflected thing is unknown (its signal would switch between the two scales). The mark is the surface's alone, so a pixel never
				// drops out of it for a frame (a sample under the horizon: its light 0, its hit unknown: -0.5 below).
				const bool mirror = gMirrorSurface > 0.0 && gFirstRough < gMirrorSurface && gFirstMetal >= 0.99;
				if (mirror && gSplitSpecLobe > 0.5) specAlbedoPath *= max(gReflAlbedo, vec3(0.02));
				specAlbedoSum += specAlbedoPath;
				if (s == 0) specMirror = mirror;
			}
			roughSum += gFirstRough;
			metalSum += gFirstSurface > 0.0 ? clamp(gFirstMetal, 0.0, 1.0) : 0.0;
			// the specular hit distance only when this bounce ray was (probably) the specular lobe's (the virtual point it gives is the
			// reflection's); 0 = not known here (the denoiser takes its neighbours')
			if (s == 0) specHitT = gSplitSpecLobe > 0.5 ? gSplitHitT : 0.0;
		}
	}
	vec3 sample_ = sum / float(paths);
	// the display's alpha: the RT host's count mode first (perf-ptcost), then PTEarlyLook's depth (2026-11-11), else 1 as before
	// (2026-11-12 ptbump) ... or 2 + PTBumpDetail where the first hit's light already holds its bumps: RtPathTraceShow.frag keeps that
	// share of PTDetail there, less the fine contrast the traced light has itself (2 <= a <= 3; a = 1: PTDetail as before)
	const float displayABase = gCountRays ? 1.0 + float(gRayCount) : gEarlyLook > 0.5 ? earlyZ : bumped ? 2.0 + gBumpDetail : 1.0;
	const float displayA = (actorShadow && !gCountRays && !(gEarlyLook > 0.5)) ? -displayABase : displayABase;
	if ((uint(p.accum.w) & 512u) != 0u) {   // (2026-11-03) demodulated for the denoiser
		// (2026-11-04 c FIX) the colour stored is the one divided by (with its 0.02 floor): RtPathTraceShow.frag multiplies it back, and with
		// the raw colour every surface darker than 0.02 in a channel came out darker by colour / 0.02 (rtdenoise-int: PTDenoise 0.87-0.90x
		// the converged mean overall, dark tiles down to 0.57x)
		const vec3 albedo = max(albedoSum / float(paths), vec3(0.02));
#ifndef PT_RESTIR_GI
		StoreSunSplit(pixel, albedo);
		if (split) {   // (ptaaa-denoiser) the two signals, each divided by its own albedo (fp16-safe), and the specular albedo itself
			const vec3 specMean = specSum / float(paths);
			const vec3 specAlbedo = surfaceSum > 0.0 ? max(specAlbedoSum / float(paths), vec3(0.01)) : vec3(0.0);
			const vec3 diffuse = min(max(sample_ - specMean, vec3(0.0)) / albedo, vec3(gDenoiseCeil));
			const vec3 specular = specAlbedo.x > 0.0 ? min(specMean / specAlbedo, vec3(gDenoiseCeil)) : vec3(0.0);
			// albedoOut.a: 1 + the metal where every path met a surface (DLSS RR's diffuse albedo = colour x (1 - metal); the show pass and
			// the guide read a >= 0.5 / clamp it to 1, as the GI variant's)
			// UNOFFICIAL 2026-11-19: single albedoOut store (eliminates redundant prior imageStore)
			const float albedoA = surfaceSum >= float(paths) ? (1.0 + metalSum / float(paths)) : (surfaceSum / float(paths));
			imageStore(albedoOut, pixel, vec4(albedo, albedoA));
			imageStore(display, pixel, vec4(diffuse, displayA));   // (perf-ptcost: the host's count mode; 2026-11-11 PTEarlyLook's depth)
			// (2026-11-09 pt-mirrors) a negative hit distance marks the mirror pixels whose reflected thing stands in (PTDenoiseMirrorSurface);
			// -0.5: marked, its hit not known this frame (the denoisers read |hit| < 1 as unknown)
			imageStore(specOut, pixel, vec4(specular, specMirror ? (specHitT >= 1.0 ? -specHitT : -0.5) : specHitT));
			imageStore(accumA, pixel, vec4(specAlbedo.rg, 0.0, 0.0));
			imageStore(accumB, pixel, vec4(specAlbedo.b, roughSum / float(paths), 0.0, 0.0));
			return;
		}
#endif
		imageStore(albedoOut, pixel, vec4(albedo, surfaceSum / float(paths)));
		sample_ = min(sample_ / albedo, vec3(gDenoiseCeil));   // (2026-11-11 PTDenoiseCeiling: was uncapped here)
	}
	const float n = p.accum.x;
	vec3 mean = sample_;
	if (n > 0.0) {
		const vec3 old = vec3(imageLoad(accumA, pixel).rg, imageLoad(accumB, pixel).r);
		mean = old + (sample_ - old) * (float(paths) / (n + float(paths)));
	}
	imageStore(accumA, pixel, vec4(mean.rg, 0.0, 0.0));
	imageStore(accumB, pixel, vec4(mean.b, n + float(paths), 0.0, 0.0));
	imageStore(display, pixel, vec4(mean, displayA));   // (perf-ptcost: the host's count mode; 2026-11-11 PTEarlyLook's depth)
#endif   // !PT_SPLIT_*
}
