		CacheAdd(cvHit[i], cvN[i], max(vec3(T.x > 1.0e-4 ? rest.x / T.x : 0.0, T.y > 1.0e-4 ? rest.y / T.y : 0.0, T.z > 1.0e-4 ? rest.z / T.z : 0.0), vec3(0.0)));
