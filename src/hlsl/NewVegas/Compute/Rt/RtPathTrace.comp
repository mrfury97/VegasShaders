}
// UNOFFICIAL 2026-11-15 PTRestirCGNS (rt-reuse; docs/next/RT-REUSE-CGNS.md): Compatibility-Guided Neighbor Selection (Junkins, Kettunen, Lin,
// Ramamoorthi and Wyman, HPG 2026; written from the paper's description and its BSD-3 Falcor sample github.com/orion-junkins/ReSTIR-CGNS,
// read for the formula only). Frame row texel 299.x (core\RtPathTrace.cpp kCgnsTexel) = K candidates, 0 off. K points in the same disk as
// the random picks, each scored by its surface last frame against this hit, h = exp(-|x - y| / s) x max(n_x . n_y, 0)^8 with
// s = sqrt(0.05 sr / pi) x the hit's distance (the paper's Omega 0.05, beta 8); `want` of them drawn without replacement in proportion to h
// (Efraimidis-Spirakis keys log(u) / h, the largest kept). It depends on the surfaces only, never on the samples, so the pairwise MIS below
// takes a picked neighbour as it takes a random one; fewer picks are thrown away by the plane / normal tests at edges.
const int kCgnsTexel = 299;
int RestirCgnsK() { return int(clamp(FrameTexel(kCgnsTexel).x, 0.0, 31.0) + 0.5); }
// UNOFFICIAL 2026-11-19: pre-filter CGNS candidates by normal & plane thresholds so top-K slots aren't wasted on rejected neighbours.
int RestirCgnsPick(vec2 at, vec3 here, vec3 n, float dist, float radius, float minDot, float maxPlane, int want, int K, vec3 pe, vec3 pf, vec3 pr, vec3 pu,
	out ivec2 picks[kRestirNeighbours]) {
	float keys[kRestirNeighbours];
	int got = 0;
	if (want <= 0) return 0;
	K = max(K, want);   // (never fewer candidates than neighbours)
	const float sc = max(0.12615663 * dist, 1.0e-3);   // sqrt(0.05 / pi)
	for (int k = 0; k < K; k++) {
		const float r = radius * sqrt(Rand()), a = 6.2831853 * Rand();
		const float u = Rand();
		const ivec2 px = ivec2(floor(at + r * vec2(cos(a), sin(a))));
		if (any(lessThan(px, ivec2(0))) || any(greaterThanEqual(px, ivec2(p.size.xy)))) continue;
#ifdef PT_SPLIT_SPATIAL
		const uint w = TempResWord(px);
#else
		const uint w = ReservoirWord(FrameParity() ^ 1, px);
#endif
		if (scratch.words[w] == 0u) continue;   // no surface there last frame
		const vec3 oldN = OctDecode(unpackSnorm2x16(scratch.words[w + 3u]));
		const float nd = dot(oldN, n);
		if (nd < minDot) continue;
		const float oldDist = uintBitsToFloat(scratch.words[w + 2u]);
		const vec2 ouv = (vec2(px) + 0.5) / p.size.xy;
		const vec3 oldPoint = pe + normalize(pf + pr * (2.0 * ouv.x - 1.0) - pu * (2.0 * ouv.y - 1.0)) * oldDist;
		if (abs(dot(oldPoint - here, n)) > maxPlane) continue;
		float c = nd;
		c *= c; c *= c; c *= c;
		const float h = exp(-length(oldPoint - here) / sc) * c;
		if (!(h > 1.0e-8)) continue;
		const float key = log(max(u, 1.0e-30)) / h;
		if (got < want) { picks[got] = px; keys[got] = key; got++; continue; }
		int low = 0;
		for (int j = 1; j < got; j++) if (keys[j] < keys[low]) low = j;
		if (key > keys[low]) { picks[low] = px; keys[low] = key; }
	}
	return got;
}
