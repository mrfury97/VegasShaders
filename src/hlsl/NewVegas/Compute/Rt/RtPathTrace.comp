// UNOFFICIAL 2026-11-07 the flashlight (RtPathTrace.cpp Lamps): always lamp 0 when it is on; its cone in the frame row's texel 15 .x
// (the lamp image: the lamp texels' spare word carries ReSTIR's number remap) or lampColor[0].w (no lamp image): 1 + (angle x 512 + u)
// x 512 + v, the cone's half-angle in degrees and its direction octahedral, 9 bits each; 0 = no flashlight. The share of lamp k reaching
// `toPoint` (lamp -> point, unit): full inside half the cone, nothing outside it, smooth between (as the game's own flashlight pass)
float LampSpot(int k, vec3 toPoint) {
	if (k != 0) return 1.0;
	const float code = LampImage() ? FrameTexel(15).x : p.lampColor[0].w;
	if (code < 0.5) return 1.0;
	const uint c = uint(code - 1.0 + 0.5);
	const vec2 e = vec2(float((c >> 9u) & 511u), float(c & 511u)) / 511.0 * 2.0 - 1.0;
	vec3 d = vec3(e, 1.0 - abs(e.x) - abs(e.y));
	if (d.z < 0.0) d.xy = (1.0 - abs(d.yx)) * vec2(d.x >= 0.0 ? 1.0 : -1.0, d.y >= 0.0 ? 1.0 : -1.0);
	const float angle = radians(float(c >> 18u));
	return smoothstep(cos(angle), cos(0.5 * angle), dot(normalize(d), toPoint));
}
// UNOFFICIAL 2026-11-11 the flashlight's lens pattern ([Shaders.Flashlight.Deferred] Cookie, frame row texel 15.y, 0 = none; RtPathTrace.cpp
// writes it only while lamp 0 is the flashlight). The raster pass reads Effects\Flashlight.png across the cone (FlashlightDeferred.hlsl); the
// helper has no such texture, so this is the file's own radial profile (tools/gen_textures.py gen_flashlight: hot spot, broad band, thin
// ring, glow, dark rim, x 2 as the pass reads it) without its few-percent angular unevenness and speckle. r: 0 on the axis, 1 at the cone's
// outer edge (tan of the angle off the axis over tan of the half-angle, the texture's own radius).
float FlashCookie(vec3 toPoint) {
	const float code = FrameTexel(15).x;
	if (code < 0.5) return 1.0;
	const uint c = uint(code - 1.0 + 0.5);
	const vec2 e = vec2(float((c >> 9u) & 511u), float(c & 511u)) / 511.0 * 2.0 - 1.0;
	vec3 d = vec3(e, 1.0 - abs(e.x) - abs(e.y));
	if (d.z < 0.0) d.xy = (1.0 - abs(d.yx)) * vec2(d.x >= 0.0 ? 1.0 : -1.0, d.y >= 0.0 ? 1.0 : -1.0);
	const float ca = cos(radians(float(c >> 18u))), ct = clamp(dot(normalize(d), toPoint), 1.0e-3, 1.0);
	const float r = sqrt(max(1.0 - ct * ct, 0.0)) / ct * ca / sqrt(max(1.0 - ca * ca, 1.0e-6));
	const float r4 = r * r * r * r, band = (r - 0.46) / 0.18, ring = (r - 0.76) / 0.018;
	const float f = 0.46 * exp(-r4 / 0.00130321) + 0.27 * exp(-band * band) + 0.07 * exp(-ring * ring) + 0.20 * exp(-r4 / 0.52200625);
	return 2.0 * min(f * (1.0 - smoothstep(0.92, 1.12, r)), 0.71);
}
// UNOFFICIAL 2026-11-11 the flashlight's NearFade and HotspotLimit ([Shaders.Flashlight.Main] / .Interiors, the old flashlight's keys), frame
// row texel 31 (x NearFade in units, y HotspotLimit; 0 off; RtPathTrace.cpp writes them only while lamp 0 is the flashlight): lamp 0's
// light at `dist` from it, as FlashlightDeferred.hlsl shapes it. 2026-11-11 (take 2: the knee on the light's luma did nothing in the raster
// pass, whose added light stayed under 0.5, and flattened the pool here) HotspotLimit scales the light by L / max(L, s), L = 1 / HotspotLimit,
// s = the RASTER pass's beam shape at this point, falloff x cone^2 (1 on the axis at the light): its Deferred Falloff F (texel 288.y, 0 = its
// lamps' 1 - d^2/r^2) over the game's reach (`reach` / 2 with PTLampFalloff 1) and LampSpot^2, so both renderers roll off the same share of the
// same pool whatever their own falloff. `toPoint` lamp -> point, unit. Both 0 (or no lamp image: no row) = the light unchanged.
vec3 FlashShape(int k, float dist, float reach, vec3 toPoint, vec3 light) {
	if (k != 0 || !LampImage()) return light;
	const vec2 t = FrameTexel(31);
	// (2026-11-13 PTFlashRasterShape) the raster pass's beam: LampAtt(falloff x cone^2 x NearFade) (FlashlightDeferred.hlsl; Includes/
	// LampFalloff.hlsl LampAtt: att^k, or the physical shape's decode) in place of the lamps' falloff x the cone that `light` came with
	const vec2 rs = FrameTexel(kFlashRasterTexel);
	if (rs.x > 0.0) {
		const float r = reach * ((uint(p.accum.w) & 131072u) != 0u ? 0.5 : 1.0), q = dist * dist / max(r * r, 1.0e-6), F = FrameTexel(kEarlyLookTexel).y;
		const float w = clamp(1.0 - q, 0.0, 1.0), cone = LampSpot(k, toPoint), own = LampFall(dist / reach) * cone;
		float att = (F > 0.0 ? w * w / (1.0 + F * q) : w) * cone * cone * (t.x > 0.0 ? smoothstep(0.0, t.x, dist) : 1.0);
		if (rs.y > 0.0) { const vec2 sh = FrameTexel(kFlashRasterTexel2); const float qa = 1.0 - att; float win = 1.0 - qa * qa; win *= win; att = pow(abs(sh.y * win / (1.0 + qa * sh.x)), rs.y); }
		else att = pow(att, rs.x);
		att *= max(FrameTexel(kFlashOwnTexel).y, 0.0);   // (the lamps' light scale the pass multiplies its light by: LIN_SCALE_LIGHT)
		light = own > 1.0e-8 ? light * (att / own) : vec3(0.0);
	}
	else if (t.x > 0.0) light *= smoothstep(0.0, t.x, dist);
	const float cookie = FrameTexel(15).y;   // (2026-11-11 Cookie)
	if (cookie > 0.0) light *= mix(1.0, FlashCookie(toPoint), min(cookie, 1.0));
	if (t.y > 0.0) {
		const float r = reach * ((uint(p.accum.w) & 131072u) != 0u ? 0.5 : 1.0), q = dist * dist / max(r * r, 1.0e-6), F = FrameTexel(kEarlyLookTexel).y;
		const float w = clamp(1.0 - q, 0.0, 1.0), cone = LampSpot(k, toPoint);
		const float limit = 1.0 / t.y;
		light *= limit / max(limit, (F > 0.0 ? w * w / (1.0 + F * q) : w) * cone * cone);
	}
	return light;
}

