// skin, takes on the material of what it overlaps"). The AlbedoBuffer and MaterialBuffer are written only by NVR's templates drawn opaque
// in the world's main list (core/CapturedNormals.h). Whatever else the game draws over such a surface WITH depth (its blended hair, brows
// and beards, a head drawn in the sorted blended list, any shader of the game's own) leaves both buffers as they were: the pixel's depth
// is the hair's, its colour, roughness, metal and material class the wall's behind it (or the scalp's under it), and a = 1 says
// "written". The same where skin drew without the skin blur's albedo target (no SkinAlbedoFill): the wall's colour under a face.
// RtPathTrace.cpp's prep pass (core/RtViewModel.h) compares the captured surface's own distance (TESR_CapturedNormalsBuffer b) with the
// depth buffer's and marks such a pixel in the normals' alpha: + 0.25 (1.25 the world, 2.25 a person; without the key, or with an older
// DLL: 1 / 2, nothing marked, as before). A marked pixel's position (depth) and normal (rebuilt from the depth) are its own; its colour and
// material are not, and are never used: the camera's traced hit at that depth gives them (the hair's record: its tint, kKindHair; the
// head's skin record), and where nothing traced lies at that depth the game's own pixel is shown, as gScreenDrawnElse does.
// (the same evening) two marks: + 0.5 SURE (as above), + 0.25 MAYBE: in front of the captured surface by less than the tessellation's
// reach: a displaced rock's raised bump is in front of its OWN captured distance (the object templates' distance is the flat surface's).
// A maybe pixel keeps the screen's colour and material, as before PTScreenOwn, unless the camera's traced hit at its depth is hair / a
// cut-out or skin (records that never write those buffers).
bool gScreenStale = false, gScreenStaleSure = false, gScreenPerson = false;
// (2026-11-12 CapturedGrass) the screen pixel is recorded grass (MaterialBuffer class 7 with the grass mark g = 0.5, GRASS23x000TMS.pso):
// the raster blades (turned, bent, moved by wind) never match the traced scene's still tufts, so whether the camera ray's traced hit lay
// within `same` of the screen point flipped per pixel and per frame, and the contact march walked over neighbouring blades. A grass
// pixel always starts from the screen's own point and takes no contact march. Without grass records (the key off): never set.
bool gScreenGrass = false;
// (2026-11-14 GBufferV2, core/CapturedNormals.h) a MaterialBuffer class with the layout v2's specular bit (+16) taken off; the old layout's
// classes (below 16) are as they are
float PtMatClass(float c) { return c >= 16.0 ? c - 16.0 : c; }
// (2026-11-16 fd-batchCG) GBufferV2's shading normal back from its octahedral pair (Includes/Shadow.hlsl ShadowDecodeNormal; OctDecode
// above is not in the PT_RESTIR_GI variant)
vec3 PtGBufferNormal(vec2 e) {
	vec3 n = vec3(e, 1.0 - abs(e.x) - abs(e.y));
	const float t = clamp(-n.z, 0.0, 1.0);
	n.xy += vec2(n.x >= 0.0 ? -t : t, n.y >= 0.0 ? -t : t);
	return normalize(n);
}

bool ScreenHit(ivec2 pixel, out vec3 hit, out vec3 n, out Surface s) {
	hit = n = vec3(0.0);
	s = HitSurface(vec3(0.0));
	gScreenDrawnElse = false;
	gViewModel = false;
	gScreenStale = false; gScreenStaleSure = false; gScreenPerson = false; gElseDist = 0.0; gScreenGrass = false; gFlashDist = 0.0;
	gScreenBump = vec3(0.0);   // (2026-11-12 ptbump)
	if (!GBuffer()) return false;
	float d = imageLoad(gDepth, pixel).r;
	vec4 a = imageLoad(gAlbedo, pixel);
	const vec4 nv = imageLoad(gNormals, pixel);
	// (2026-11-11 PTScreenOwn) the prep pass's codes: mark = this pixel's colour / material buffers are another surface's (+ 0.25);
	// person = the skin template drew this pixel (2 / 2.25). Marked skin stays a screen surface (its depth and normal) even where the
	// AlbedoBuffer holds nothing (skin against the sky with no skin blur): the same rule as skin in front of a wall, not the game's pixel.
	const bool ownMark = nv.a > 0.5 && nv.a < 3.5 && fract(nv.a) > 0.125 && fract(nv.a) < 0.625;
	const bool ownSure = ownMark && fract(nv.a) > 0.375;
	const bool person = nv.a > 1.5 && nv.a < 3.5;
	const bool unwritten = (a.a < (gAlbedoCover > 0.5 ? 0.99 : 0.5) && !(ownSure && person)) || nv.a < -0.5;   // (2026-11-13 PTAlbedoCoverage: MSAA, all the samples)
	gScreenDrawnElse = d > 0.0 && d < 0.9999 && unwritten;   // (ptaaa-firstperson) + a view-model pixel without a capture
	if (gScreenDrawnElse && gHairSky > 0.5 && nv.a > -0.5 && nv.a < 3.5) {   // (2026-11-12 PTHairOverSky) the depth's distance along this pixel's ray
		const vec2 euv = (vec2(pixel) + 0.5) * p.size.zw + p.rect.xy;
		gElseDist = length((p.forward.xyz + p.right.xyz * (2.0 * euv.x - 1.0) - p.up.xyz * (2.0 * euv.y - 1.0)) * (d * p.forward.w));
	}
	// (2026-11-13 PTFlashOwnPixels) a pixel nothing recorded (the albedo's alpha 0; not the land, whose record the light pass lights
	// whatever its alpha; not a masked pixel: water, grass with its own beam, an uncaptured view model): its distance along the ray
	if (gScreenDrawnElse && gFlashOwn > 0.5 && nv.a > -0.5 && nv.a < 3.5 && a.a < 1.0e-3 &&
		!((uint(p.accum.w) & 256u) != 0u && PtMatClass(floor(imageLoad(gMaterial, pixel).r + 0.01)) == 4.0)) {
		const vec2 fuv = (vec2(pixel) + 0.5) * p.size.zw + p.rect.xy;
		gFlashAt = (p.forward.xyz + p.right.xyz * (2.0 * fuv.x - 1.0) - p.up.xyz * (2.0 * fuv.y - 1.0)) * (d * p.forward.w);
		gFlashDist = length(gFlashAt);
	}
	if (!(d > 0.0 && d < 0.9999) || unwritten) return false;
	vec2 uv = (vec2(pixel) + 0.5) * p.size.zw + p.rect.xy;
	float lateral = 1.0;
	if (nv.a > 3.5) { gViewModel = true; uv = (vec2(pixel) + 0.5) * p.size.zw; lateral = 1.0 / max(nv.a - 4.0, 0.05); }
	hit = (p.forward.xyz + (p.right.xyz * (2.0 * uv.x - 1.0) - p.up.xyz * (2.0 * uv.y - 1.0)) * lateral) * (d * p.forward.w);
	vec3 v = nv.rgb * 2.0 - 1.0;
	n = normalize(p.right.xyz) * v.x + normalize(p.up.xyz) * v.y + normalize(p.forward.xyz) * v.z;
	// (ptaaa-hangfix) a G-buffer normal that is zero (0.5 0.5 0.5 stored) or not a number: no screen surface here (normalize gave NaN, every
	// ray from the pixel started at NaN); the traced hit stands in. A real normal: unchanged
	if (!(dot(n, n) > 1.0e-8) || !(dot(n, n) < 1.0e30)) { hit = n = vec3(0.0); gViewModel = false; return false; }
	n = normalize(n);
	if (dot(n, hit) > 0.0) n = -n;
	gScreenPerson = person;
	gScreenStale = !gViewModel && ownMark; gScreenStaleSure = gScreenStale && ownSure;   // (PTScreenOwn: + 0.25 maybe, + 0.5 sure)
	// UNOFFICIAL 2026-11-19 (Finding 4.2): lighting-free deferred G-buffer records pack FD_SV_F0 (VanillaBridge / _rmaos.a, 0.00..0.08 as s = 1..9)
	// into COLOR3.a (Includes/DeferredPixel.hlsl FDSunVisCode), bridged by ViewModelPrep into +s/128 of gNormals.a; 0 when unrecorded / synthetic
	const float f0Frac = !gViewModel && !ownSure && nv.a > 0.5 && nv.a < 3.5 ? fract(nv.a) - (ownMark ? 0.25 : 0.0) : 0.0;
	const float f0Slot = f0Frac > 0.003 && f0Frac < 0.08 ? floor(f0Frac * 128.0 + 0.5) : 0.0;
	s.albedo = clamp(a.rgb, 0.0, 1.0);
	if (gAlbedoGamma > 0.0) s.albedo = pow(s.albedo, vec3(gAlbedoGamma));   // (2026-11-12 PTAlbedoGamma)
	if ((uint(p.accum.w) & 256u) != 0u) {
		vec4 m = imageLoad(gMaterial, pixel);
		float cls = PtMatClass(floor(m.r));
		// (2026-11-12 CapturedGrass) the old layout: class 7, written (a), the grass mark g = 0.5. (2026-11-16 fd-batchCG, DEFERRED-GAPS-AUDIT
		// item 24) GBufferV2, as core/CapturedNormals.h's grass test: class 7 (r > 0.5 is "written"; a is a normal's y there, so not
		// tested), the mark g = 4.5, or the DeferredFoliage grass record's code g in [32, 1024) (Includes/DeferredPixel.hlsl
		// FDFoliageGrassCode). The class test stays on both: in the old layout an object's g is its bound radius, often in [32, 1024).
		gScreenGrass = cls == 7.0 && ((m.a > 0.5 && abs(m.g - 0.5) < 0.1) || abs(m.g - 4.5) < 0.1 || (m.g > 31.99 && m.g < 1024.0));
		if (cls >= 1.0) {
			s.metal = clamp(fract(m.r) / 0.49, 0.0, 1.0);   // (2026-11-14: fract, the class may carry GBufferV2's specular bit)
			s.rough = m.b >= 0.0 ? clamp(m.b, 0.05, 1.0) : cls == 4.0 || cls == 5.0 ? 0.95 : 0.7;
			// (2026-11-12 ptbump) PTMatteNoHighlight: a record the game draws with no highlight (b = -2 - the shader's roughness, objects
			// only: class 1-3; the land's b, -8 .. -6, is its bump below): matte with the key, else the roughness as before the code
			const bool noHighlightMatte = cls <= 3.0 && m.b <= -1.99 && m.b >= -3.01 && gMatteOn > 0.5;
			if (cls <= 3.0 && m.b <= -1.99 && m.b >= -3.01) s.rough = gMatteOn > 0.5 ? 1.0 : clamp(-2.0 - m.b, 0.05, 1.0);
			if (f0Slot >= 1.0 && f0Slot <= 9.0 && cls != 4.0 && cls != 6.0 && !noHighlightMatte) s.f0 = (f0Slot - 1.0) * 0.01;
			// PTBumpNormals: the land's bumped normal (g = 3 + e.x, b = -7 + e.y, e hemi-octahedral about +z; written whole: a 1)
			if (gBumpOn > 0.5 && cls == 4.0 && m.a > 0.995 && m.a < 1.005 && m.g >= 1.99 && m.g <= 4.01 && m.b >= -8.01 && m.b <= -5.99) {
				const vec2 e = vec2(m.g - 3.0, m.b + 7.0), h = vec2(e.x + e.y, e.x - e.y) * 0.5;
				gScreenBump = normalize(vec3(h, max(1.0 - abs(h.x) - abs(h.y), 0.0)));
			}
			// (2026-11-16 fd-batchCG, DEFERRED-GAPS-AUDIT item 24) GBufferV2 (Includes/CapturedNormals.hlsl, TerrainTemplate.hlsl): the land
			// writes its blended layers' normal-mapped normal in world axes, full octahedral, x in g and y in a (g 4: none), and its class
			// always with the specular bit (raw 20). The old layout's land is raw 4 (no bit), so the raw class tells the layouts apart here
			// (the old form above needs b in [-8, -6], which v2's roughness never is). Decoded as ShadowDecodeNormal.
			else if (gBumpOn > 0.5 && cls == 4.0 && floor(m.r + 0.01) >= 16.0 && abs(m.g) <= 1.001 && abs(m.a) <= 1.001) {
				gScreenBump = PtGBufferNormal(clamp(vec2(m.g, m.a), -1.0, 1.0));
			}
			// (2026-11-07 ptaaa-materials) the class's material model: 3 cloth (ClothWind), 5 plants (PlantPass), 6 skin (SkinFill)
			const vec4 keys = MatKeys();
			if (cls == 3.0 && MatSheen() > 0.0) s.kind = kKindCloth;
			else if (cls == 5.0 && keys.z > 0.0) s.kind = kKindFoliage;
			else if (cls == 6.0 && keys.w > 0.0) s.kind = kKindSkin;
		}
		// (2026-11-11 PTScreenOwn) a skin pixel (the prep's person code: the skin template drew it) whose MaterialBuffer texel is not skin's:
		// SkinFill did not reach it (MaterialBufferSkin off; a skin shader from before 2026-11-11, whose alpha code SkinFill clipped with
		// AlbedoBuffer on), so the texel is still the wall's or the armour's drawn before the skin: its class, roughness and METAL. Skin's
		// own instead: no metal, a skin roughness, the skin model.
		if (person && cls != 6.0) {
			s.metal = 0.0; s.rough = 0.6; s.f0 = 0.04; s.kind = MatKeys().w > 0.0 ? kKindSkin : kKindPlain;
		}
	}
	return true;
}

#ifdef PT_RESTIR_GI
bool gGIFirst = false;   // (2026-11-04 d) the path left its first surface by the reuse's cosine sample
bool gGISurface = false; // a first surface (also when its glossy lobe was taken: then no sample, the light stays in the rest)
float gGIT1 = 0.0, gGIT2 = 0.0, gGIShare = 0.0, gGIMetal = 0.0;
vec3 gGIN1 = vec3(0.0, 0.0, 1.0), gGIN2 = vec3(0.0, 0.0, 1.0), gGIDir = vec3(0.0, 0.0, 1.0), gGIDirect = vec3(0.0);
#endif
vec3 gFirstAlbedo;   // (2026-11-03) the path's first surface colour (1: the sky / the frame)
float gFirstSurface; // 1: the path met a surface first; 0: the sky / the game's frame (exact: the show pass skips the denoiser there)
// (2026-11-07 ptaaa-denoiser) PTDenoiseSplit: the first surface's roughness, metal and cos(view) (its specular albedo), the path's light
// after the first hit's own (glow + direct: what came later came through the first bounce), that bounce direction's specular share of
// the BRDF (per channel) and its ray's hit distance (60000 a miss, 0 no bounce). Set by main() before each Path().
float gFirstRough = 1.0, gFirstMetal = 0.0, gFirstNV = 1.0, gFirstF0 = 0.04;
uint gFirstKind = kKindPlain;
vec3 gSplitRad0 = vec3(0.0), gSplitRatio = vec3(0.0);
float gSplitHitT = 0.0, gSplitSpecLobe = 0.0;   // (+ the chance that the bounce direction was the specular lobe's: SpecLobeChance)
// UNOFFICIAL 2026-11-09 (pt-mirrors) PTDenoiseMirrorSurface: the colour of what the first bounce ray met (1: a miss, the sky). On a smooth
// metal (a mirror, chrome) whose bounce was the specular lobe, the reflected thing stands in for the surface: main() divides the specular
// light by it too (it rides in the specular albedo, so the show pass multiplies it back) and marks the hit distance negative, and the
// denoiser treats the reflection like a diffuse surface seen through the mirror (RtDenoiseTemporalSpec / RtDenoiseAtrousRgb).
vec3 gReflAlbedo = vec3(1.0);

// (2026-11-04 c) PTIndirectClamp: light that reaches the first hit through a bounce (sky, glow, direct light at hits 1+), luminance
// capped at grid[2].w (0 = none). Biased (darker where real bright indirect light is), the usual firefly cut for a 1-path denoiser.
vec3 Indirect(vec3 c) {
	const float cap = p.grid[2].w, l = dot(c, vec3(0.2126, 0.7152, 0.0722));
	return cap > 0.0 && l > cap ? c * (cap / l) : c;
}

// (2026-11-07) a committed hit into the path's locals (traced, qT, qInstance, qPrim, qBary, qToScene): a rayQueryEXT cannot be copied
#define PT_TAKE_HIT(Q) { traced = rayQueryGetIntersectionTypeEXT(Q, true) == gl_RayQueryCommittedIntersectionTriangleEXT; if (traced) { \
	qT = rayQueryGetIntersectionTEXT(Q, true); qInstance = rayQueryGetIntersectionInstanceIdEXT(Q, true); \
	qPrim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(Q, true)); qBary = rayQueryGetIntersectionBarycentricsEXT(Q, true); \
	qToScene = rayQueryGetIntersectionObjectToWorldEXT(Q, true); } }
// (NVR_RT_CUSTOM_HIDDEN: RtHidden.glsl)
// (2026-11-13 PTFlashOwnPixels) the traced record that may take the flashlight on the game's own pixel: solid, not glass
#define PT_FLASH_OWN_RECORD(I) ((records[I].flags & RT_RECORD_ALPHA_TESTED) == 0u && !rtIsGlass(I))
// Where the camera's ray (from the eye, the scene's 0) meets the traced triangle's plane laid through the screen's point `at`: the
// distance the traced hit must have to be the surface the game drew at this pixel. (The screen's point is the pixel centre's, the ray a
// random point of the pixel: on ground seen at a low angle the two differ by more than the 3 % the plain distance test allows, and the
// light would come and go per path.)
float PtFlashPlaneT(vec3 at, uint instance, uint prim, mat4x3 toScene, vec3 dir) {
	const vec3 pn = HitNormal(instance, prim, toScene, dir);
	const float dn = dot(dir, pn);
	return abs(dn) > 1.0e-3 ? dot(at, pn) / dn : length(at);
}

#if !defined(PT_SPLIT_SPATIAL) && !defined(PT_SPLIT_BOUNCE)
vec3 Path(vec3 dir) {
	vec3 pos = vec3(0.0), radiance = vec3(0.0), throughput = vec3(1.0);
	int bounces = PtCount(p.accum.y, kPtMaxBounces), view = int(p.misc.w + 0.5);   // (hangfix: bounces capped)
