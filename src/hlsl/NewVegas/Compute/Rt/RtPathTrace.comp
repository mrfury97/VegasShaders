				if (s == 0) specMirror = mirror;
			}
			roughSum += gFirstRough;
			metalSum += gFirstSurface > 0.0 ? clamp(gFirstMetal, 0.0, 1.0) : 0.0;
			// the specular hit distance only when this bounce ray was (probably) the specular lobe's (the virtual point it gives is the
			// reflection's); 0 = not known here (the denoiser takes its neighbours')
			if (s == 0) specHitT = gSplitSpecLobe > 0.5 ? gSplitHitT : 0.0;
		}
	}
	vec3 sample_ = sum / float(paths);
	if ((uint(p.accum.w) & 512u) != 0u) {   // (2026-11-03) demodulated for the denoiser
		// (2026-11-04 c FIX) the colour stored is the one divided by (with its 0.02 floor): RtPathTraceShow.frag multiplies it back, and with
		// the raw colour every surface darker than 0.02 in a channel came out darker by colour / 0.02 (rtdenoise-int: PTDenoise 0.87-0.90x
		// the converged mean overall, dark tiles down to 0.57x)
		const vec3 albedo = max(albedoSum / float(paths), vec3(0.02));
		imageStore(albedoOut, pixel, vec4(albedo, surfaceSum / float(paths)));
#ifndef PT_RESTIR_GI
		if (split) {   // (ptaaa-denoiser) the two signals, each divided by its own albedo (fp16-safe), and the specular albedo itself
			const vec3 specMean = specSum / float(paths);
			const vec3 specAlbedo = surfaceSum > 0.0 ? max(specAlbedoSum / float(paths), vec3(0.01)) : vec3(0.0);
			const vec3 diffuse = min(max(sample_ - specMean, vec3(0.0)) / albedo, vec3(gDenoiseCeil));
			const vec3 specular = specAlbedo.x > 0.0 ? min(specMean / specAlbedo, vec3(gDenoiseCeil)) : vec3(0.0);
			// albedoOut.a: 1 + the metal where every path met a surface (DLSS RR's diffuse albedo = colour x (1 - metal); the show pass and
			// the guide read a >= 0.5 / clamp it to 1, as the GI variant's)
			if (surfaceSum >= float(paths)) imageStore(albedoOut, pixel, vec4(albedo, 1.0 + metalSum / float(paths)));
			imageStore(display, pixel, vec4(diffuse, gCountRays ? 1.0 + float(gRayCount) : 1.0));   // (perf-ptcost: the host's count mode)
			// (2026-11-09 pt-mirrors) a negative hit distance marks the mirror pixels whose reflected thing stands in (PTDenoiseMirrorSurface);
			// -0.5: marked, its hit not known this frame (the denoisers read |hit| < 1 as unknown)
			imageStore(specOut, pixel, vec4(specular, specMirror ? (specHitT >= 1.0 ? -specHitT : -0.5) : specHitT));
			imageStore(accumA, pixel, vec4(specAlbedo.rg, 0.0, 0.0));
			imageStore(accumB, pixel, vec4(specAlbedo.b, roughSum / float(paths), 0.0, 0.0));
			return;
		}
#endif
		sample_ = min(sample_ / albedo, vec3(gDenoiseCeil));   // (2026-11-11 PTDenoiseCeiling: was uncapped here)
	}
	const float n = p.accum.x;
	vec3 mean = sample_;
	if (n > 0.0) {
		const vec3 old = vec3(imageLoad(accumA, pixel).rg, imageLoad(accumB, pixel).r);
		mean = old + (sample_ - old) * (float(paths) / (n + float(paths)));
	}
	imageStore(accumA, pixel, vec4(mean.rg, 0.0, 0.0));
	imageStore(accumB, pixel, vec4(mean.b, n + float(paths), 0.0, 0.0));
	imageStore(display, pixel, vec4(mean, gCountRays ? 1.0 + float(gRayCount) : 1.0));   // (perf-ptcost: the host's count mode)
}
