	// (2026-11-12 ptbump) a bumped first hit: n is the shading normal; the rays start off the smooth surface (gGeoN, on n's side)
	vec3 lift = hit + (gGeoSplit ? (dot(gGeoN, n) < 0.0 ? -gGeoN : gGeoN) : n) * (1.0 + 0.002 * t);
